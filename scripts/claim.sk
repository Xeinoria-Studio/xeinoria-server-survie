# ============================================================
#  claim.sk — Systeme de claim (marquage de zones) pour Survie
#  Auteur: Shamallow_ pour Xeinoria
#
#  Idee:
#  - Pas de protection: c'est uniquement un marquage decoratif
#    (chez qui on est) avec titre/sous-titre a l'entree.
#  - Chaque joueur peut posseder plusieurs claims (limite par defaut 1).
#  - Selection rectangulaire (2 coins) OU polygonale (N sommets),
#    comme dans event.sk (clic gauche=pos1/sommet, clic droit=pos2/retire).
#  - Wand: hache en or marquee, en un seul exemplaire. Si le joueur
#    la sort de son inventaire (drop, depot dans un coffre, etc.) elle
#    est detruite. Si l'inv est plein, on ne la donne pas.
#  - Nom + sous-titre par claim, affiches a l'entree (cache anti-spam).
#  - Limite d'aire configurable par admin.
#  - Bypass admin (permission), zones speciales "admin" (createur = console).
#  - Index spatial par chunk pour des lookups O(few) a chaque tick.
#
#  Permission unique: admin
# ============================================================

options:
    prefix: &8[&aClaim&8] &r
    wand_name: &a&lClaim Wand
    perm: admin
    # Defaults configurables a l'execution via /claim admin set...
    default_limit: 1
    default_max_area: 40000       # blocs XZ par claim
    default_max_total: 120000     # blocs XZ cumules par joueur
    default_max_vertices: 96
    enter_throttle: 800           # legacy (non utilise pour l'entree claim)
    enter_same_zone_cooldown: 2 minutes
    scan_period: 8 ticks          # cadence boucle joueurs (detection entree)
    actionbar_pause_ms: 2200      # pause de l'action bar zone apres un message prioritaire
    fx_cache_max_points: 320      # limite dure de points stockes en cache FX
    wand_click_cooldown_ms: 160   # anti-spam clic wand (gauche/droit)
    index_max_cells: 4096         # plafond de cellules chunk pour index persistant
    claim_xfer_ttl_seconds: 120   # duree de vie d'une requete de transfert

# ============================================================
#  Helpers de configuration
# ============================================================

function claimDefaultLimit() :: integer:
    if {claim::cfg::default_limit} is set:
        return {claim::cfg::default_limit}
    return {@default_limit}

function claimMaxArea() :: integer:
    if {claim::cfg::max_area} is set:
        return {claim::cfg::max_area}
    return {@default_max_area}

function claimMaxTotalArea() :: integer:
    if {claim::cfg::max_total} is set:
        return {claim::cfg::max_total}
    return {@default_max_total}

function claimMaxVertices() :: integer:
    if {claim::cfg::max_vertices} is set:
        return {claim::cfg::max_vertices}
    return {@default_max_vertices}

function claimMaxVerticesFor(p: player) :: integer:
    if claimHasBypass({_p}) is true:
        return 100000
    return claimMaxVertices()

function claimPlayerLimit(uuid: text) :: integer:
    if {claim::limit::%{_uuid}%} is set:
        return {claim::limit::%{_uuid}%}
    return claimDefaultLimit()

function claimYesNo(flag: boolean) :: text:
    if {_flag} is true:
        return "&aOui"
    return "&cNon"

function claimHasBypass(p: player) :: boolean:
    if {_p} has permission "{@perm}":
        return true
    if {claim::bypass::%uuid of {_p}%} is true:
        return true
    return false

function claimPlayersCanClaim() :: boolean:
    if {claim::cfg::enabled} is false:
        return false
    return true

function claimCanEditClaims(p: player) :: boolean:
    if {_p} has permission "{@perm}":
        return true
    return claimPlayersCanClaim()

# ============================================================
#  ID / ownership helpers
# ============================================================

function claimNextId() :: integer:
    if {claim::id::counter} is not set:
        set {claim::id::counter} to 0
    add 1 to {claim::id::counter}
    return {claim::id::counter}

function claimExists(id: integer) :: boolean:
    if {claim::data::%{_id}%::owner} is set:
        return true
    return false

function claimOwnerUuid(id: integer) :: text:
    return {claim::data::%{_id}%::owner}

function claimIsAdminZone(id: integer) :: boolean:
    if {claim::data::%{_id}%::admin} is true:
        return true
    return false

function claimDisplayName(id: integer) :: text:
    if {claim::data::%{_id}%::name} is set:
        return {claim::data::%{_id}%::name}
    return "Claim #%{_id}%"

function claimSubtitle(id: integer) :: text:
    if {claim::data::%{_id}%::subtitle} is set:
        return {claim::data::%{_id}%::subtitle}
    return ""

function claimMode(id: integer) :: text:
    if {claim::data::%{_id}%::mode} is "poly":
        return "poly"
    return "rect"

function claimUseY(id: integer) :: boolean:
    if {claim::data::%{_id}%::usey} is true:
        return true
    return false

function claimWorld(id: integer) :: world:
    set {_wname} to {claim::data::%{_id}%::world}
    return {_wname} parsed as world

function claimOwnerName(id: integer) :: text:
    if claimIsAdminZone({_id}) is true:
        return "&cAdmin"
    set {_u} to claimOwnerUuid({_id})
    if {_u} is not set:
        return "&7?"
    set {_op} to {_u} parsed as offline player
    if {_op} is set:
        return name of {_op}
    return "&7%{_u}%"

# ============================================================
#  Roles & membres
#  ------------------------------------------------------------
#  Rang interne (utilise pour les comparaisons d'autorite) :
#      0 = etranger (aucun lien avec le claim)
#      1 = member     (membre simple)
#      2 = operator   (peut gerer les membres)
#      3 = manager    (peut editer la frontiere / nom)
#      4 = owner      (peut supprimer, transferer)
#      5 = admin      (perm serveur ; bypass total)
#
#  Stockage :
#      {claim::data::%id%::members::%uuid%}  = role (text)
#      {claim::member::%uuid%::%id%}         = role (text)  [index inverse]
#
#  L'owner n'est PAS dans members:: ; il est sur ::owner direct.
# ============================================================

function claimRoleRank(role: text) :: integer:
    if {_role} is "admin":
        return 5
    if {_role} is "owner":
        return 4
    if {_role} is "manager":
        return 3
    if {_role} is "operator":
        return 2
    if {_role} is "member":
        return 1
    return 0

function claimRoleDisplay(role: text) :: text:
    if {_role} is "owner":
        return "&6&lProprietaire"
    if {_role} is "manager":
        return "&dGestionnaire"
    if {_role} is "operator":
        return "&bOperateur"
    if {_role} is "member":
        return "&aMembre"
    return "&7Invite"

function claimRoleColor(role: text) :: text:
    if {_role} is "owner":
        return "&6"
    if {_role} is "manager":
        return "&d"
    if {_role} is "operator":
        return "&b"
    if {_role} is "member":
        return "&a"
    return "&7"

# Cycle de promotion via clic droit : member -> operator -> manager.
# La promotion en owner se fait via transfert separe (sneak + clic).
function claimRoleNext(role: text) :: text:
    if {_role} is "":
        return "member"
    if {_role} is "member":
        return "operator"
    if {_role} is "operator":
        return "manager"
    return ""

# Retourne le role d'un joueur dans un claim. "" si etranger.
# "owner" si proprietaire, sinon valeur dans members::.
function claimRoleOf(id: integer, uuid: text) :: text:
    if claimExists({_id}) is false:
        return ""
    if claimOwnerUuid({_id}) is {_uuid}:
        return "owner"
    set {_r} to {claim::data::%{_id}%::members::%{_uuid}%}
    if {_r} is set:
        return {_r}
    return ""

# Rang effectif d'un joueur sur un claim (avec bypass admin).
function claimEffectiveRank(p: player, id: integer) :: integer:
    if claimHasBypass({_p}) is true:
        return 5
    if claimExists({_id}) is false:
        return 0
    return claimRoleRank(claimRoleOf({_id}, uuid of {_p}))

# Definit / met a jour le role d'un joueur. role = "" supprime.
# N'autorise PAS d'ecraser le owner via ce chemin.
function claimSetRole(id: integer, uuid: text, role: text):
    if claimExists({_id}) is false:
        stop
    if claimOwnerUuid({_id}) is {_uuid}:
        # On ne stocke jamais l'owner dans la liste members.
        stop
    if {_role} is "" or "none":
        delete {claim::data::%{_id}%::members::%{_uuid}%}
        delete {claim::member::%{_uuid}%::%{_id}%}
        stop
    set {claim::data::%{_id}%::members::%{_uuid}%} to {_role}
    set {claim::member::%{_uuid}%::%{_id}%} to {_role}

# Conversion uuid -> nom affichable.
function claimNameOfUuid(uuid: text) :: text:
    set {_op} to {_uuid} parsed as offline player
    if {_op} is set:
        set {_n} to name of {_op}
        if {_n} is set:
            return {_n}
    return "&7%{_uuid}%"

# Nettoyage complet des membres (appele depuis claimDelete).
function claimMembersClear(id: integer):
    loop indices of {claim::data::%{_id}%::members::*}:
        delete {claim::member::%loop-value%::%{_id}%}
    delete {claim::data::%{_id}%::members::*}

# ============================================================
#  Capacites (qui peut faire quoi sur un claim)
# ============================================================

function claimCanManageMembers(p: player, id: integer) :: boolean:
    if claimEffectiveRank({_p}, {_id}) >= 2:
        return true
    return false

function claimCanEditBorders(p: player, id: integer) :: boolean:
    if claimEffectiveRank({_p}, {_id}) >= 3:
        return true
    return false

function claimCanDeleteClaim(p: player, id: integer) :: boolean:
    if claimEffectiveRank({_p}, {_id}) >= 4:
        return true
    return false

function claimCanTransferOwnership(p: player, id: integer) :: boolean:
    if claimEffectiveRank({_p}, {_id}) >= 4:
        return true
    return false

# ============================================================
#  Aire (planimetre + rectangle)
# ============================================================

function claimRectArea(a: location, b: location) :: integer:
    set {_x1} to floor(x-coordinate of {_a})
    set {_x2} to floor(x-coordinate of {_b})
    set {_z1} to floor(z-coordinate of {_a})
    set {_z2} to floor(z-coordinate of {_b})
    set {_dx} to abs({_x1} - {_x2}) + 1
    set {_dz} to abs({_z1} - {_z2}) + 1
    return {_dx} * {_dz}

function claimPolyAreaList(id: integer) :: integer:
    set {_n} to {claim::data::%{_id}%::poly::count} ? 0
    if {_n} < 3:
        return 0
    set {_sum} to 0
    set {_i} to 1
    while {_i} <= {_n}:
        if {_i} = {_n}:
            set {_j} to 1
        else:
            set {_j} to {_i} + 1
        set {_xi} to x-coordinate of {claim::data::%{_id}%::poly::%{_i}%}
        set {_zi} to z-coordinate of {claim::data::%{_id}%::poly::%{_i}%}
        set {_xj} to x-coordinate of {claim::data::%{_id}%::poly::%{_j}%}
        set {_zj} to z-coordinate of {claim::data::%{_id}%::poly::%{_j}%}
        set {_sum} to {_sum} + {_xi} * {_zj} - {_xj} * {_zi}
        add 1 to {_i}
    return round(abs({_sum}) / 2)

# Aire d'un claim deja sauvegarde
function claimAreaOf(id: integer) :: integer:
    if claimMode({_id}) is "poly":
        return claimPolyAreaList({_id})
    set {_a} to {claim::data::%{_id}%::rect::1}
    set {_b} to {claim::data::%{_id}%::rect::2}
    if {_a} is not set:
        return 0
    if {_b} is not set:
        return 0
    return claimRectArea({_a}, {_b})

# Aire totale d'un joueur (somme de ses claims non-admin)
function claimPlayerTotalArea(uuid: text) :: integer:
    set {_t} to 0
    loop indices of {claim::owner::%{_uuid}%::*}:
        set {_id} to loop-value parsed as integer
        if {_id} is set:
            if claimExists({_id}) is true:
                set {_t} to {_t} + claimAreaOf({_id})
    return {_t}

# ============================================================
#  Polygone: contains 2D (ray casting), partage avec event.sk-style
# ============================================================

function claimPolyContains2D(id: integer, x: number, z: number) :: boolean:
    set {_n} to {claim::data::%{_id}%::poly::count} ? 0
    if {_n} < 3:
        return false
    set {_inside} to false
    set {_i} to 1
    set {_j} to {_n}
    while {_i} <= {_n}:
        set {_xi} to x-coordinate of {claim::data::%{_id}%::poly::%{_i}%}
        set {_zi} to z-coordinate of {claim::data::%{_id}%::poly::%{_i}%}
        set {_xj} to x-coordinate of {claim::data::%{_id}%::poly::%{_j}%}
        set {_zj} to z-coordinate of {claim::data::%{_id}%::poly::%{_j}%}
        set {_a} to false
        set {_b} to false
        if {_zi} > {_z}:
            set {_a} to true
        if {_zj} > {_z}:
            set {_b} to true
        if {_a} is not {_b}:
            set {_dz} to {_zj} - {_zi}
            if {_dz} is not 0:
                set {_slope} to ({_xj} - {_xi}) * ({_z} - {_zi}) / {_dz} + {_xi}
                if {_x} < {_slope}:
                    if {_inside} is true:
                        set {_inside} to false
                    else:
                        set {_inside} to true
        set {_j} to {_i}
        add 1 to {_i}
    return {_inside}

# ============================================================
#  BBox + cache: chaque claim a sa bbox cachee (rebuild a la save)
# ============================================================

function claimBuildBBox(id: integer):
    if claimMode({_id}) is "poly":
        set {_n} to {claim::data::%{_id}%::poly::count} ? 0
        if {_n} <= 0:
            stop
        set {_minX} to x-coordinate of {claim::data::%{_id}%::poly::1}
        set {_maxX} to {_minX}
        set {_minZ} to z-coordinate of {claim::data::%{_id}%::poly::1}
        set {_maxZ} to {_minZ}
        set {_minY} to y-coordinate of {claim::data::%{_id}%::poly::1}
        set {_maxY} to {_minY}
        set {_i} to 2
        while {_i} <= {_n}:
            set {_xi} to x-coordinate of {claim::data::%{_id}%::poly::%{_i}%}
            set {_zi} to z-coordinate of {claim::data::%{_id}%::poly::%{_i}%}
            set {_yi} to y-coordinate of {claim::data::%{_id}%::poly::%{_i}%}
            if {_xi} < {_minX}:
                set {_minX} to {_xi}
            if {_xi} > {_maxX}:
                set {_maxX} to {_xi}
            if {_zi} < {_minZ}:
                set {_minZ} to {_zi}
            if {_zi} > {_maxZ}:
                set {_maxZ} to {_zi}
            if {_yi} < {_minY}:
                set {_minY} to {_yi}
            if {_yi} > {_maxY}:
                set {_maxY} to {_yi}
            add 1 to {_i}
        set {claim::data::%{_id}%::bbox::minX} to floor({_minX})
        set {claim::data::%{_id}%::bbox::maxX} to floor({_maxX})
        set {claim::data::%{_id}%::bbox::minZ} to floor({_minZ})
        set {claim::data::%{_id}%::bbox::maxZ} to floor({_maxZ})
        set {claim::data::%{_id}%::bbox::minY} to floor({_minY})
        set {claim::data::%{_id}%::bbox::maxY} to floor({_maxY})
        stop
    set {_a} to {claim::data::%{_id}%::rect::1}
    set {_b} to {claim::data::%{_id}%::rect::2}
    if {_a} is not set:
        stop
    if {_b} is not set:
        stop
    set {_x1} to x-coordinate of {_a}
    set {_x2} to x-coordinate of {_b}
    set {_y1} to y-coordinate of {_a}
    set {_y2} to y-coordinate of {_b}
    set {_z1} to z-coordinate of {_a}
    set {_z2} to z-coordinate of {_b}
    set {claim::data::%{_id}%::bbox::minX} to floor(min({_x1}, {_x2}))
    set {claim::data::%{_id}%::bbox::maxX} to floor(max({_x1}, {_x2}))
    set {claim::data::%{_id}%::bbox::minY} to floor(min({_y1}, {_y2}))
    set {claim::data::%{_id}%::bbox::maxY} to floor(max({_y1}, {_y2}))
    set {claim::data::%{_id}%::bbox::minZ} to floor(min({_z1}, {_z2}))
    set {claim::data::%{_id}%::bbox::maxZ} to floor(max({_z1}, {_z2}))

function claimBBoxContains(id: integer, loc: location) :: boolean:
    set {_w} to {claim::data::%{_id}%::world}
    if "%world of {_loc}%" is not {_w}:
        return false
    set {_minX} to {claim::data::%{_id}%::bbox::minX}
    set {_maxX} to {claim::data::%{_id}%::bbox::maxX}
    set {_minZ} to {claim::data::%{_id}%::bbox::minZ}
    set {_maxZ} to {claim::data::%{_id}%::bbox::maxZ}
    if {_minX} is not set:
        return false
    set {_x} to x-coordinate of {_loc}
    set {_z} to z-coordinate of {_loc}
    if {_x} < {_minX}:
        return false
    if {_x} > {_maxX} + 1:
        return false
    if {_z} < {_minZ}:
        return false
    if {_z} > {_maxZ} + 1:
        return false
    if claimUseY({_id}) is true:
        set {_minY} to {claim::data::%{_id}%::bbox::minY}
        set {_maxY} to {claim::data::%{_id}%::bbox::maxY}
        set {_y} to y-coordinate of {_loc}
        if {_y} < {_minY}:
            return false
        if {_y} > {_maxY} + 1:
            return false
    return true

# Test definitif (bbox + poly si besoin).
function claimContains(id: integer, loc: location) :: boolean:
    if claimBBoxContains({_id}, {_loc}) is false:
        return false
    if claimMode({_id}) is "poly":
        set {_x} to x-coordinate of {_loc}
        set {_z} to z-coordinate of {_loc}
        return claimPolyContains2D({_id}, {_x}, {_z})
    return true

# ============================================================
#  Index spatial par chunk (16x16) pour ne tester que les
#  claims candidats lors d'un lookup de position.
# ============================================================

function claimChunkKey(world: text, cx: integer, cz: integer) :: text:
    return "%{_world}%:%{_cx}%:%{_cz}%"

function claimIndexMaxCells() :: integer:
    set {_m} to {@index_max_cells}
    if {_m} < 256:
        set {_m} to 256
    return {_m}

function claimIndexRemove(id: integer):
    loop {claim::index::byclaim::%{_id}%::list::*}:
        set {_k} to loop-value
        delete {claim::index::cells::%{_k}%::%{_id}%}
    delete {claim::index::byclaim::%{_id}%::*}
    delete {claim::index::big::%{_id}%}

function claimIndexAdd(id: integer):
    set {_w} to {claim::data::%{_id}%::world}
    set {_minX} to {claim::data::%{_id}%::bbox::minX}
    set {_maxX} to {claim::data::%{_id}%::bbox::maxX}
    set {_minZ} to {claim::data::%{_id}%::bbox::minZ}
    set {_maxZ} to {claim::data::%{_id}%::bbox::maxZ}
    if {_minX} is not set:
        stop
    set {_cx0} to floor({_minX} / 16)
    set {_cx1} to floor({_maxX} / 16)
    set {_cz0} to floor({_minZ} / 16)
    set {_cz1} to floor({_maxZ} / 16)
    set {_wCells} to {_cx1} - {_cx0} + 1
    set {_hCells} to {_cz1} - {_cz0} + 1
    set {_cellCount} to {_wCells} * {_hCells}
    if {_cellCount} > claimIndexMaxCells():
        # Claim enorme: on evite de persister un index massif.
        # La detection garde le fallback global dans claimAtLocation.
        set {claim::index::big::%{_id}%} to true
        stop
    set {_n} to 0
    loop integers from {_cx0} to {_cx1}:
        set {_cx} to loop-value
        loop integers from {_cz0} to {_cz1}:
            set {_cz} to loop-value-2
            set {_k} to claimChunkKey({_w}, {_cx}, {_cz})
            set {claim::index::cells::%{_k}%::%{_id}%} to true
            add 1 to {_n}
            set {claim::index::byclaim::%{_id}%::list::%{_n}%} to {_k}

function claimReindex(id: integer):
    claimIndexRemove({_id})
    claimBuildBBox({_id})
    claimIndexAdd({_id})

# Retourne le claim contenant la position avec la plus petite aire (priorite
# aux zones imbriquees / encapsulees). En cas d'aire egale, on prefere un
# claim joueur a un claim admin.
function claimAtLocation(loc: location) :: integer:
    set {_w} to "%world of {_loc}%"
    set {_cx} to floor(x-coordinate of {_loc} / 16)
    set {_cz} to floor(z-coordinate of {_loc} / 16)
    set {_k} to claimChunkKey({_w}, {_cx}, {_cz})
    set {_best} to -1
    set {_bestArea} to -1
    set {_bestAdmin} to true
    loop indices of {claim::index::cells::%{_k}%::*}:
        set {_id} to loop-value parsed as integer
        if {_id} is set:
            if claimExists({_id}) is true:
                if claimContains({_id}, {_loc}) is true:
                    set {_a} to claimAreaOf({_id})
                    set {_isAdm} to claimIsAdminZone({_id})
                    set {_take} to false
                    if {_best} is -1:
                        set {_take} to true
                    else if {_a} < {_bestArea}:
                        set {_take} to true
                    else if {_a} is {_bestArea}:
                        if {_bestAdmin} is true:
                            if {_isAdm} is false:
                                set {_take} to true
                    if {_take} is true:
                        set {_best} to {_id}
                        set {_bestArea} to {_a}
                        set {_bestAdmin} to {_isAdm}
    if {_best} is -1:
        set {_max} to {claim::id::counter} ? 0
        set {_i} to 1
        while {_i} <= {_max}:
            if claimExists({_i}) is true:
                if claimContains({_i}, {_loc}) is true:
                    set {_a} to claimAreaOf({_i})
                    set {_isAdm} to claimIsAdminZone({_i})
                    set {_take} to false
                    if {_best} is -1:
                        set {_take} to true
                    else if {_a} < {_bestArea}:
                        set {_take} to true
                    else if {_a} is {_bestArea}:
                        if {_bestAdmin} is true:
                            if {_isAdm} is false:
                                set {_take} to true
                    if {_take} is true:
                        set {_best} to {_i}
                        set {_bestArea} to {_a}
                        set {_bestAdmin} to {_isAdm}
            add 1 to {_i}
    if {_best} is -1:
        return 0
    return {_best}

# Retourne la liste de TOUS les claims contenant la position, sous forme
# d'une chaine ";id1;id2;...;" (delimiteurs aux deux bouts pour des tests
# "contains ;X;" sans faux positifs). Sert a detecter qu'on etait deja a
# l'interieur d'un claim parent (sortie d'une sous-zone -> pas de re-titre).
function claimsContainingLocation(loc: location) :: text:
    set {_w} to "%world of {_loc}%"
    set {_cx} to floor(x-coordinate of {_loc} / 16)
    set {_cz} to floor(z-coordinate of {_loc} / 16)
    set {_k} to claimChunkKey({_w}, {_cx}, {_cz})
    set {_out} to ";"
    set {_found} to false
    loop indices of {claim::index::cells::%{_k}%::*}:
        set {_id} to loop-value parsed as integer
        if {_id} is set:
            if claimExists({_id}) is true:
                if claimContains({_id}, {_loc}) is true:
                    set {_out} to "%{_out}%%{_id}%;"
                    set {_found} to true
    if {_found} is false:
        set {_max} to {claim::id::counter} ? 0
        set {_i} to 1
        while {_i} <= {_max}:
            if claimExists({_i}) is true:
                if claimContains({_i}, {_loc}) is true:
                    set {_out} to "%{_out}%%{_i}%;"
            add 1 to {_i}
    return {_out}

# ============================================================
#  Wand: hache d'or marquee, en un seul exemplaire
# ============================================================

function claimCreateWand() :: item:
    set {_w} to golden axe
    set display name of {_w} to "{@wand_name}"
    set lore of {_w} to "&7Clic gauche &8» &fpos1 / sommet", "&7Clic droit &8» &fpos2 / retirer sommet", "&7Sneak + clic gauche air &8» &fvider selection", "&7Sneak + clic droit air &8» &fchanger mode", "", "&8Outil de claim - jeter = detruit"
    enchant {_w} with unbreaking 1
    return {_w}

function claimIsWand(it: item) :: boolean:
    if {_it} is not a golden axe:
        return false
    set {_n} to display name of {_it}
    if {_n} is not set:
        return false
    if uncolored {_n} is not uncolored "{@wand_name}":
        return false
    return true

function claimPlayerHasWand(p: player) :: boolean:
    loop integers from 0 to 40:
        set {_it} to slot loop-value of {_p}'s inventory
        if claimIsWand({_it}) is true:
            return true
    return false

function claimHasEmptySlot(p: player) :: boolean:
    loop integers from 0 to 35:
        set {_it} to slot loop-value of {_p}'s inventory
        if {_it} is air:
            return true
    return false

function claimDestroyAllWands(p: player):
    loop integers from 0 to 40:
        set {_it} to slot loop-value of {_p}'s inventory
        if claimIsWand({_it}) is true:
            set slot loop-value of {_p}'s inventory to air
    if claimIsWand(cursor slot of {_p}) is true:
        set cursor slot of {_p} to air
    # Plus de wand = plus de mode selection : on oublie toute la selection
    # en cours (sommets, mode, nom, sous-titre, edition).
    claimSelClear(uuid of {_p})
    delete {claim::sel::%uuid of {_p}%::mode}
    delete {claim::sel::%uuid of {_p}%::usey}
    delete {claim::sel::%uuid of {_p}%::name}
    delete {claim::sel::%uuid of {_p}%::subtitle}
    delete {claim::sel::%uuid of {_p}%::asAdmin}
    delete {claim::editing::%uuid of {_p}%}
    claimFxCacheMarkDirty(uuid of {_p})

function claimGiveWand(p: player):
    if claimPlayerHasWand({_p}) is true:
        send "{@prefix}&7Tu as deja la &aClaim Wand&7." to {_p}
        stop
    if claimHasEmptySlot({_p}) is false:
        send "{@prefix}&cInventaire plein: impossible de te donner la wand. Libere une place." to {_p}
        stop
    give claimCreateWand() to {_p}
    send "{@prefix}&aWand recue. &7Clic gauche=pos1/sommet, clic droit=pos2/retirer." to {_p}

# ============================================================
#  Selection en cours (par joueur)
# ============================================================

function claimSelMode(uuid: text) :: text:
    if {claim::sel::%{_uuid}%::mode} is "poly":
        return "poly"
    return "rect"

function claimSelHasRect(uuid: text) :: boolean:
    if {claim::sel::%{_uuid}%::rect::1} is not set:
        return false
    if {claim::sel::%{_uuid}%::rect::2} is not set:
        return false
    return true

function claimSelPolyCount(uuid: text) :: integer:
    return {claim::sel::%{_uuid}%::poly::count} ? 0

function claimSelHasRegion(uuid: text) :: boolean:
    if claimSelMode({_uuid}) is "poly":
        if claimSelPolyCount({_uuid}) >= 3:
            return true
        return false
    return claimSelHasRect({_uuid})

function claimSelUseY(uuid: text) :: boolean:
    if {claim::sel::%{_uuid}%::usey} is true:
        return true
    return false

function claimSelArea(uuid: text) :: integer:
    if claimSelMode({_uuid}) is "poly":
        set {_n} to claimSelPolyCount({_uuid})
        if {_n} < 3:
            return 0
        set {_sum} to 0
        set {_i} to 1
        while {_i} <= {_n}:
            if {_i} = {_n}:
                set {_j} to 1
            else:
                set {_j} to {_i} + 1
            set {_xi} to x-coordinate of {claim::sel::%{_uuid}%::poly::%{_i}%}
            set {_zi} to z-coordinate of {claim::sel::%{_uuid}%::poly::%{_i}%}
            set {_xj} to x-coordinate of {claim::sel::%{_uuid}%::poly::%{_j}%}
            set {_zj} to z-coordinate of {claim::sel::%{_uuid}%::poly::%{_j}%}
            set {_sum} to {_sum} + {_xi} * {_zj} - {_xj} * {_zi}
            add 1 to {_i}
        return round(abs({_sum}) / 2)
    if claimSelHasRect({_uuid}) is false:
        return 0
    return claimRectArea({claim::sel::%{_uuid}%::rect::1}, {claim::sel::%{_uuid}%::rect::2})

function claimSelClear(uuid: text):
    delete {claim::sel::%{_uuid}%::rect::1}
    delete {claim::sel::%{_uuid}%::rect::2}
    delete {claim::sel::%{_uuid}%::poly::*}
    claimFxCacheClear({_uuid})

function claimSelPolyAdd(uuid: text, loc: location, max: integer = -1) :: boolean:
    set {_n} to claimSelPolyCount({_uuid})
    if {_max} <= 0:
        set {_max} to claimMaxVertices()
    if {_n} >= {_max}:
        return false
    if {_n} >= 2:
        set {_prev_idx} to {_n} - 1
        set {_v_prev} to {claim::sel::%{_uuid}%::poly::%{_prev_idx}%}
        set {_v_last} to {claim::sel::%{_uuid}%::poly::%{_n}%}
        if {_v_prev} is set:
            if {_v_last} is set:
                set {_ax} to floor(x-coordinate of {_v_prev})
                set {_az} to floor(z-coordinate of {_v_prev})
                set {_bx} to floor(x-coordinate of {_v_last})
                set {_bz} to floor(z-coordinate of {_v_last})
                set {_cx} to floor(x-coordinate of {_loc})
                set {_cz} to floor(z-coordinate of {_loc})
                set {_cross} to ({_bx} - {_ax}) * ({_cz} - {_az}) - ({_bz} - {_az}) * ({_cx} - {_ax})
                if {_cross} is 0:
                    set {claim::sel::%{_uuid}%::poly::%{_n}%} to {_loc}
                    claimFxCacheMarkDirty({_uuid})
                    return false
    set {_n2} to {_n} + 1
    set {claim::sel::%{_uuid}%::poly::%{_n2}%} to {_loc}
    set {claim::sel::%{_uuid}%::poly::count} to {_n2}
    claimFxCacheMarkDirty({_uuid})
    return true

function claimSelPolyRemoveLast(uuid: text) :: boolean:
    set {_n} to claimSelPolyCount({_uuid})
    if {_n} <= 0:
        return false
    delete {claim::sel::%{_uuid}%::poly::%{_n}%}
    if {_n} <= 1:
        delete {claim::sel::%{_uuid}%::poly::count}
    else:
        set {claim::sel::%{_uuid}%::poly::count} to {_n} - 1
    claimFxCacheMarkDirty({_uuid})
    return true

# Charge un claim existant dans la selection (pour edition).
function claimSelLoadFrom(uuid: text, id: integer):
    claimSelClear({_uuid})
    if claimMode({_id}) is "poly":
        set {claim::sel::%{_uuid}%::mode} to "poly"
        set {_n} to {claim::data::%{_id}%::poly::count} ? 0
        set {_i} to 1
        while {_i} <= {_n}:
            set {claim::sel::%{_uuid}%::poly::%{_i}%} to {claim::data::%{_id}%::poly::%{_i}%}
            add 1 to {_i}
        set {claim::sel::%{_uuid}%::poly::count} to {_n}
    else:
        delete {claim::sel::%{_uuid}%::mode}
        set {claim::sel::%{_uuid}%::rect::1} to {claim::data::%{_id}%::rect::1}
        set {claim::sel::%{_uuid}%::rect::2} to {claim::data::%{_id}%::rect::2}
    if claimUseY({_id}) is true:
        set {claim::sel::%{_uuid}%::usey} to true
    else:
        delete {claim::sel::%{_uuid}%::usey}
    claimFxCacheMarkDirty({_uuid})

# ============================================================
#  Edition: contexte courant
# ============================================================

function claimEditing(uuid: text) :: text:
    if {claim::editing::%{_uuid}%} is set:
        return {claim::editing::%{_uuid}%}
    return ""

function claimStartNew(uuid: text):
    # Si une selection existe deja, on la conserve: pas besoin de re-clic
    # pour valider. Le joueur peut directement faire /claim save.
    if claimSelHasRegion({_uuid}) is false:
        claimSelClear({_uuid})
        delete {claim::sel::%{_uuid}%::mode}
        delete {claim::sel::%{_uuid}%::usey}
    delete {claim::sel::%{_uuid}%::name}
    delete {claim::sel::%{_uuid}%::subtitle}
    set {claim::editing::%{_uuid}%} to "new"

function claimStartEdit(uuid: text, id: integer):
    claimSelLoadFrom({_uuid}, {_id})
    set {claim::sel::%{_uuid}%::name} to claimDisplayName({_id})
    set {claim::sel::%{_uuid}%::subtitle} to claimSubtitle({_id})
    set {claim::editing::%{_uuid}%} to "%{_id}%"

function claimEndEdit(uuid: text):
    delete {claim::editing::%{_uuid}%}
    delete {claim::sel::%{_uuid}%::name}
    delete {claim::sel::%{_uuid}%::subtitle}
    claimSelClear({_uuid})
    delete {claim::sel::%{_uuid}%::mode}
    delete {claim::sel::%{_uuid}%::usey}

# ============================================================
#  Validation et sauvegarde
# ============================================================

function claimValidateSel(p: player, asAdmin: boolean) :: text:
    set {_u} to uuid of {_p}
    if claimSelHasRegion({_u}) is false:
        return "&cAucune zone selectionnee. Utilise la wand."
    set {_area} to claimSelArea({_u})
    if {_area} <= 0:
        return "&cZone invalide (aire nulle)."
    if {_asAdmin} is false:
        if {_area} > claimMaxArea():
            return "&cZone trop grande: &f%{_area}% &c> max &f%claimMaxArea()%&c."
    if claimSelMode({_u}) is "poly":
        set {_w} to world of {claim::sel::%{_u}%::poly::1}
        set {_n} to claimSelPolyCount({_u})
        set {_i} to 2
        while {_i} <= {_n}:
            if world of {claim::sel::%{_u}%::poly::%{_i}%} is not {_w}:
                return "&cTous les sommets doivent etre dans le meme monde."
            add 1 to {_i}
    else:
        if world of {claim::sel::%{_u}%::rect::1} is not world of {claim::sel::%{_u}%::rect::2}:
            return "&cPos1 et pos2 doivent etre dans le meme monde."
    return ""

# Stocke les donnees de selection dans data::id::*
function claimWriteSelTo(uuid: text, id: integer):
    if claimSelMode({_uuid}) is "poly":
        set {claim::data::%{_id}%::mode} to "poly"
        delete {claim::data::%{_id}%::rect::1}
        delete {claim::data::%{_id}%::rect::2}
        delete {claim::data::%{_id}%::poly::*}
        set {_n} to claimSelPolyCount({_uuid})
        set {_i} to 1
        while {_i} <= {_n}:
            set {claim::data::%{_id}%::poly::%{_i}%} to {claim::sel::%{_uuid}%::poly::%{_i}%}
            add 1 to {_i}
        set {claim::data::%{_id}%::poly::count} to {_n}
        set {claim::data::%{_id}%::world} to "%world of {claim::sel::%{_uuid}%::poly::1}%"
    else:
        delete {claim::data::%{_id}%::mode}
        delete {claim::data::%{_id}%::poly::*}
        set {claim::data::%{_id}%::rect::1} to {claim::sel::%{_uuid}%::rect::1}
        set {claim::data::%{_id}%::rect::2} to {claim::sel::%{_uuid}%::rect::2}
        set {claim::data::%{_id}%::world} to "%world of {claim::sel::%{_uuid}%::rect::1}%"
    if claimSelUseY({_uuid}) is true:
        set {claim::data::%{_id}%::usey} to true
    else:
        delete {claim::data::%{_id}%::usey}

function claimSave(p: player) :: integer:
    set {_u} to uuid of {_p}
    set {_ctx} to claimEditing({_u})
    if {_ctx} is "":
        send "{@prefix}&cTu n'es pas en mode edition. &7Utilise &6/claim create &7ou &6/claim edit&7." to {_p}
        return 0
    set {_admin} to false
    if {claim::sel::%{_u}%::asAdmin} is true:
        if {_p} has permission "{@perm}":
            set {_admin} to true
    # Bypass des limites : permission "{@perm}" ou flag {claim::bypass::<uuid>}.
    # Distinct de {_admin} (qui sauvegarde en tant que zone ADMIN).
    set {_bypass} to false
    if claimHasBypass({_p}) is true:
        set {_bypass} to true
    if {_admin} is true:
        set {_bypass} to true
    set {_err} to claimValidateSel({_p}, {_bypass})
    if {_err} is not "":
        send "{@prefix}%{_err}%" to {_p}
        return 0
    if {_ctx} is "new":
        if {_bypass} is false:
            # Verifs joueur: limite nb claims + aire totale
            set {_owned} to size of {claim::owner::%{_u}%::*}
            if {_owned} is not set:
                set {_owned} to 0
            if {_owned} >= claimPlayerLimit({_u}):
                send "{@prefix}&cTu as atteint ta limite de claims (&f%{_owned}%&c/&f%claimPlayerLimit({_u})%&c)." to {_p}
                return 0
            set {_new} to claimSelArea({_u})
            set {_total} to claimPlayerTotalArea({_u}) + {_new}
            if {_total} > claimMaxTotalArea():
                send "{@prefix}&cAire totale depassee: &f%{_total}% &c> &f%claimMaxTotalArea()%&c." to {_p}
                return 0
        set {_id} to claimNextId()
        if {_admin} is true:
            set {claim::data::%{_id}%::owner} to "ADMIN"
            set {claim::data::%{_id}%::admin} to true
        else:
            set {claim::data::%{_id}%::owner} to {_u}
            set {claim::owner::%{_u}%::%{_id}%} to true
    else:
        set {_id} to {_ctx} parsed as integer
        if {_id} is not set:
            send "{@prefix}&cContexte d'edition invalide." to {_p}
            return 0
        if claimExists({_id}) is false:
            send "{@prefix}&cLe claim #&f%{_id}% &cn'existe plus." to {_p}
            return 0
        if claimIsAdminZone({_id}) is false:
            # Verifier aire totale en remplacant l'ancienne
            if {_bypass} is false:
                set {_old} to claimAreaOf({_id})
                set {_new} to claimSelArea({_u})
                set {_total} to claimPlayerTotalArea({_u}) - {_old} + {_new}
                if {_total} > claimMaxTotalArea():
                    send "{@prefix}&cAire totale depassee: &f%{_total}% &c> &f%claimMaxTotalArea()%&c." to {_p}
                    return 0
    claimWriteSelTo({_u}, {_id})
    # Nom / sous-titre
    if {claim::sel::%{_u}%::name} is set:
        set {claim::data::%{_id}%::name} to {claim::sel::%{_u}%::name}
    if {claim::sel::%{_u}%::subtitle} is set:
        set {claim::data::%{_id}%::subtitle} to {claim::sel::%{_u}%::subtitle}
    claimReindex({_id})
    bmUpsertClaim({_id})
    # Force la prochaine entree du joueur a re-afficher le titre/sous-titre mis a jour.
    delete {claim::titlecd::%{_u}%::%{_id}%}
    delete {claim::sel::%{_u}%::asAdmin}
    claimEndEdit({_u})
    set {_label} to claimDisplayName({_id})
    send "{@prefix}&aClaim &f%{_label}% &asauvegarde &7(id &f%{_id}%&7, aire &f%claimAreaOf({_id})%&7)" to {_p}
    play sound "minecraft:entity.player.levelup" with volume 0.7 with pitch 1.2 to {_p}
    return {_id}

function claimDelete(s: player, id: integer):
    if claimExists({_id}) is false:
        send "{@prefix}&cClaim introuvable: &f#%{_id}%&c." to {_s}
        stop
    if claimIsAdminZone({_id}) is true:
        if {_s} does not have permission "{@perm}":
            send "{@prefix}&cClaim admin: seul un admin peut le supprimer." to {_s}
            stop
    else:
        if claimCanDeleteClaim({_s}, {_id}) is false:
            send "{@prefix}&cSeul le proprietaire (ou un admin) peut supprimer ce claim." to {_s}
            stop
    set {_name} to claimDisplayName({_id})
    set {_owner} to claimOwnerUuid({_id})
    claimIndexRemove({_id})
    claimMembersClear({_id})
    bmRemoveClaim({_id})
    delete {claim::data::%{_id}%::*}
    if {_owner} is set:
        delete {claim::owner::%{_owner}%::%{_id}%}
    send "{@prefix}&aClaim &f%{_name}% &asupprime &7(id &f#%{_id}%&7)." to {_s}

# ============================================================
#  Gestion des membres (haut niveau, avec verifications)
#  ------------------------------------------------------------
#  Renvoient "" en cas de succes, ou un message d'erreur a afficher.
#  Ces helpers sont appeles aussi bien depuis la wand que depuis
#  les commandes.
# ============================================================

# Verifie que l'auteur peut gerer ce claim depuis l'endroit ou il se trouve.
# Les admins (perm) peuvent agir partout. Les autres doivent etre dans le claim.
function claimActorInClaim(p: player, id: integer) :: boolean:
    if claimHasBypass({_p}) is true:
        return true
    if claimAtLocation(location of {_p}) is {_id}:
        return true
    return false

# Resoud le claim cible pour les operations "members" :
# - si admin avec bypass -> claim sous ses pieds (ou en edition).
# - sinon -> claim sous ses pieds.
function claimResolveMemberTargetId(p: player) :: integer:
    set {_here} to claimAtLocation(location of {_p})
    if {_here} > 0:
        return {_here}
    return 0

# Ajoute un membre. Retourne "" si OK, sinon message d'erreur.
function claimMembersAdd(actor: player, id: integer, targetUuid: text, targetName: text) :: text:
    if claimExists({_id}) is false:
        return "&cClaim introuvable."
    if claimIsAdminZone({_id}) is true:
        if claimHasBypass({_actor}) is false:
            return "&cClaim admin: gestion reservee aux admins."
    if claimCanManageMembers({_actor}, {_id}) is false:
        return "&cTu n'as pas l'autorite pour ajouter des membres ici. &7(role operateur requis)"
    if claimActorInClaim({_actor}, {_id}) is false:
        return "&cTu dois te trouver dans le claim pour gerer ses membres."
    if claimOwnerUuid({_id}) is {_targetUuid}:
        return "&cCette personne est deja proprietaire."
    set {_existing} to claimRoleOf({_id}, {_targetUuid})
    if {_existing} is not "":
        return "&e%{_targetName}% &7est deja &f%claimRoleDisplay({_existing})%&7 dans ce claim."
    claimSetRole({_id}, {_targetUuid}, "member")
    return ""

# Retire un membre. Retourne "" si OK.
function claimMembersRemove(actor: player, id: integer, targetUuid: text, targetName: text) :: text:
    if claimExists({_id}) is false:
        return "&cClaim introuvable."
    if claimIsAdminZone({_id}) is true:
        if claimHasBypass({_actor}) is false:
            return "&cClaim admin: gestion reservee aux admins."
    if claimCanManageMembers({_actor}, {_id}) is false:
        return "&cTu n'as pas l'autorite pour retirer des membres ici. &7(role operateur requis)"
    if claimActorInClaim({_actor}, {_id}) is false:
        return "&cTu dois te trouver dans le claim pour gerer ses membres."
    if claimOwnerUuid({_id}) is {_targetUuid}:
        return "&cOn ne retire pas le proprietaire."
    set {_existing} to claimRoleOf({_id}, {_targetUuid})
    if {_existing} is "":
        return "&e%{_targetName}% &7n'est pas membre de ce claim."
    # Hierarchie : il faut etre strictement au-dessus de la cible.
    if claimEffectiveRank({_actor}, {_id}) <= claimRoleRank({_existing}):
        return "&cTu ne peux pas retirer un &f%claimRoleDisplay({_existing})%&c (rang superieur ou egal)."
    claimSetRole({_id}, {_targetUuid}, "")
    return ""

# Promotion (cycle member -> operator -> manager). Retourne "" si OK.
function claimMembersPromote(actor: player, id: integer, targetUuid: text, targetName: text) :: text:
    if claimExists({_id}) is false:
        return "&cClaim introuvable."
    if claimIsAdminZone({_id}) is true:
        if claimHasBypass({_actor}) is false:
            return "&cClaim admin: gestion reservee aux admins."
    if claimActorInClaim({_actor}, {_id}) is false:
        return "&cTu dois te trouver dans le claim pour gerer ses membres."
    if claimOwnerUuid({_id}) is {_targetUuid}:
        return "&cLe proprietaire est deja au sommet."
    set {_cur} to claimRoleOf({_id}, {_targetUuid})
    set {_next} to claimRoleNext({_cur})
    if {_next} is "":
        return "&e%{_targetName}% &7est deja &f%claimRoleDisplay({_cur})%&7 (max via promotion). &7Utilise &6/claim transfer&7 pour donner le claim."
    # L'auteur doit etre strictement au-dessus du futur rang.
    if claimEffectiveRank({_actor}, {_id}) <= claimRoleRank({_next}):
        return "&cTu ne peux pas promouvoir au-dessus ou au niveau de ton propre rang."
    # Pour passer de "" -> member il faut aussi pouvoir gerer.
    if {_cur} is "":
        if claimCanManageMembers({_actor}, {_id}) is false:
            return "&cTu n'as pas l'autorite pour ajouter des membres ici. &7(role operateur requis)"
    else:
        if claimCanManageMembers({_actor}, {_id}) is false:
            return "&cTu n'as pas l'autorite pour promouvoir ici. &7(role operateur requis)"
    claimSetRole({_id}, {_targetUuid}, {_next})
    return ""

# Retrogradation (manager -> operator -> member -> retire). Retourne "" si OK.
function claimMembersDemote(actor: player, id: integer, targetUuid: text, targetName: text) :: text:
    if claimExists({_id}) is false:
        return "&cClaim introuvable."
    if claimIsAdminZone({_id}) is true:
        if claimHasBypass({_actor}) is false:
            return "&cClaim admin: gestion reservee aux admins."
    if claimActorInClaim({_actor}, {_id}) is false:
        return "&cTu dois te trouver dans le claim pour gerer ses membres."
    if claimOwnerUuid({_id}) is {_targetUuid}:
        return "&cLe proprietaire ne se retrograde pas. &7Utilise &6/claim transfer&7."
    set {_cur} to claimRoleOf({_id}, {_targetUuid})
    if {_cur} is "":
        return "&e%{_targetName}% &7n'est pas membre."
    if claimEffectiveRank({_actor}, {_id}) <= claimRoleRank({_cur}):
        return "&cTu ne peux pas retrograder quelqu'un de ton rang ou au-dessus."
    set {_new} to ""
    if {_cur} is "manager":
        set {_new} to "operator"
    else if {_cur} is "operator":
        set {_new} to "member"
    claimSetRole({_id}, {_targetUuid}, {_new})
    return ""

# ============================================================
#  Transfert de propriete (requete avec acceptation)
#  ------------------------------------------------------------
#  Stockage cote cible :
#      {claim::xfer::%targetUuid%::id}   = id du claim
#      {claim::xfer::%targetUuid%::from} = uuid du proprietaire actuel
#      {claim::xfer::%targetUuid%::at}   = date d'emission
#  TTL : claim_xfer_ttl_seconds (configurable, defaut 2 min).
# ============================================================

function claimXferTtlSeconds() :: integer:
    if {claim::cfg::xfer_ttl} is set:
        return {claim::cfg::xfer_ttl}
    return {@claim_xfer_ttl_seconds}

function claimXferPendingId(targetUuid: text) :: integer:
    if {claim::xfer::%{_targetUuid}%::id} is not set:
        return 0
    set {_id} to {claim::xfer::%{_targetUuid}%::id}
    set {_at} to {claim::xfer::%{_targetUuid}%::at}
    if {_at} is set:
        set {_ttl} to claimXferTtlSeconds()
        if difference between {_at} and now > ({_ttl} * 1 second):
            claimXferClear({_targetUuid})
            return 0
    return {_id}

function claimXferPendingFrom(targetUuid: text) :: text:
    if {claim::xfer::%{_targetUuid}%::from} is set:
        return {claim::xfer::%{_targetUuid}%::from}
    return ""

function claimXferClear(targetUuid: text):
    delete {claim::xfer::%{_targetUuid}%::id}
    delete {claim::xfer::%{_targetUuid}%::from}
    delete {claim::xfer::%{_targetUuid}%::at}

# Cherche s'il existe deja une requete en cours envoyee PAR actor vers target.
function claimXferIsFrom(actorUuid: text, targetUuid: text) :: boolean:
    if claimXferPendingId({_targetUuid}) <= 0:
        return false
    if claimXferPendingFrom({_targetUuid}) is {_actorUuid}:
        return true
    return false

# Cree une requete de transfert. Retourne "" si OK, sinon message.
function claimXferRequest(actor: player, id: integer, targetUuid: text, targetName: text) :: text:
    if claimExists({_id}) is false:
        return "&cClaim introuvable."
    if claimIsAdminZone({_id}) is true:
        return "&cLes claims admin ne se transferent pas."
    if claimCanTransferOwnership({_actor}, {_id}) is false:
        return "&cSeul le proprietaire (ou un admin) peut transferer ce claim."
    if claimActorInClaim({_actor}, {_id}) is false:
        return "&cTu dois te trouver dans le claim pour le transferer."
    if claimOwnerUuid({_id}) is {_targetUuid}:
        return "&cCette personne possede deja le claim."
    set {_existing} to claimXferPendingId({_targetUuid})
    if {_existing} > 0:
        if claimXferPendingFrom({_targetUuid}) is uuid of {_actor}:
            if {_existing} is {_id}:
                return "&eUne requete est deja en cours pour &f%{_targetName}%&e. &7(sneak + clic droit a nouveau pour annuler)"
        else:
            return "&cCette personne a deja une requete de transfert en attente d'un autre proprietaire."
    set {claim::xfer::%{_targetUuid}%::id} to {_id}
    set {claim::xfer::%{_targetUuid}%::from} to uuid of {_actor}
    set {claim::xfer::%{_targetUuid}%::at} to now
    set {_target} to {_targetUuid} parsed as player
    if {_target} is set:
        send "{@prefix}&6&l%{_actor}%&r &7te propose de devenir &6proprietaire&7 de &f%claimDisplayName({_id})% &7(id &f#%{_id}%&7)." to {_target}
        send "{@prefix}&7Reponds par &a/claim accept&7 ou &c/claim deny &7(expire dans &f%claimXferTtlSeconds()%s&7)." to {_target}
        play sound "minecraft:block.note_block.bell" with volume 1 with pitch 1.2 to {_target}
    return ""

# Annule une requete (par le proprietaire actuel).
function claimXferCancel(actor: player, targetUuid: text, targetName: text) :: text:
    set {_id} to claimXferPendingId({_targetUuid})
    if {_id} <= 0:
        return "&7Aucune requete en cours pour &f%{_targetName}%&7."
    if claimXferPendingFrom({_targetUuid}) is not uuid of {_actor}:
        if claimHasBypass({_actor}) is false:
            return "&cTu n'es pas l'auteur de cette requete."
    claimXferClear({_targetUuid})
    set {_target} to {_targetUuid} parsed as player
    if {_target} is set:
        send "{@prefix}&7La requete de transfert de &f%claimDisplayName({_id})% &7a ete &cannulee&7." to {_target}
    return ""

# Acceptation : execute le transfert reel.
function claimXferAccept(target: player) :: text:
    set {_uuid} to uuid of {_target}
    set {_id} to claimXferPendingId({_uuid})
    if {_id} <= 0:
        return "&7Aucune offre de transfert."
    if claimExists({_id}) is false:
        claimXferClear({_uuid})
        return "&cLe claim concerne n'existe plus."
    set {_old} to claimOwnerUuid({_id})
    # Si on etait deja membre on retire l'ancien role (on devient owner).
    claimSetRole({_id}, {_uuid}, "")
    set {claim::data::%{_id}%::owner} to {_uuid}
    set {claim::owner::%{_uuid}%::%{_id}%} to true
    bmUpsertClaim({_id})
    if {_old} is set:
        delete {claim::owner::%{_old}%::%{_id}%}
        # L'ancien proprietaire devient manager pour ne pas perdre l'acces.
        claimSetRole({_id}, {_old}, "manager")
        set {_oldP} to {_old} parsed as player
        if {_oldP} is set:
            send "{@prefix}&6%name of {_target}%&r &aa accepte le transfert de &f%claimDisplayName({_id})%&a. &7Tu es maintenant &dGestionnaire&7." to {_oldP}
    claimXferClear({_uuid})
    return ""

# Refus.
function claimXferDeny(target: player) :: text:
    set {_uuid} to uuid of {_target}
    set {_id} to claimXferPendingId({_uuid})
    if {_id} <= 0:
        return "&7Aucune offre de transfert."
    set {_from} to claimXferPendingFrom({_uuid})
    claimXferClear({_uuid})
    if {_from} is set:
        set {_oldP} to {_from} parsed as player
        if {_oldP} is set:
            send "{@prefix}&c%name of {_target}% &7a refuse ton transfert de &f%claimDisplayName({_id})%&7." to {_oldP}
    return ""

# ============================================================
#  Adaptateurs wand <-> entites
#  ------------------------------------------------------------
#  Resolvent le claim cible (le claim sur lequel se trouve l'acteur)
#  puis delegueent a claimMembers*/claimXfer*.
# ============================================================

function claimWandResolveOrTell(actor: player) :: integer:
    set {_id} to claimAtLocation(location of {_actor})
    if {_id} <= 0:
        claimSendPriorityActionBar({_actor}, "&cTu dois te trouver dans un claim pour utiliser cette action.")
        play sound "minecraft:block.note_block.bass" with volume 0.6 with pitch 0.7 to {_actor}
        return 0
    return {_id}

function claimWandInviteEntity(actor: player, tgt: entity):
    if "%{_tgt}%" is "%{_actor}%":
        claimSendPriorityActionBar({_actor}, "&cTu ne peux pas te cibler toi-meme.")
        stop
    set {_targetP} to {_tgt} parsed as player
    if {_targetP} is not set:
        stop
    set {_id} to claimWandResolveOrTell({_actor})
    if {_id} <= 0:
        stop
    set {_tuuid} to uuid of {_targetP}
    set {_tname} to name of {_targetP}
    set {_cur} to claimRoleOf({_id}, {_tuuid})
    set {_err} to ""
    if {_cur} is "":
        set {_err} to claimMembersAdd({_actor}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            claimSendPriorityActionBar({_actor}, "&a%{_tname}% &7ajoute comme &aMembre&7 a &f%claimDisplayName({_id})%&7.")
            send "{@prefix}&aTu as ete ajoute comme &aMembre&a de &f%claimDisplayName({_id})%&a par &f%name of {_actor}%&a." to {_targetP}
            play sound "minecraft:block.note_block.pling" with volume 0.7 with pitch 1.4 to {_actor}
            play sound "minecraft:entity.experience_orb.pickup" with volume 0.6 with pitch 1.2 to {_targetP}
    else:
        set {_err} to claimMembersPromote({_actor}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            set {_new} to claimRoleOf({_id}, {_tuuid})
            claimSendPriorityActionBar({_actor}, "&a%{_tname}% &7promu &f%claimRoleDisplay({_new})%&7 sur &f%claimDisplayName({_id})%&7.")
            send "{@prefix}&aTu es maintenant &f%claimRoleDisplay({_new})%&a de &f%claimDisplayName({_id})%&a." to {_targetP}
            play sound "minecraft:block.note_block.pling" with volume 0.7 with pitch 1.7 to {_actor}
            play sound "minecraft:entity.experience_orb.pickup" with volume 0.7 with pitch 1.5 to {_targetP}
    if {_err} is not "":
        claimSendPriorityActionBar({_actor}, {_err})
        play sound "minecraft:block.note_block.bass" with volume 0.6 with pitch 0.8 to {_actor}

function claimWandKickEntity(actor: player, tgt: entity):
    if "%{_tgt}%" is "%{_actor}%":
        claimSendPriorityActionBar({_actor}, "&cTu ne peux pas te cibler toi-meme.")
        stop
    set {_targetP} to {_tgt} parsed as player
    if {_targetP} is not set:
        claimSendPriorityActionBar({_actor}, "&eLa Claim Wand ne peut pas servir a taper.")
        stop
    set {_id} to claimWandResolveOrTell({_actor})
    if {_id} <= 0:
        stop
    set {_tuuid} to uuid of {_targetP}
    set {_tname} to name of {_targetP}
    set {_err} to claimMembersRemove({_actor}, {_id}, {_tuuid}, {_tname})
    if {_err} is "":
        claimSendPriorityActionBar({_actor}, "&c%{_tname}% &7retire de &f%claimDisplayName({_id})%&7.")
        send "{@prefix}&cTu as ete retire de &f%claimDisplayName({_id})%&c par &f%name of {_actor}%&c." to {_targetP}
        play sound "minecraft:block.note_block.bass" with volume 0.7 with pitch 0.9 to {_actor}
        play sound "minecraft:block.note_block.bass" with volume 0.7 with pitch 0.7 to {_targetP}
    else:
        claimSendPriorityActionBar({_actor}, {_err})
        play sound "minecraft:block.note_block.bass" with volume 0.6 with pitch 0.8 to {_actor}

function claimWandTransferEntity(actor: player, tgt: entity):
    if "%{_tgt}%" is "%{_actor}%":
        claimSendPriorityActionBar({_actor}, "&cTu ne peux pas te cibler toi-meme.")
        stop
    set {_targetP} to {_tgt} parsed as player
    if {_targetP} is not set:
        stop
    set {_id} to claimWandResolveOrTell({_actor})
    if {_id} <= 0:
        stop
    set {_tuuid} to uuid of {_targetP}
    set {_tname} to name of {_targetP}
    # Si une requete est deja en cours de l'acteur vers la cible -> annule.
    if claimXferIsFrom(uuid of {_actor}, {_tuuid}) is true:
        set {_err} to claimXferCancel({_actor}, {_tuuid}, {_tname})
        if {_err} is "":
            claimSendPriorityActionBar({_actor}, "&7Requete de transfert vers &f%{_tname}%&7 annulee.")
            play sound "minecraft:block.note_block.bass" with volume 0.6 with pitch 1 to {_actor}
        else:
            claimSendPriorityActionBar({_actor}, {_err})
        stop
    set {_err} to claimXferRequest({_actor}, {_id}, {_tuuid}, {_tname})
    if {_err} is "":
        claimSendPriorityActionBar({_actor}, "&6Requete de transfert &7envoyee a &f%{_tname}%&7 (TTL &f%claimXferTtlSeconds()%s&7).")
        play sound "minecraft:block.note_block.bell" with volume 0.7 with pitch 1.2 to {_actor}
    else:
        claimSendPriorityActionBar({_actor}, {_err})
        play sound "minecraft:block.note_block.bass" with volume 0.6 with pitch 0.8 to {_actor}

# ============================================================
#  Detection d'entree (titre / sous-titre)
# ============================================================

function claimEnterShow(p: player, id: integer):
    set {_u} to uuid of {_p}
    set {_last} to {claim::titlecd::%{_u}%::%{_id}%}
    if {_last} is set:
        set {_elapsed} to difference between {_last} and now
        if {_elapsed} is less than {@enter_same_zone_cooldown}:
            stop
    # Cooldown consomme : la fenetre de 2 min n'est armee qu'a la SORTIE,
    # pas a l'affichage. On efface donc le marqueur pour ne pas re-bloquer
    # une eventuelle entree future apres une vraie sortie.
    delete {claim::titlecd::%{_u}%::%{_id}%}
    set {_name} to claimDisplayName({_id})
    set {_sub} to claimSubtitle({_id})
    set {_owner} to claimOwnerName({_id})
    if {_sub} is "":
        set {_sub} to "&7Chez &f%{_owner}%"
    if claimIsAdminZone({_id}) is true:
        send title "&a&l%{_name}%" with subtitle "%{_sub}%" to {_p} for 3 ticks, 20 ticks and 6 ticks
    else:
        send title "&a&l%{_name}%" with subtitle "%{_sub}%" to {_p} for 3 ticks, 20 ticks and 6 ticks
    play sound "minecraft:block.amethyst_block.chime" with volume 0.4 with pitch 1.3 to {_p}

function claimUpdatePlayerArea(p: player):
    set {_loc} to location of {_p}
    set {_cur} to claimAtLocation({_loc})
    set {_prev} to metadata value "claim_current" of {_p}
    if {_prev} is not set:
        set {_prev} to 0
    # Liste complete des claims contenant la position precedente :
    # permet de detecter qu'on "remonte" vers un claim deja englobant
    # (ex: sortie d'une sous-zone vers le parent) sans re-afficher son titre.
    set {_prevList} to metadata value "claim_current_list" of {_p}
    if {_prevList} is not set:
        set {_prevList} to ";"
    set {_curList} to claimsContainingLocation({_loc})
    set metadata value "claim_current_list" of {_p} to {_curList}
    # Armement du cooldown a la SORTIE : tout claim present dans la liste
    # precedente et plus dans la liste courante = on vient d'en sortir.
    # On (re)pose donc l'horodatage "sorti maintenant" pour bloquer le titre
    # pendant la fenetre {@enter_same_zone_cooldown}. Si le joueur re-rentre
    # dans cette fenetre, le compteur sera reecrase a la prochaine sortie.
    set {_u} to uuid of {_p}
    loop split {_prevList} at ";":
        if loop-value is not "":
            set {_lid} to loop-value parsed as integer
            if {_lid} is set:
                if {_lid} > 0:
                    if "%{_curList}%" does not contain ";%{_lid}%;":
                        set {claim::titlecd::%{_u}%::%{_lid}%} to now
    if {_cur} is {_prev}:
        stop
    set metadata value "claim_current" of {_p} to {_cur}
    if {_cur} > 0:
        # On etait deja a l'interieur de {_cur} via une sous-zone : pas de titre.
        if "%{_prevList}%" contains ";%{_cur}%;":
            stop
        claimEnterShow({_p}, {_cur})

function claimSendPriorityActionBar(p: player, msg: text):
    set metadata value "claim_ab_pause_at" of {_p} to now
    send action bar "%{_msg}%" to {_p}

function claimZoneActionBarPaused(p: player) :: boolean:
    if metadata value "claim_ab_pause_at" of {_p} is not set:
        return false
    set {_elapsed} to difference between metadata value "claim_ab_pause_at" of {_p} and now
    if {_elapsed} is less than {@actionbar_pause_ms} milliseconds:
        return true
    delete metadata value "claim_ab_pause_at" of {_p}
    return false

function claimWandClickAllowed(p: player) :: boolean:
    if metadata value "claim_wand_click_last" of {_p} is set:
        set {_elapsed} to difference between metadata value "claim_wand_click_last" of {_p} and now
        if {_elapsed} is less than {@wand_click_cooldown_ms} milliseconds:
            return false
    set metadata value "claim_wand_click_last" of {_p} to now
    return true

function claimActionBarTick(p: player):
    if claimIsWand(tool of {_p}) is false:
        stop
    if claimZoneActionBarPaused({_p}) is true:
        stop
    set {_u} to uuid of {_p}
    set {_ctx} to claimEditing({_u})
    set {_in} to claimAtLocation(location of {_p})
    set metadata value "claim_current" of {_p} to {_in}

    # Texte "zone courante" (fallback / suffixe).
    if {_in} > 0:
        set {_zoneInfo} to "&7Zone: &a%claimDisplayName({_in})% &8#%{_in}% &8| &7Chez: &f%claimOwnerName({_in})%"
    else:
        set {_zoneInfo} to "&7Zone: &fWilderness"

    # Sufixe d'edition (si applicable).
    set {_editTag} to ""
    if {_ctx} is not "":
        if {_ctx} is "new":
            set {_editTag} to " &8| &6Edition: &eNouveau"
        else:
            set {_eid} to {_ctx} parsed as integer
            if {_eid} is set:
                if claimExists({_eid}) is true:
                    set {_editTag} to " &8| &6Edition: &e#%{_eid}% &f%claimDisplayName({_eid})%"
                else:
                    set {_editTag} to " &8| &6Edition: &e#%{_ctx}%"
            else:
                set {_editTag} to " &8| &6Edition: &e#%{_ctx}%"

    # ====================================================================
    #  Priorite a la SELECTION en cours (si au moins un point pose).
    # ====================================================================
    set {_mode} to claimSelMode({_u})
    if {_mode} is "poly":
        set {_n} to claimSelPolyCount({_u})
        if {_n} > 0:
            set {_maxV} to claimMaxVerticesFor({_p})
            set {_useY} to ""
            if claimSelUseY({_u}) is true:
                set {_useY} to " &8| &7Y: &fon"
            else:
                set {_useY} to " &8| &7Y: &foff"
            if {_n} < 3:
                send action bar "&6Selection &dpoly &8| &7Sommets: &f%{_n}%&8/&f%{_maxV}% &8| &7Aire: &f-- &8| &eIl manque &f%3 - {_n}% &esommet(s)%{_useY}%%{_editTag}%" to {_p}
                stop
            set {_area} to claimSelArea({_u})
            set {_max} to claimMaxArea()
            set {_areaStr} to "&f%{_area}%"
            if {_area} > {_max}:
                set {_areaStr} to "&c%{_area}%&7/&c%{_max}%"
            else:
                set {_areaStr} to "&f%{_area}%&7/&f%{_max}%"
            send action bar "&6Selection &dpoly &8| &7Sommets: &f%{_n}%&8/&f%{_maxV}% &8| &7Aire: %{_areaStr}%%{_useY}%%{_editTag}%" to {_p}
            stop
    else:
        set {_a} to {claim::sel::%{_u}%::rect::1}
        set {_b} to {claim::sel::%{_u}%::rect::2}
        set {_hasSel} to false
        if {_a} is set:
            set {_hasSel} to true
        if {_b} is set:
            set {_hasSel} to true
        if {_hasSel} is true:
            set {_useY} to ""
            if claimSelUseY({_u}) is true:
                set {_useY} to " &8| &7Y: &fon"
            else:
                set {_useY} to " &8| &7Y: &foff"
            if {_a} is not set:
                set {_x} to floor(x-coordinate of {_b})
                set {_y} to floor(y-coordinate of {_b})
                set {_z} to floor(z-coordinate of {_b})
                send action bar "&6Selection &drect &8| &7pos2: &f%{_x}%&7,&f%{_y}%&7,&f%{_z}% &8| &ePose &fpos1 &e(clic gauche)%{_useY}%%{_editTag}%" to {_p}
                stop
            if {_b} is not set:
                set {_x} to floor(x-coordinate of {_a})
                set {_y} to floor(y-coordinate of {_a})
                set {_z} to floor(z-coordinate of {_a})
                send action bar "&6Selection &drect &8| &7pos1: &f%{_x}%&7,&f%{_y}%&7,&f%{_z}% &8| &ePose &fpos2 &e(clic droit)%{_useY}%%{_editTag}%" to {_p}
                stop
            # Deux points poses : on a une aire complete.
            set {_dx} to abs(floor(x-coordinate of {_a}) - floor(x-coordinate of {_b})) + 1
            set {_dz} to abs(floor(z-coordinate of {_a}) - floor(z-coordinate of {_b})) + 1
            set {_dim} to "&f%{_dx}%&7x&f%{_dz}%"
            if claimSelUseY({_u}) is true:
                set {_dy} to abs(floor(y-coordinate of {_a}) - floor(y-coordinate of {_b})) + 1
                set {_dim} to "&f%{_dx}%&7x&f%{_dz}%&7x&f%{_dy}%"
            set {_area} to claimSelArea({_u})
            set {_max} to claimMaxArea()
            set {_areaStr} to "&f%{_area}%&7/&f%{_max}%"
            if {_area} > {_max}:
                set {_areaStr} to "&c%{_area}%&7/&c%{_max}%"
            send action bar "&6Selection &drect &8| &7Dim: %{_dim}% &8| &7Aire: %{_areaStr}%%{_useY}%%{_editTag}%" to {_p}
            stop

    # ====================================================================
    #  Pas de selection en cours : on affiche la zone (+ edition si actif).
    # ====================================================================
    if {_editTag} is not "":
        send action bar "%{_zoneInfo}%%{_editTag}% &8| &7Mode: &f%{_mode}% &8| &eAucun point selectionne" to {_p}
        stop
    send action bar "%{_zoneInfo}%" to {_p}

function claimFxCacheClear(uuid: text):
    delete {claim::fxcache::%{_uuid}%::*}

function claimFxCacheMarkDirty(uuid: text):
    set {claim::fxcache::%{_uuid}%::dirty} to true
    set {claim::fxcache::%{_uuid}%::marker::dirty} to true

function claimFxParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    draw 1 of dust using dustOption(orange, 2.15) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxCornerParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    draw 4 of dust using dustOption(red, 2.5) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxSweepParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    draw 2 of dust using dustOption(orange, 2.45) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxSavedParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    draw 1 of dust using dustOption(green, 2.15) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxSavedSweepParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    draw 2 of dust using dustOption(lime, 2.45) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxSavedCornerParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    draw 2 of dust using dustOption(green, 2.3) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxForeignSweepParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    set {_c} to (metadata value "claim_fx_blue_count" of {_p}) ? 0
    set metadata value "claim_fx_blue_count" of {_p} to {_c} + 1
    draw 3 of dust using dustOption(blue, 2.4) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxForeignCornerParticleAt(p: player, x: number, y: number, z: number):
    set {_l} to location at {_x} + 0.5, {_y} + 0.15, {_z} + 0.5 in world of {_p}
    set {_c} to (metadata value "claim_fx_blue_count" of {_p}) ? 0
    set metadata value "claim_fx_blue_count" of {_p} to {_c} + 1
    draw 4 of dust using dustOption(blue, 2.3) at {_l} with offset vector(0, 0, 0) with extra 0 for {_p}

function claimFxMarkerRebuildInterval() :: timespan:
    # Pas de refresh periodique : le cache reste valide tant que pos1/pos2
    # ne bouge pas. Borne haute juste au cas ou les blocs voisins changent.
    return 60 seconds

function claimFxMarkerDisplayInterval() :: timespan:
    # Cadence d'affichage des marqueurs (independante du tick FX general).
    # Les particules happy_villager ont un lifetime long : pas besoin de spammer.
    return 1 seconds

function claimFxMarkerCanRenderNow(p: player) :: boolean:
    if metadata value "claim_fx_marker_last" of {_p} is set:
        set {_elapsed} to difference between metadata value "claim_fx_marker_last" of {_p} and now
        if {_elapsed} is less than claimFxMarkerDisplayInterval():
            return false
    set metadata value "claim_fx_marker_last" of {_p} to now
    return true

function claimFxNeighborIsOpen(l: location) :: boolean:
    set {_b} to block at {_l}
    if {_b} is air:
        return true
    if {_b} is passable:
        return true
    set {_t} to "%type of {_b}%"
    # Blocs non pleins qu'on traite comme de l'air pour afficher la face.
    if {_t} contains "SLAB":
        return true
    if {_t} contains "STAIRS":
        return true
    if {_t} contains "CARPET":
        return true
    if {_t} contains "SNOW":
        return true
    if {_t} contains "FENCE":
        return true
    if {_t} contains "WALL":
        return true
    if {_t} contains "PANE":
        return true
    if {_t} contains "TRAPDOOR":
        return true
    if {_t} contains "DOOR":
        return true
    if {_t} contains "BUTTON":
        return true
    if {_t} contains "PRESSURE_PLATE":
        return true
    if {_t} contains "RAIL":
        return true
    if {_t} contains "TORCH":
        return true
    if {_t} contains "SIGN":
        return true
    if {_t} contains "CHAIN":
        return true
    if {_t} contains "CANDLE":
        return true
    if {_t} contains "FLOWER":
        return true
    if {_t} contains "SAPLING":
        return true
    if {_t} contains "BUSH":
        return true
    return false

function claimFxMarkerAddEdge(uuid: text, idx: integer, ax: number, ay: number, az: number, bx: number, by: number, bz: number):
    set {_i} to 0
    while {_i} <= 4:
        set {_t} to {_i} / 4
        set {_lx} to {_ax} + ({_bx} - {_ax}) * {_t}
        set {_ly} to {_ay} + ({_by} - {_ay}) * {_t}
        set {_lz} to {_az} + ({_bz} - {_az}) * {_t}
        add "%{_lx}% %{_ly}% %{_lz}%" to {claim::fxcache::%{_uuid}%::marker::%{_idx}%::pts::*}
        add 1 to {_i}

function claimFxMarkerNeedsRebuild(uuid: text, idx: integer, key: text) :: boolean:
    if {claim::fxcache::%{_uuid}%::marker::dirty} is true:
        return true
    if {claim::fxcache::%{_uuid}%::marker::%{_idx}%::key} is not {_key}:
        return true
    if {claim::fxcache::%{_uuid}%::marker::%{_idx}%::pts::1} is not set:
        return true
    if {claim::fxcache::%{_uuid}%::marker::%{_idx}%::rebuilt} is not set:
        return true
    set {_elapsed} to difference between {claim::fxcache::%{_uuid}%::marker::%{_idx}%::rebuilt} and now
    if {_elapsed} is greater than claimFxMarkerRebuildInterval():
        return true
    return false

function claimFxMarkerBuild(uuid: text, idx: integer, p: player, x: number, y: number, z: number, key: text):
    set {_w} to world of {_p}
    set {_eps} to 0.02
    set {_x0} to {_x} - {_eps}
    set {_x1} to {_x} + 1 + {_eps}
    set {_y0} to {_y} - {_eps}
    set {_y1} to {_y} + 1 + {_eps}
    set {_z0} to {_z} - {_eps}
    set {_z1} to {_z} + 1 + {_eps}
    delete {claim::fxcache::%{_uuid}%::marker::%{_idx}%::pts::*}
    # TOP (y+1)
    set {_nloc} to location at {_x} + 0.5, {_y} + 1.5, {_z} + 0.5 in {_w}
    if claimFxNeighborIsOpen({_nloc}) is true:
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y1}, {_z0}, {_x1}, {_y1}, {_z0})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y1}, {_z1}, {_x1}, {_y1}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y1}, {_z0}, {_x0}, {_y1}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y1}, {_z0}, {_x1}, {_y1}, {_z1})
    # BOTTOM (y-1)
    set {_nloc} to location at {_x} + 0.5, {_y} - 0.5, {_z} + 0.5 in {_w}
    if claimFxNeighborIsOpen({_nloc}) is true:
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z0}, {_x1}, {_y0}, {_z0})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z1}, {_x1}, {_y0}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z0}, {_x0}, {_y0}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y0}, {_z0}, {_x1}, {_y0}, {_z1})
    # NORTH (-z)
    set {_nloc} to location at {_x} + 0.5, {_y} + 0.5, {_z} - 0.5 in {_w}
    if claimFxNeighborIsOpen({_nloc}) is true:
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z0}, {_x1}, {_y0}, {_z0})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y1}, {_z0}, {_x1}, {_y1}, {_z0})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z0}, {_x0}, {_y1}, {_z0})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y0}, {_z0}, {_x1}, {_y1}, {_z0})
    # SOUTH (+z)
    set {_nloc} to location at {_x} + 0.5, {_y} + 0.5, {_z} + 1.5 in {_w}
    if claimFxNeighborIsOpen({_nloc}) is true:
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z1}, {_x1}, {_y0}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y1}, {_z1}, {_x1}, {_y1}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z1}, {_x0}, {_y1}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y0}, {_z1}, {_x1}, {_y1}, {_z1})
    # WEST (-x)
    set {_nloc} to location at {_x} - 0.5, {_y} + 0.5, {_z} + 0.5 in {_w}
    if claimFxNeighborIsOpen({_nloc}) is true:
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z0}, {_x0}, {_y0}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y1}, {_z0}, {_x0}, {_y1}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z0}, {_x0}, {_y1}, {_z0})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x0}, {_y0}, {_z1}, {_x0}, {_y1}, {_z1})
    # EAST (+x)
    set {_nloc} to location at {_x} + 1.5, {_y} + 0.5, {_z} + 0.5 in {_w}
    if claimFxNeighborIsOpen({_nloc}) is true:
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y0}, {_z0}, {_x1}, {_y0}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y1}, {_z0}, {_x1}, {_y1}, {_z1})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y0}, {_z0}, {_x1}, {_y1}, {_z0})
        claimFxMarkerAddEdge({_uuid}, {_idx}, {_x1}, {_y0}, {_z1}, {_x1}, {_y1}, {_z1})
    set {claim::fxcache::%{_uuid}%::marker::%{_idx}%::key} to {_key}
    set {claim::fxcache::%{_uuid}%::marker::%{_idx}%::rebuilt} to now

function claimFxRenderMarkerCached(p: player, idx: integer, loc: location):
    set {_u} to uuid of {_p}
    if world of {_loc} is not world of {_p}:
        stop
    set {_x} to floor(x-coordinate of {_loc})
    set {_y} to floor(y-coordinate of {_loc})
    set {_z} to floor(z-coordinate of {_loc})
    set {_w} to "%world of {_loc}%"
    set {_key} to "%{_w}%;%{_x}%;%{_y}%;%{_z}%"
    set {_rebuilt} to false
    if claimFxMarkerNeedsRebuild({_u}, {_idx}, {_key}) is true:
        claimFxMarkerBuild({_u}, {_idx}, {_p}, {_x}, {_y}, {_z}, {_key})
        set {_rebuilt} to true
    if {_rebuilt} is true:
        if {claim::fxcache::%{_u}%::marker::dirty} is true:
            set {claim::fxcache::%{_u}%::marker::dirty} to false
    loop {claim::fxcache::%{_u}%::marker::%{_idx}%::pts::*}:
        set {_parts::*} to loop-value split by " "
        set {_lx} to first element of {_parts::*} parsed as number
        set {_ly} to 2nd element of {_parts::*} parsed as number
        set {_lz} to 3rd element of {_parts::*} parsed as number
        if {_lx} is set:
            if {_ly} is set:
                if {_lz} is set:
                    set {_pt} to location at {_lx}, {_ly}, {_lz} in world of {_p}
                    draw 1 of happy villager at {_pt} with offset vector(0, 0, 0) with extra 0 for {_p}

# Dessine les marqueurs des positions pos1/pos2 si presentes (rect mode).
function claimRenderSelMarkers(p: player):
    set {_u} to uuid of {_p}
    if claimSelMode({_u}) is "poly":
        set {_n} to claimSelPolyCount({_u})
        if {_n} <= 0:
            stop
        if claimFxMarkerCanRenderNow({_p}) is false:
            stop
        set {_i} to 1
        while {_i} <= {_n}:
            set {_v} to {claim::sel::%{_u}%::poly::%{_i}%}
            if {_v} is set:
                claimFxRenderMarkerCached({_p}, {_i}, {_v})
            add 1 to {_i}
        stop
    set {_a} to {claim::sel::%{_u}%::rect::1}
    set {_b} to {claim::sel::%{_u}%::rect::2}
    if {_a} is not set:
        if {_b} is not set:
            stop
    if claimFxMarkerCanRenderNow({_p}) is false:
        stop
    if {_a} is set:
        claimFxRenderMarkerCached({_p}, 1, {_a})
    if {_b} is set:
        claimFxRenderMarkerCached({_p}, 2, {_b})

function claimFxSavedSweepByView(p: player, x: number, y: number, z: number, foreign: boolean):
    if {_foreign} is true:
        claimFxForeignSweepParticleAt({_p}, {_x}, {_y}, {_z})
        stop
    claimFxSavedSweepParticleAt({_p}, {_x}, {_y}, {_z})

function claimFxSavedCornerByView(p: player, x: number, y: number, z: number, foreign: boolean):
    if {_foreign} is true:
        claimFxForeignCornerParticleAt({_p}, {_x}, {_y}, {_z})
        stop
    claimFxSavedCornerParticleAt({_p}, {_x}, {_y}, {_z})

function claimFxMinInterval() :: timespan:
    return 180 milliseconds

function claimFxCanRenderNow(p: player) :: boolean:
    if metadata value "claim_fx_last" of {_p} is set:
        set {_elapsed} to difference between metadata value "claim_fx_last" of {_p} and now
        if {_elapsed} is less than claimFxMinInterval():
            return false
    set metadata value "claim_fx_last" of {_p} to now
    return true

function claimFxRenderRadius() :: number:
    return 24

function claimFxShowForeignAll() :: boolean:
    if {claim::cfg::fx::foreign_all} is false:
        return false
    return true

function claimFxCanSeeForeign(p: player) :: boolean:
    if claimFxShowForeignAll() is true:
        return true
    if {_p} has permission "{@perm}":
        return true
    return false

function claimFxDebugEnabled() :: boolean:
    if {claim::cfg::fx::debug} is true:
        return true
    return false

function claimFxPerfEnabled() :: boolean:
    if {claim::cfg::fx::perf} is true:
        return true
    return false

function claimFxFaceDensityPercent() :: number:
    set {_d} to {claim::cfg::fx::density} ? 7
    if {_d} < 5:
        set {_d} to 5
    if {_d} > 100:
        set {_d} to 100
    return {_d}

function claimFxFrameStride(edgeCount: integer) :: integer:
    # Override admin optionnel: 1..6 (1 = toutes les cellules)
    set {_ov} to {claim::cfg::fx::stride}
    if {_ov} is set:
        set {_s} to {_ov}
        if {_s} < 1:
            set {_s} to 1
        if {_s} > 6:
            set {_s} to 6
        return {_s}
    # Auto selon taille du cache: visible sur petites zones, safe sur grandes.
    if {_edgeCount} <= 120:
        return 1
    if {_edgeCount} <= 260:
        return 2
    if {_edgeCount} <= 520:
        return 3
    set {_s} to 4
    if {_s} > 6:
        set {_s} to 6
    return {_s}

function claimFxNextFrame(p: player) :: integer:
    if metadata value "claim_fx_frame" of {_p} is not set:
        set metadata value "claim_fx_frame" of {_p} to 0
    add 1 to metadata value "claim_fx_frame" of {_p}
    set {_f} to metadata value "claim_fx_frame" of {_p}
    if {_f} > 1000000:
        set {_f} to 1
        set metadata value "claim_fx_frame" of {_p} to 1
    return {_f}

function claimRem(a: number, b: number) :: number:
    if {_b} <= 0:
        return 0
    return {_a} - floor({_a} / {_b}) * {_b}

function claimFxSweepIndex(frame: integer, edgeCount: integer) :: integer:
    if {_edgeCount} <= 1:
        return 1
    # Ping-pong 1..N..1
    set {_span} to ({_edgeCount} - 1) * 2
    set {_t} to claimRem({_frame} * 3, {_span})
    if {_t} > {_edgeCount} - 1:
        return {_span} - {_t} + 1
    return {_t} + 1

function claimFxLineBudget() :: integer:
    set {_b} to {claim::cfg::fx::line_budget} ? 130
    if {_b} < 60:
        set {_b} to 60
    if {_b} > 500:
        set {_b} to 500
    return {_b}

function claimFxCacheMaxPoints() :: integer:
    set {_m} to {@fx_cache_max_points}
    if {_m} < 200:
        set {_m} to 200
    return {_m}

function claimRenderSavedRectLineFx(p: player, id: integer, yLine: integer, center: location, radiusSq: number, forward: boolean, edgeStep: integer, foreign: boolean):
    set {_a} to {claim::data::%{_id}%::rect::1}
    set {_b} to {claim::data::%{_id}%::rect::2}
    if {_a} is not set:
        stop
    if {_b} is not set:
        stop
    if world of {_a} is not world of {_p}:
        stop
    set {_minX} to floor(min(x-coordinate of {_a}, x-coordinate of {_b}))
    set {_maxX} to floor(max(x-coordinate of {_a}, x-coordinate of {_b}))
    set {_minZ} to floor(min(z-coordinate of {_a}, z-coordinate of {_b}))
    set {_maxZ} to floor(max(z-coordinate of {_a}, z-coordinate of {_b}))
    # Pas fixe = 1 (densite max). On borne le parcours a une fenetre autour du joueur
    # pour que le cout reste constant quelle que soit la taille du claim.
    set {_rng} to ceil(claimFxRenderRadius()) + 2
    set {_px} to floor(x-coordinate of {_center})
    set {_pz} to floor(z-coordinate of {_center})
    set {_xLo} to {_px} - {_rng}
    set {_xHi} to {_px} + {_rng}
    if {_xLo} < {_minX}:
        set {_xLo} to {_minX}
    if {_xHi} > {_maxX}:
        set {_xHi} to {_maxX}
    set {_zLo} to {_pz} - {_rng}
    set {_zHi} to {_pz} + {_rng}
    if {_zLo} < {_minZ}:
        set {_zLo} to {_minZ}
    if {_zHi} > {_maxZ}:
        set {_zHi} to {_maxZ}
    set {_dzMin} to {_pz} - {_minZ}
    if {_dzMin} < 0:
        set {_dzMin} to 0 - {_dzMin}
    set {_dzMax} to {_pz} - {_maxZ}
    if {_dzMax} < 0:
        set {_dzMax} to 0 - {_dzMax}
    set {_dxMin} to {_px} - {_minX}
    if {_dxMin} < 0:
        set {_dxMin} to 0 - {_dxMin}
    set {_dxMax} to {_px} - {_maxX}
    if {_dxMax} < 0:
        set {_dxMax} to 0 - {_dxMax}
    if {_forward} is true:
        # Aretes horizontales (z = minZ / maxZ): on parcourt x dans la fenetre, seulement si l'arete est a portee
        if {_dzMin} <= {_rng}:
            set {_x} to {_xLo}
            while {_x} <= {_xHi}:
                if claimFxVisible({_center}, {_x}, {_minZ}, {_radiusSq}) is true:
                    claimFxSavedSweepByView({_p}, {_x}, {_yLine}, {_minZ}, {_foreign})
                add 1 to {_x}
        if {_maxZ} is not {_minZ}:
            if {_dzMax} <= {_rng}:
                set {_x} to {_xLo}
                while {_x} <= {_xHi}:
                    if claimFxVisible({_center}, {_x}, {_maxZ}, {_radiusSq}) is true:
                        claimFxSavedSweepByView({_p}, {_x}, {_yLine}, {_maxZ}, {_foreign})
                    add 1 to {_x}
        # Aretes verticales (x = minX / maxX)
        if {_dxMin} <= {_rng}:
            set {_z} to {_zLo}
            while {_z} <= {_zHi}:
                if claimFxVisible({_center}, {_minX}, {_z}, {_radiusSq}) is true:
                    claimFxSavedSweepByView({_p}, {_minX}, {_yLine}, {_z}, {_foreign})
                add 1 to {_z}
        if {_maxX} is not {_minX}:
            if {_dxMax} <= {_rng}:
                set {_z} to {_zLo}
                while {_z} <= {_zHi}:
                    if claimFxVisible({_center}, {_maxX}, {_z}, {_radiusSq}) is true:
                        claimFxSavedSweepByView({_p}, {_maxX}, {_yLine}, {_z}, {_foreign})
                    add 1 to {_z}
    else:
        if {_dzMax} <= {_rng}:
            set {_x} to {_xHi}
            while {_x} >= {_xLo}:
                if claimFxVisible({_center}, {_x}, {_maxZ}, {_radiusSq}) is true:
                    claimFxSavedSweepByView({_p}, {_x}, {_yLine}, {_maxZ}, {_foreign})
                remove 1 from {_x}
        if {_maxZ} is not {_minZ}:
            if {_dzMin} <= {_rng}:
                set {_x} to {_xHi}
                while {_x} >= {_xLo}:
                    if claimFxVisible({_center}, {_x}, {_minZ}, {_radiusSq}) is true:
                        claimFxSavedSweepByView({_p}, {_x}, {_yLine}, {_minZ}, {_foreign})
                    remove 1 from {_x}
        if {_dxMax} <= {_rng}:
            set {_z} to {_zHi}
            while {_z} >= {_zLo}:
                if claimFxVisible({_center}, {_maxX}, {_z}, {_radiusSq}) is true:
                    claimFxSavedSweepByView({_p}, {_maxX}, {_yLine}, {_z}, {_foreign})
                remove 1 from {_z}
        if {_maxX} is not {_minX}:
            if {_dxMin} <= {_rng}:
                set {_z} to {_zHi}
                while {_z} >= {_zLo}:
                    if claimFxVisible({_center}, {_minX}, {_z}, {_radiusSq}) is true:
                        claimFxSavedSweepByView({_p}, {_minX}, {_yLine}, {_z}, {_foreign})
                    remove 1 from {_z}
    # Coins selon vue: vert (own) ou bleu (foreign).
    if claimFxVisible({_center}, {_minX}, {_minZ}, {_radiusSq}) is true:
        claimFxSavedCornerByView({_p}, {_minX}, {_yLine}, {_minZ}, {_foreign})
    if claimFxVisible({_center}, {_maxX}, {_minZ}, {_radiusSq}) is true:
        claimFxSavedCornerByView({_p}, {_maxX}, {_yLine}, {_minZ}, {_foreign})
    if claimFxVisible({_center}, {_maxX}, {_maxZ}, {_radiusSq}) is true:
        claimFxSavedCornerByView({_p}, {_maxX}, {_yLine}, {_maxZ}, {_foreign})
    if claimFxVisible({_center}, {_minX}, {_maxZ}, {_radiusSq}) is true:
        claimFxSavedCornerByView({_p}, {_minX}, {_yLine}, {_maxZ}, {_foreign})

function claimRenderSavedPolyLineFx(p: player, id: integer, yLine: integer, center: location, radiusSq: number, forward: boolean, edgeStep: integer, foreign: boolean):
    # NOTE: edgeStep est ignore pour le poly.
    # Densite constante quelle que soit l'orientation: on parametre le segment
    # par sa longueur Euclidienne (et non Chebyshev). steps = ceil(len * dens)
    # => ~"dens" particules par bloc le long de TOUTE arete (axis-aligned ou
    # diagonale). Pour rester safe TPS, on ne parcourt que la portion du
    # segment dans le rayon de rendu autour du joueur.
    set {_n} to {claim::data::%{_id}%::poly::count} ? 0
    if {_n} < 2:
        stop
    set {_dens} to 1.4
    set {_R} to claimFxRenderRadius() + 2
    set {_pxC} to x-coordinate of {_center}
    set {_pzC} to z-coordinate of {_center}
    set {_i} to 1
    while {_i} <= {_n}:
        set {_j} to {_i} + 1
        if {_j} > {_n}:
            set {_j} to 1
        set {_a} to {claim::data::%{_id}%::poly::%{_i}%}
        set {_b} to {claim::data::%{_id}%::poly::%{_j}%}
        if {_a} is set:
            if {_b} is set:
                if world of {_a} is world of {_p}:
                    set {_x1} to floor(x-coordinate of {_a})
                    set {_z1} to floor(z-coordinate of {_a})
                    set {_x2} to floor(x-coordinate of {_b})
                    set {_z2} to floor(z-coordinate of {_b})
                    set {_vx} to {_x2} - {_x1}
                    set {_vz} to {_z2} - {_z1}
                    set {_vv} to {_vx} * {_vx} + {_vz} * {_vz}
                    if {_vv} > 0:
                        set {_len} to sqrt({_vv})
                        set {_steps} to ceil({_len} * {_dens})
                        if {_steps} < 1:
                            set {_steps} to 1
                        # Projection du joueur sur AB -> parametre t dans [0,1].
                        set {_wx} to {_pxC} - {_x1} - 0.5
                        set {_wz} to {_pzC} - {_z1} - 0.5
                        set {_t} to ({_wx} * {_vx} + {_wz} * {_vz}) / {_vv}
                        if {_t} < 0:
                            set {_t} to 0
                        if {_t} > 1:
                            set {_t} to 1
                        # Cull global: distance carree min player <-> segment.
                        set {_cpDx} to ({_x1} + {_t} * {_vx} + 0.5) - {_pxC}
                        set {_cpDz} to ({_z1} + {_t} * {_vz} + 0.5) - {_pzC}
                        set {_segD2} to {_cpDx} * {_cpDx} + {_cpDz} * {_cpDz}
                        if {_segD2} <= {_radiusSq}:
                            # Fenetre proportionnelle a la fraction du segment
                            # dans le rayon: tWin = R/len. Borne le cout a
                            # ~ 2 * R * dens iterations par segment.
                            set {_tWin} to {_R} / {_len}
                            if {_tWin} > 1:
                                set {_tWin} to 1
                            set {_tLo} to {_t} - {_tWin}
                            set {_tHi} to {_t} + {_tWin}
                            if {_tLo} < 0:
                                set {_tLo} to 0
                            if {_tHi} > 1:
                                set {_tHi} to 1
                            set {_kLo} to floor({_tLo} * {_steps})
                            set {_kHi} to ceil({_tHi} * {_steps})
                            if {_kLo} < 0:
                                set {_kLo} to 0
                            if {_kHi} > {_steps}:
                                set {_kHi} to {_steps}
                            if {_forward} is true:
                                set {_k} to {_kLo}
                                while {_k} <= {_kHi}:
                                    set {_xk} to round({_x1} + {_vx} * {_k} / {_steps})
                                    set {_zk} to round({_z1} + {_vz} * {_k} / {_steps})
                                    if claimFxVisible({_center}, {_xk}, {_zk}, {_radiusSq}) is true:
                                        claimFxSavedSweepByView({_p}, {_xk}, {_yLine}, {_zk}, {_foreign})
                                    add 1 to {_k}
                            else:
                                set {_k} to {_kHi}
                                while {_k} >= {_kLo}:
                                    set {_xk} to round({_x1} + {_vx} * {_k} / {_steps})
                                    set {_zk} to round({_z1} + {_vz} * {_k} / {_steps})
                                    if claimFxVisible({_center}, {_xk}, {_zk}, {_radiusSq}) is true:
                                        claimFxSavedSweepByView({_p}, {_xk}, {_yLine}, {_zk}, {_foreign})
                                    remove 1 from {_k}
                    # Coin (sommet A) si visible.
                    if claimFxVisible({_center}, {_x1}, {_z1}, {_radiusSq}) is true:
                        claimFxSavedCornerByView({_p}, {_x1}, {_yLine}, {_z1}, {_foreign})
        add 1 to {_i}

function claimRenderOwnedClaimsFx(p: player, frame: integer):
    set {_u} to uuid of {_p}
    set {_r} to claimFxRenderRadius()
    set {_r2} to {_r} * {_r}
    set {_c} to location of {_p}
    loop indices of {claim::owner::%{_u}%::*}:
        set {_id} to loop-value parsed as integer
        if {_id} is not set:
            continue
        if claimExists({_id}) is false:
            continue
        if claimOwnerUuid({_id}) is not {_u}:
            continue
        if claimWorld({_id}) is not "%world of {_p}%":
            continue
        if {claim::data::%{_id}%::bbox::minX} is not set:
            claimBuildBBox({_id})
        set {_minX} to {claim::data::%{_id}%::bbox::minX}
        set {_maxX} to {claim::data::%{_id}%::bbox::maxX}
        set {_minZ} to {claim::data::%{_id}%::bbox::minZ}
        set {_maxZ} to {claim::data::%{_id}%::bbox::maxZ}
        set {_px} to x-coordinate of {_p}
        set {_pz} to z-coordinate of {_p}
        if {_px} < {_minX} - {_r} - 2:
            continue
        if {_px} > {_maxX} + {_r} + 2:
            continue
        if {_pz} < {_minZ} - {_r} - 2:
            continue
        if {_pz} > {_maxZ} + {_r} + 2:
            continue
        set {_minY} to {claim::data::%{_id}%::bbox::minY}
        set {_maxY} to {claim::data::%{_id}%::bbox::maxY}
        # Fenetre verticale: par defaut centree sur le joueur, etendue au
        # claim entier si useY est active. Clampee a +/-6 blocs autour du
        # joueur pour borner le cout (perspective: au-dela on voit a peine).
        set {_pY} to floor(y-coordinate of {_p})
        set {_yWin} to 8
        set {_capWin} to 20
        if claimUseY({_id}) is true:
            if {_minY} is set:
                if {_maxY} is set:
                    set {_minYL} to {_minY} - 1
                    set {_maxYL} to {_maxY} + 1
                else:
                    set {_minYL} to {_pY} - 2
                    set {_maxYL} to {_pY} + 7
            else:
                set {_minYL} to {_pY} - 2
                set {_maxYL} to {_pY} + 7
        else:
            set {_minYL} to {_pY} - 2
            set {_maxYL} to {_pY} + 7
        if {_minYL} < {_pY} - {_yWin}:
            set {_minYL} to {_pY} - {_yWin}
        if {_maxYL} > {_pY} + {_yWin}:
            set {_maxYL} to {_pY} + {_yWin}

        set {_per} to 2 * (({_maxX} - {_minX}) + ({_maxZ} - {_minZ})) + 4
        if {_per} < 8:
            set {_per} to 8
        set {_budget} to claimFxLineBudget()
        if {_budget} > 90:
            set {_budget} to 90
        set {_edgeStep} to ceil({_per} / {_budget})
        if {_edgeStep} < 1:
            set {_edgeStep} to 1

        set {_isPoly} to false
        if claimMode({_id}) is "poly":
            set {_isPoly} to true
        set {_yL} to {_minYL}
        while {_yL} <= {_maxYL}:
            if {_isPoly} is true:
                claimRenderSavedPolyLineFx({_p}, {_id}, {_yL}, {_c}, {_r2}, true, {_edgeStep}, false)
            else:
                claimRenderSavedRectLineFx({_p}, {_id}, {_yL}, {_c}, {_r2}, true, {_edgeStep}, false)
            add 1 to {_yL}

        # Sol + plafond (faces horizontales) si useY est active
        if claimUseY({_id}) is true:
            if {_minY} is set:
                if {_maxY} is set:
                    set {_floorY} to {_minY} - 1
                    set {_ceilY} to {_maxY} + 1
                    if {_floorY} >= {_pY} - {_capWin}:
                        if {_floorY} <= {_pY} + {_capWin}:
                            if {_isPoly} is true:
                                claimRenderFaceSavedPolyAtY({_p}, {_c}, {_id}, {_floorY}, {_r2}, {_r}, false)
                            else:
                                claimRenderFaceRectAtY({_p}, {_c}, {_floorY}, {_minX}, {_maxX}, {_minZ}, {_maxZ}, {_r2}, {_r}, false, false)
                    if {_ceilY} >= {_pY} - {_capWin}:
                        if {_ceilY} <= {_pY} + {_capWin}:
                            if {_isPoly} is true:
                                claimRenderFaceSavedPolyAtY({_p}, {_c}, {_id}, {_ceilY}, {_r2}, {_r}, false)
                            else:
                                claimRenderFaceRectAtY({_p}, {_c}, {_ceilY}, {_minX}, {_maxX}, {_minZ}, {_maxZ}, {_r2}, {_r}, false, false)

function claimSelPolyContains2D(uuid: text, x: number, z: number) :: boolean:
    set {_n} to {claim::sel::%{_uuid}%::poly::count} ? 0
    if {_n} < 3:
        return false
    set {_inside} to false
    set {_i} to 1
    set {_j} to {_n}
    while {_i} <= {_n}:
        set {_xi} to x-coordinate of {claim::sel::%{_uuid}%::poly::%{_i}%}
        set {_zi} to z-coordinate of {claim::sel::%{_uuid}%::poly::%{_i}%}
        set {_xj} to x-coordinate of {claim::sel::%{_uuid}%::poly::%{_j}%}
        set {_zj} to z-coordinate of {claim::sel::%{_uuid}%::poly::%{_j}%}
        set {_a} to false
        set {_b} to false
        if {_zi} > {_z}:
            set {_a} to true
        if {_zj} > {_z}:
            set {_b} to true
        if {_a} is not {_b}:
            set {_dz} to {_zj} - {_zi}
            if {_dz} is not 0:
                set {_slope} to ({_xj} - {_xi}) * ({_z} - {_zi}) / {_dz} + {_xi}
                if {_x} < {_slope}:
                    if {_inside} is true:
                        set {_inside} to false
                    else:
                        set {_inside} to true
        set {_j} to {_i}
        add 1 to {_i}
    return {_inside}

function claimFxFaceStep() :: integer:
    set {_s} to {claim::cfg::fx::face_step} ? 2
    if {_s} < 1:
        set {_s} to 1
    if {_s} > 6:
        set {_s} to 6
    return {_s}

function claimRenderFaceRectAtY(p: player, c: location, yLine: integer, minX: integer, maxX: integer, minZ: integer, maxZ: integer, r2: number, rng: integer, foreign: boolean, isSel: boolean):
    set {_px} to floor(x-coordinate of {_c})
    set {_pz} to floor(z-coordinate of {_c})
    set {_xLo} to {_px} - {_rng}
    set {_xHi} to {_px} + {_rng}
    if {_xLo} < {_minX}:
        set {_xLo} to {_minX}
    if {_xHi} > {_maxX}:
        set {_xHi} to {_maxX}
    set {_zLo} to {_pz} - {_rng}
    set {_zHi} to {_pz} + {_rng}
    if {_zLo} < {_minZ}:
        set {_zLo} to {_minZ}
    if {_zHi} > {_maxZ}:
        set {_zHi} to {_maxZ}
    set {_step} to claimFxFaceStep()
    set {_x} to {_xLo}
    while {_x} <= {_xHi}:
        set {_z} to {_zLo}
        while {_z} <= {_zHi}:
            if claimFxVisible({_c}, {_x}, {_z}, {_r2}) is true:
                if {_isSel} is true:
                    claimFxSweepParticleAt({_p}, {_x}, {_yLine}, {_z})
                else:
                    claimFxSavedSweepByView({_p}, {_x}, {_yLine}, {_z}, {_foreign})
            add {_step} to {_z}
        add {_step} to {_x}

function claimRenderFaceSelPolyAtY(p: player, c: location, u: text, yLine: integer, r2: number, rng: integer):
    set {_n} to {claim::sel::%{_u}%::poly::count} ? 0
    if {_n} < 3:
        stop
    set {_minX} to floor(x-coordinate of {claim::sel::%{_u}%::poly::1})
    set {_maxX} to {_minX}
    set {_minZ} to floor(z-coordinate of {claim::sel::%{_u}%::poly::1})
    set {_maxZ} to {_minZ}
    set {_i} to 2
    while {_i} <= {_n}:
        set {_xi} to floor(x-coordinate of {claim::sel::%{_u}%::poly::%{_i}%})
        set {_zi} to floor(z-coordinate of {claim::sel::%{_u}%::poly::%{_i}%})
        if {_xi} < {_minX}:
            set {_minX} to {_xi}
        if {_xi} > {_maxX}:
            set {_maxX} to {_xi}
        if {_zi} < {_minZ}:
            set {_minZ} to {_zi}
        if {_zi} > {_maxZ}:
            set {_maxZ} to {_zi}
        add 1 to {_i}
    set {_px} to floor(x-coordinate of {_c})
    set {_pz} to floor(z-coordinate of {_c})
    set {_xLo} to {_px} - {_rng}
    set {_xHi} to {_px} + {_rng}
    if {_xLo} < {_minX}:
        set {_xLo} to {_minX}
    if {_xHi} > {_maxX}:
        set {_xHi} to {_maxX}
    set {_zLo} to {_pz} - {_rng}
    set {_zHi} to {_pz} + {_rng}
    if {_zLo} < {_minZ}:
        set {_zLo} to {_minZ}
    if {_zHi} > {_maxZ}:
        set {_zHi} to {_maxZ}
    set {_step} to claimFxFaceStep()
    set {_x} to {_xLo}
    while {_x} <= {_xHi}:
        set {_z} to {_zLo}
        while {_z} <= {_zHi}:
            if claimFxVisible({_c}, {_x}, {_z}, {_r2}) is true:
                if claimSelPolyContains2D({_u}, {_x} + 0.5, {_z} + 0.5) is true:
                    claimFxSweepParticleAt({_p}, {_x}, {_yLine}, {_z})
            add {_step} to {_z}
        add {_step} to {_x}

function claimRenderFaceSavedPolyAtY(p: player, c: location, id: integer, yLine: integer, r2: number, rng: integer, foreign: boolean):
    set {_minX} to {claim::data::%{_id}%::bbox::minX}
    set {_maxX} to {claim::data::%{_id}%::bbox::maxX}
    set {_minZ} to {claim::data::%{_id}%::bbox::minZ}
    set {_maxZ} to {claim::data::%{_id}%::bbox::maxZ}
    if {_minX} is not set:
        stop
    set {_px} to floor(x-coordinate of {_c})
    set {_pz} to floor(z-coordinate of {_c})
    set {_xLo} to {_px} - {_rng}
    set {_xHi} to {_px} + {_rng}
    if {_xLo} < {_minX}:
        set {_xLo} to {_minX}
    if {_xHi} > {_maxX}:
        set {_xHi} to {_maxX}
    set {_zLo} to {_pz} - {_rng}
    set {_zHi} to {_pz} + {_rng}
    if {_zLo} < {_minZ}:
        set {_zLo} to {_minZ}
    if {_zHi} > {_maxZ}:
        set {_zHi} to {_maxZ}
    set {_step} to claimFxFaceStep()
    set {_x} to {_xLo}
    while {_x} <= {_xHi}:
        set {_z} to {_zLo}
        while {_z} <= {_zHi}:
            if claimFxVisible({_c}, {_x}, {_z}, {_r2}) is true:
                if claimPolyContains2D({_id}, {_x} + 0.5, {_z} + 0.5) is true:
                    claimFxSavedSweepByView({_p}, {_x}, {_yLine}, {_z}, {_foreign})
            add {_step} to {_z}
        add {_step} to {_x}

function claimFxForeignRefreshInterval() :: timespan:
    return 900 milliseconds

function claimFxForeignScanBudget() :: integer:
    set {_b} to {claim::cfg::fx::foreign_scan_budget} ? 180
    if {_b} < 40:
        set {_b} to 40
    if {_b} > 1200:
        set {_b} to 1200
    return {_b}

function claimFxForeignMaxVisibleClaims() :: integer:
    set {_m} to {claim::cfg::fx::foreign_max_claims} ? 8
    if {_m} < 2:
        set {_m} to 2
    if {_m} > 24:
        set {_m} to 24
    return {_m}

function claimFxRefreshForeignNearCache(p: player):
    if claimFxCanSeeForeign({_p}) is false:
        stop
    if metadata value "claim_fx_foreign_cache_at" of {_p} is set:
        set {_elapsed} to difference between metadata value "claim_fx_foreign_cache_at" of {_p} and now
        if {_elapsed} is less than claimFxForeignRefreshInterval():
            stop
    set metadata value "claim_fx_foreign_cache_at" of {_p} to now
    set {_u} to uuid of {_p}
    delete {claim::fxnear::%{_u}%::*}
    set {_maxKeep} to claimFxForeignMaxVisibleClaims()
    set {_scanBudget} to claimFxForeignScanBudget()
    set {_r} to claimFxRenderRadius() + 8
    set {_w} to "%world of {_p}%"
    set {_px} to x-coordinate of {_p}
    set {_pz} to z-coordinate of {_p}
    set {_idMax} to {claim::id::counter} ? 0
    if {_idMax} <= 0:
        stop
    set {_dbg} to claimFxDebugEnabled()
    set {_cursor} to metadata value "claim_fx_foreign_cursor" of {_p}
    if {_cursor} is not set:
        set {_cursor} to 1
    if {_cursor} < 1:
        set {_cursor} to 1
    if {_cursor} > {_idMax}:
        set {_cursor} to 1
    set {_scanned} to 0
    set {_keep} to 0
    while {_scanned} < {_scanBudget}:
        set {_id} to {_cursor}
        add 1 to {_scanned}
        add 1 to {_cursor}
        if {_cursor} > {_idMax}:
            set {_cursor} to 1
        if claimExists({_id}) is false:
            continue
        if claimOwnerUuid({_id}) is {_u}:
            continue
        if {claim::fxnear::%{_u}%::seen::%{_id}%} is set:
            continue
        set {_cw} to "%claimWorld({_id})%"
        if {_cw} is not {_w}:
            if {_dbg} is true:
                send "[claim-fx] skip id=%{_id}% reason=world ('%{_cw}%' != '%{_w}%')" to console
            continue
        if {claim::data::%{_id}%::bbox::minX} is not set:
            claimBuildBBox({_id})
        set {_minX} to {claim::data::%{_id}%::bbox::minX}
        set {_maxX} to {claim::data::%{_id}%::bbox::maxX}
        set {_minZ} to {claim::data::%{_id}%::bbox::minZ}
        set {_maxZ} to {claim::data::%{_id}%::bbox::maxZ}
        if {_minX} is not set:
            if {_dbg} is true:
                send "[claim-fx] skip id=%{_id}% reason=no_bbox" to console
            continue
        if {_px} < {_minX} - {_r} - 2:
            continue
        if {_px} > {_maxX} + {_r} + 2:
            continue
        if {_pz} < {_minZ} - {_r} - 2:
            continue
        if {_pz} > {_maxZ} + {_r} + 2:
            continue
        add 1 to {_keep}
        set {claim::fxnear::%{_u}%::id::%{_keep}%} to {_id}
        set {claim::fxnear::%{_u}%::seen::%{_id}%} to true
        if {_dbg} is true:
            send "[claim-fx] keep id=%{_id}% bbox=(%{_minX}%,%{_minZ}%)-(%{_maxX}%,%{_maxZ}%) p=(%floor({_px})%,%floor({_pz})%) w=%{_w}%" to console
        if {_keep} >= {_maxKeep}:
            stop loop
    set metadata value "claim_fx_foreign_cursor" of {_p} to {_cursor}
    set {claim::fxnear::%{_u}%::count} to {_keep}
    if {_dbg} is true:
        send "[claim-fx] refresh p=%name of {_p}% idMax=%{_idMax}% scanned=%{_scanned}% kept=%{_keep}%" to console

function claimRenderForeignClaimsFx(p: player, frame: integer):
    if claimFxCanSeeForeign({_p}) is false:
        stop
    claimFxRefreshForeignNearCache({_p})
    set {_u} to uuid of {_p}
    set {_count} to {claim::fxnear::%{_u}%::count} ? 0
    set {_dbg} to claimFxDebugEnabled()
    set metadata value "claim_fx_blue_count" of {_p} to 0
    if {_dbg} is true:
        send "[claim-fx] render-foreign p=%name of {_p}% count=%{_count}%" to console
    if {_count} <= 0:
        stop
    set {_r} to claimFxRenderRadius()
    set {_r2} to {_r} * {_r}
    set {_c} to location of {_p}
    set {_w} to "%world of {_p}%"
    set {_px} to x-coordinate of {_p}
    set {_pz} to z-coordinate of {_p}
    # ID en cours d'edition par le joueur : rendu en vert ailleurs, on saute ici.
    set {_editCtx} to claimEditing({_u})
    set {_editId} to ""
    if {_editCtx} is not "":
        if {_editCtx} is not "new":
            set {_editId} to {_editCtx}
    loop integers from 1 to {_count}:
        set {_id} to {claim::fxnear::%{_u}%::id::%loop-value%}
        if {_id} is not set:
            continue
        if claimExists({_id}) is false:
            continue
        if claimOwnerUuid({_id}) is {_u}:
            continue
        if {_editId} is not "":
            if "%{_id}%" is {_editId}:
                continue
        set {_cw} to "%claimWorld({_id})%"
        if {_cw} is not {_w}:
            continue
        if {claim::data::%{_id}%::bbox::minX} is not set:
            claimBuildBBox({_id})
        set {_minX} to {claim::data::%{_id}%::bbox::minX}
        set {_maxX} to {claim::data::%{_id}%::bbox::maxX}
        set {_minZ} to {claim::data::%{_id}%::bbox::minZ}
        set {_maxZ} to {claim::data::%{_id}%::bbox::maxZ}
        if {_px} < {_minX} - {_r} - 2:
            continue
        if {_px} > {_maxX} + {_r} + 2:
            continue
        if {_pz} < {_minZ} - {_r} - 2:
            continue
        if {_pz} > {_maxZ} + {_r} + 2:
            continue
        set {_minY} to {claim::data::%{_id}%::bbox::minY}
        set {_maxY} to {claim::data::%{_id}%::bbox::maxY}
        # Fenetre verticale clampee a +/-6 blocs autour du joueur.
        set {_pY} to floor(y-coordinate of {_p})
        set {_yWin} to 8
        set {_capWin} to 20
        if claimUseY({_id}) is true:
            if {_minY} is set:
                if {_maxY} is set:
                    set {_minYL} to {_minY} - 1
                    set {_maxYL} to {_maxY} + 1
                else:
                    set {_minYL} to {_pY} - 2
                    set {_maxYL} to {_pY} + 7
            else:
                set {_minYL} to {_pY} - 2
                set {_maxYL} to {_pY} + 7
        else:
            set {_minYL} to {_pY} - 2
            set {_maxYL} to {_pY} + 7
        if {_minYL} < {_pY} - {_yWin}:
            set {_minYL} to {_pY} - {_yWin}
        if {_maxYL} > {_pY} + {_yWin}:
            set {_maxYL} to {_pY} + {_yWin}

        set {_per} to 2 * (({_maxX} - {_minX}) + ({_maxZ} - {_minZ})) + 4
        if {_per} < 8:
            set {_per} to 8
        set {_budget} to claimFxLineBudget()
        if {_budget} > 110:
            set {_budget} to 110
        set {_edgeStep} to ceil({_per} / {_budget})
        if {_edgeStep} < 1:
            set {_edgeStep} to 1

        set {_isPoly} to false
        if claimMode({_id}) is "poly":
            set {_isPoly} to true
        set {_yL} to {_minYL}
        while {_yL} <= {_maxYL}:
            if {_isPoly} is true:
                claimRenderSavedPolyLineFx({_p}, {_id}, {_yL}, {_c}, {_r2}, true, {_edgeStep}, true)
            else:
                claimRenderSavedRectLineFx({_p}, {_id}, {_yL}, {_c}, {_r2}, true, {_edgeStep}, true)
            add 1 to {_yL}

        # Sol + plafond (faces horizontales) si useY est active
        if claimUseY({_id}) is true:
            if {_minY} is set:
                if {_maxY} is set:
                    set {_floorY} to {_minY} - 1
                    set {_ceilY} to {_maxY} + 1
                    if {_floorY} >= {_pY} - {_capWin}:
                        if {_floorY} <= {_pY} + {_capWin}:
                            if {_isPoly} is true:
                                claimRenderFaceSavedPolyAtY({_p}, {_c}, {_id}, {_floorY}, {_r2}, {_r}, true)
                            else:
                                claimRenderFaceRectAtY({_p}, {_c}, {_floorY}, {_minX}, {_maxX}, {_minZ}, {_maxZ}, {_r2}, {_r}, true, false)
                    if {_ceilY} >= {_pY} - {_capWin}:
                        if {_ceilY} <= {_pY} + {_capWin}:
                            if {_isPoly} is true:
                                claimRenderFaceSavedPolyAtY({_p}, {_c}, {_id}, {_ceilY}, {_r2}, {_r}, true)
                            else:
                                claimRenderFaceRectAtY({_p}, {_c}, {_ceilY}, {_minX}, {_maxX}, {_minZ}, {_maxZ}, {_r2}, {_r}, true, false)
    set {_drew} to metadata value "claim_fx_blue_count" of {_p}
    if {_dbg} is true:
        send "[claim-fx] emitted blue p=%name of {_p}% drew=%{_drew}%" to console

function claimFxVisible(center: location, x: number, z: number, radiusSq: number) :: boolean:
    set {_dx} to {_x} + 0.5 - x-coordinate of {_center}
    set {_dz} to {_z} + 0.5 - z-coordinate of {_center}
    set {_d2} to {_dx} * {_dx} + {_dz} * {_dz}
    if {_d2} > {_radiusSq}:
        return false
    return true

function claimFxPassesFaceSampling() :: boolean:
    set {_density} to claimFxFaceDensityPercent()
    if {_density} >= 100:
        return true
    set {_roll} to random integer between 1 and 100
    if {_roll} <= {_density}:
        return true
    return false

function claimFxEnsureCache(uuid: text):
    if {claim::fxcache::%{_uuid}%::dirty} is not true:
        if {claim::fxcache::%{_uuid}%::edge::count} is set:
            stop
    delete {claim::fxcache::%{_uuid}%::edge::*}
    delete {claim::fxcache::%{_uuid}%::corner::*}
    set {claim::fxcache::%{_uuid}%::edge::count} to 0
    set {claim::fxcache::%{_uuid}%::corner::count} to 0
    set {_mode} to claimSelMode({_uuid})
    set {claim::fxcache::%{_uuid}%::mode} to {_mode}
    set {claim::fxcache::%{_uuid}%::usey} to claimSelUseY({_uuid})
    if {_mode} is "rect":
        if claimSelHasRect({_uuid}) is false:
            stop
        set {_a} to {claim::sel::%{_uuid}%::rect::1}
        set {_b} to {claim::sel::%{_uuid}%::rect::2}
        if {_a} is not set:
            stop
        if {_b} is not set:
            stop
        set {claim::fxcache::%{_uuid}%::world} to "%world of {_a}%"
        set {_minX} to floor(min(x-coordinate of {_a}, x-coordinate of {_b}))
        set {_maxX} to floor(max(x-coordinate of {_a}, x-coordinate of {_b}))
        set {_minZ} to floor(min(z-coordinate of {_a}, z-coordinate of {_b}))
        set {_maxZ} to floor(max(z-coordinate of {_a}, z-coordinate of {_b}))
        set {claim::fxcache::%{_uuid}%::minX} to {_minX}
        set {claim::fxcache::%{_uuid}%::maxX} to {_maxX}
        set {claim::fxcache::%{_uuid}%::minZ} to {_minZ}
        set {claim::fxcache::%{_uuid}%::maxZ} to {_maxZ}
        set {claim::fxcache::%{_uuid}%::minY} to floor(min(y-coordinate of {_a}, y-coordinate of {_b}))
        set {claim::fxcache::%{_uuid}%::maxY} to floor(max(y-coordinate of {_a}, y-coordinate of {_b}))
        set {_maxPts} to claimFxCacheMaxPoints()
        set {_per} to 2 * (({_maxX} - {_minX}) + ({_maxZ} - {_minZ})) + 4
        set {_cacheStep} to 1
        if {_per} > {_maxPts}:
            set {_cacheStep} to ceil({_per} / {_maxPts})
        if {_cacheStep} < 1:
            set {_cacheStep} to 1
        set {_ec} to 0
        set {_x} to {_minX}
        while {_x} <= {_maxX}:
            add 1 to {_ec}
            set {claim::fxcache::%{_uuid}%::edge::%{_ec}%} to "%{_x}% %{_minZ}%"
            if {_maxZ} is not {_minZ}:
                add 1 to {_ec}
                set {claim::fxcache::%{_uuid}%::edge::%{_ec}%} to "%{_x}% %{_maxZ}%"
            add {_cacheStep} to {_x}
        set {_z} to {_minZ} + {_cacheStep}
        while {_z} <= {_maxZ} - {_cacheStep}:
            add 1 to {_ec}
            set {claim::fxcache::%{_uuid}%::edge::%{_ec}%} to "%{_minX}% %{_z}%"
            if {_maxX} is not {_minX}:
                add 1 to {_ec}
                set {claim::fxcache::%{_uuid}%::edge::%{_ec}%} to "%{_maxX}% %{_z}%"
            add {_cacheStep} to {_z}
        set {claim::fxcache::%{_uuid}%::edge::count} to {_ec}
        set {claim::fxcache::%{_uuid}%::corner::count} to 4
        set {claim::fxcache::%{_uuid}%::corner::1} to "%{_minX}% %{_minZ}%"
        set {claim::fxcache::%{_uuid}%::corner::2} to "%{_maxX}% %{_minZ}%"
        set {claim::fxcache::%{_uuid}%::corner::3} to "%{_maxX}% %{_maxZ}%"
        set {claim::fxcache::%{_uuid}%::corner::4} to "%{_minX}% %{_maxZ}%"
    else:
        set {_n} to claimSelPolyCount({_uuid})
        if {_n} < 2:
            stop
        set {_v1} to {claim::sel::%{_uuid}%::poly::1}
        if {_v1} is not set:
            stop
        set {claim::fxcache::%{_uuid}%::world} to "%world of {_v1}%"
        set {_minX} to floor(x-coordinate of {_v1})
        set {_maxX} to floor(x-coordinate of {_v1})
        set {_minZ} to floor(z-coordinate of {_v1})
        set {_maxZ} to floor(z-coordinate of {_v1})
        set {_minY} to floor(y-coordinate of {_v1})
        set {_maxY} to floor(y-coordinate of {_v1})
        set {_ec} to 0
        set {_cc} to 0
        set {_maxPts} to claimFxCacheMaxPoints()
        set {_edgeBudget} to floor({_maxPts} / {_n})
        if {_edgeBudget} < 1:
            set {_edgeBudget} to 1
        set {_i} to 1
        while {_i} <= {_n}:
            set {_va} to {claim::sel::%{_uuid}%::poly::%{_i}%}
            set {_j} to {_i} + 1
            if {_j} > {_n}:
                set {_j} to 1
            set {_vb} to {claim::sel::%{_uuid}%::poly::%{_j}%}
            if {_va} is set:
                if x-coordinate of {_va} < {_minX}:
                    set {_minX} to floor(x-coordinate of {_va})
                if x-coordinate of {_va} > {_maxX}:
                    set {_maxX} to floor(x-coordinate of {_va})
                if z-coordinate of {_va} < {_minZ}:
                    set {_minZ} to floor(z-coordinate of {_va})
                if z-coordinate of {_va} > {_maxZ}:
                    set {_maxZ} to floor(z-coordinate of {_va})
                if y-coordinate of {_va} < {_minY}:
                    set {_minY} to floor(y-coordinate of {_va})
                if y-coordinate of {_va} > {_maxY}:
                    set {_maxY} to floor(y-coordinate of {_va})
                set {_cx} to floor(x-coordinate of {_va})
                set {_cz} to floor(z-coordinate of {_va})
                add 1 to {_cc}
                set {claim::fxcache::%{_uuid}%::corner::%{_cc}%} to "%{_cx}% %{_cz}%"
            if {_va} is set:
                if {_vb} is set:
                    set {_x1} to floor(x-coordinate of {_va})
                    set {_z1} to floor(z-coordinate of {_va})
                    set {_x2} to floor(x-coordinate of {_vb})
                    set {_z2} to floor(z-coordinate of {_vb})
                    set {_dx} to abs({_x2} - {_x1})
                    set {_dz} to abs({_z2} - {_z1})
                    set {_steps} to {_dx}
                    if {_dz} > {_steps}:
                        set {_steps} to {_dz}
                    if {_steps} < 1:
                        set {_steps} to 1
                    set {_sampleStep} to ceil({_steps} / {_edgeBudget})
                    if {_sampleStep} < 1:
                        set {_sampleStep} to 1
                    set {_k} to 0
                    while {_k} <= {_steps}:
                        set {_ex} to round({_x1} + ({_x2} - {_x1}) * {_k} / {_steps})
                        set {_ez} to round({_z1} + ({_z2} - {_z1}) * {_k} / {_steps})
                        set {_key} to "%{_ex}% %{_ez}%"
                        if {_seen::%{_key}%} is not set:
                            set {_seen::%{_key}%} to true
                            add 1 to {_ec}
                            set {claim::fxcache::%{_uuid}%::edge::%{_ec}%} to {_key}
                            if {_ec} >= {_maxPts}:
                                set {_k} to {_steps} + 1
                        add {_sampleStep} to {_k}
            add 1 to {_i}
        set {claim::fxcache::%{_uuid}%::edge::count} to {_ec}
        set {claim::fxcache::%{_uuid}%::corner::count} to {_cc}
        set {claim::fxcache::%{_uuid}%::minX} to {_minX}
        set {claim::fxcache::%{_uuid}%::maxX} to {_maxX}
        set {claim::fxcache::%{_uuid}%::minZ} to {_minZ}
        set {claim::fxcache::%{_uuid}%::maxZ} to {_maxZ}
        set {claim::fxcache::%{_uuid}%::minY} to {_minY}
        set {claim::fxcache::%{_uuid}%::maxY} to {_maxY}
    set {claim::fxcache::%{_uuid}%::dirty} to false

function claimRenderHeldWand(p: player):
    set {_u} to uuid of {_p}
    if claimIsWand(tool of {_p}) is false:
        # Hache pas en main : on memorise l'etat (metadata, pas de DB).
        set metadata value "claim_fx_wand_held" of {_p} to false
        stop
    # Transition "pas en main -> en main" : on invalide le cache marqueurs
    # pour rechecker les blocs voisins (faces visibles / non visibles).
    if metadata value "claim_fx_wand_held" of {_p} is not true:
        set metadata value "claim_fx_wand_held" of {_p} to true
        claimFxCacheMarkDirty({_u})
        # Reset throttle marqueurs pour rendu rapide apres la reprise.
        delete metadata value "claim_fx_marker_last" of {_p}
    if claimFxCanRenderNow({_p}) is false:
        stop
    set {_frame} to claimFxNextFrame({_p})
    claimRenderSelMarkers({_p})
    if claimSelHasRegion({_u}) is false:
        claimRenderOwnedClaimsFx({_p}, {_frame})
        claimRenderForeignClaimsFx({_p}, {_frame})
        stop
    claimFxEnsureCache({_u})
    set {_ec} to {claim::fxcache::%{_u}%::edge::count} ? 0
    if {_ec} <= 0:
        stop
    if "%world of {_p}%" is not {claim::fxcache::%{_u}%::world}:
        stop
    set {_r} to claimFxRenderRadius()
    set {_r2} to {_r} * {_r}
    set {_c} to location of {_p}
    if claimSelUseY({_u}) is true:
        set {_minY} to {claim::fxcache::%{_u}%::minY} - 1
        set {_maxY} to {claim::fxcache::%{_u}%::maxY} + 1
    else:
        set {_minY} to floor(y-coordinate of {_p}) - 2
        set {_maxY} to floor(y-coordinate of {_p}) + 7
    # Affichage statique : on rend toutes les lignes Y dans la fenetre
    # visible autour du joueur (clamp au rayon de rendu pour borner le cout
    # quand useY est active sur de gros claims).
    set {_pY} to floor(y-coordinate of {_p})
    set {_yWin} to 8
    set {_capWin} to 20
    set {_minYL} to {_minY}
    set {_maxYL} to {_maxY}
    if {_minYL} < {_pY} - {_yWin}:
        set {_minYL} to {_pY} - {_yWin}
    if {_maxYL} > {_pY} + {_yWin}:
        set {_maxYL} to {_pY} + {_yWin}
    if {_minYL} > {_maxYL}:
        stop
    set {_forward} to true

    # ====================================================================
    #  Mode RECT : on bypass le cache (decimation des points sur grandes
    #  zones) et on dessine directement avec pas=1 sur la fenetre visible
    #  autour du joueur. Cout borne, densite max. Toutes les lignes Y sont
    #  rendues d'un coup pour un mur "plein".
    # ====================================================================
    if {claim::fxcache::%{_u}%::mode} is "rect":
        set {_minX} to {claim::fxcache::%{_u}%::minX}
        set {_maxX} to {claim::fxcache::%{_u}%::maxX}
        set {_minZ} to {claim::fxcache::%{_u}%::minZ}
        set {_maxZ} to {claim::fxcache::%{_u}%::maxZ}
        set {_rng} to ceil({_r}) + 2
        set {_px} to floor(x-coordinate of {_c})
        set {_pz} to floor(z-coordinate of {_c})
        set {_xLo} to {_px} - {_rng}
        set {_xHi} to {_px} + {_rng}
        if {_xLo} < {_minX}:
            set {_xLo} to {_minX}
        if {_xHi} > {_maxX}:
            set {_xHi} to {_maxX}
        set {_zLo} to {_pz} - {_rng}
        set {_zHi} to {_pz} + {_rng}
        if {_zLo} < {_minZ}:
            set {_zLo} to {_minZ}
        if {_zHi} > {_maxZ}:
            set {_zHi} to {_maxZ}
        set {_dzMin} to {_pz} - {_minZ}
        if {_dzMin} < 0:
            set {_dzMin} to 0 - {_dzMin}
        set {_dzMax} to {_pz} - {_maxZ}
        if {_dzMax} < 0:
            set {_dzMax} to 0 - {_dzMax}
        set {_dxMin} to {_px} - {_minX}
        if {_dxMin} < 0:
            set {_dxMin} to 0 - {_dxMin}
        set {_dxMax} to {_px} - {_maxX}
        if {_dxMax} < 0:
            set {_dxMax} to 0 - {_dxMax}
        set {_yL} to {_minYL}
        while {_yL} <= {_maxYL}:
            if {_dzMin} <= {_rng}:
                set {_x} to {_xLo}
                while {_x} <= {_xHi}:
                    if claimFxVisible({_c}, {_x}, {_minZ}, {_r2}) is true:
                        claimFxSweepParticleAt({_p}, {_x}, {_yL}, {_minZ})
                    add 1 to {_x}
            if {_maxZ} is not {_minZ}:
                if {_dzMax} <= {_rng}:
                    set {_x} to {_xLo}
                    while {_x} <= {_xHi}:
                        if claimFxVisible({_c}, {_x}, {_maxZ}, {_r2}) is true:
                            claimFxSweepParticleAt({_p}, {_x}, {_yL}, {_maxZ})
                        add 1 to {_x}
            if {_dxMin} <= {_rng}:
                set {_z} to {_zLo}
                while {_z} <= {_zHi}:
                    if claimFxVisible({_c}, {_minX}, {_z}, {_r2}) is true:
                        claimFxSweepParticleAt({_p}, {_minX}, {_yL}, {_z})
                    add 1 to {_z}
            if {_maxX} is not {_minX}:
                if {_dxMax} <= {_rng}:
                    set {_z} to {_zLo}
                    while {_z} <= {_zHi}:
                        if claimFxVisible({_c}, {_maxX}, {_z}, {_r2}) is true:
                            claimFxSweepParticleAt({_p}, {_maxX}, {_yL}, {_z})
                        add 1 to {_z}
            # Coins pour cette ligne Y
            if claimFxVisible({_c}, {_minX}, {_minZ}, {_r2}) is true:
                claimFxCornerParticleAt({_p}, {_minX}, {_yL}, {_minZ})
            if claimFxVisible({_c}, {_maxX}, {_minZ}, {_r2}) is true:
                claimFxCornerParticleAt({_p}, {_maxX}, {_yL}, {_minZ})
            if claimFxVisible({_c}, {_maxX}, {_maxZ}, {_r2}) is true:
                claimFxCornerParticleAt({_p}, {_maxX}, {_yL}, {_maxZ})
            if claimFxVisible({_c}, {_minX}, {_maxZ}, {_r2}) is true:
                claimFxCornerParticleAt({_p}, {_minX}, {_yL}, {_maxZ})
            add 1 to {_yL}
        # Sol + plafond (faces horizontales) si useY est active
        if claimSelUseY({_u}) is true:
            if {_minY} >= {_pY} - {_capWin}:
                if {_minY} <= {_pY} + {_capWin}:
                    claimRenderFaceRectAtY({_p}, {_c}, {_minY}, {_minX}, {_maxX}, {_minZ}, {_maxZ}, {_r2}, {_r}, false, true)
            if {_maxY} >= {_pY} - {_capWin}:
                if {_maxY} <= {_pY} + {_capWin}:
                    claimRenderFaceRectAtY({_p}, {_c}, {_maxY}, {_minX}, {_maxX}, {_minZ}, {_maxZ}, {_r2}, {_r}, false, true)
        # Claims sauves egalement.
        claimRenderOwnedClaimsFx({_p}, {_frame})
        claimRenderForeignClaimsFx({_p}, {_frame})
        stop

    # Budget par frame pour ne pas tout spawner d'un coup (mode poly).
    # ====================================================================
    #  Mode POLY : on bypass le cache (decimation des points par budget)
    #  et on dessine directement chaque segment a densite constante avec
    #  fenetre player-centree. Densite ~"dens" particules par bloc Euclidien
    #  identique sur petit ou grand segment, axis-aligned ou diagonal.
    # ====================================================================
    set {_n} to claimSelPolyCount({_u})
    if {_n} >= 2:
        set {_dens} to 1.4
        set {_R} to {_r} + 2
        set {_pxC} to x-coordinate of {_c}
        set {_pzC} to z-coordinate of {_c}
        set {_yL} to {_minYL}
        while {_yL} <= {_maxYL}:
            set {_i} to 1
            while {_i} <= {_n}:
                set {_j} to {_i} + 1
                if {_j} > {_n}:
                    set {_j} to 1
                set {_va} to {claim::sel::%{_u}%::poly::%{_i}%}
                set {_vb} to {claim::sel::%{_u}%::poly::%{_j}%}
                if {_va} is set:
                    if {_vb} is set:
                        if world of {_va} is world of {_p}:
                            set {_x1} to floor(x-coordinate of {_va})
                            set {_z1} to floor(z-coordinate of {_va})
                            set {_x2} to floor(x-coordinate of {_vb})
                            set {_z2} to floor(z-coordinate of {_vb})
                            set {_vx} to {_x2} - {_x1}
                            set {_vz} to {_z2} - {_z1}
                            set {_vv} to {_vx} * {_vx} + {_vz} * {_vz}
                            if {_vv} > 0:
                                set {_len} to sqrt({_vv})
                                set {_steps} to ceil({_len} * {_dens})
                                if {_steps} < 1:
                                    set {_steps} to 1
                                # Projection player sur AB.
                                set {_wx} to {_pxC} - {_x1} - 0.5
                                set {_wz} to {_pzC} - {_z1} - 0.5
                                set {_t} to ({_wx} * {_vx} + {_wz} * {_vz}) / {_vv}
                                if {_t} < 0:
                                    set {_t} to 0
                                if {_t} > 1:
                                    set {_t} to 1
                                set {_cpDx} to ({_x1} + {_t} * {_vx} + 0.5) - {_pxC}
                                set {_cpDz} to ({_z1} + {_t} * {_vz} + 0.5) - {_pzC}
                                set {_segD2} to {_cpDx} * {_cpDx} + {_cpDz} * {_cpDz}
                                if {_segD2} <= {_r2}:
                                    set {_tWin} to {_R} / {_len}
                                    if {_tWin} > 1:
                                        set {_tWin} to 1
                                    set {_tLo} to {_t} - {_tWin}
                                    set {_tHi} to {_t} + {_tWin}
                                    if {_tLo} < 0:
                                        set {_tLo} to 0
                                    if {_tHi} > 1:
                                        set {_tHi} to 1
                                    set {_kLo} to floor({_tLo} * {_steps})
                                    set {_kHi} to ceil({_tHi} * {_steps})
                                    if {_kLo} < 0:
                                        set {_kLo} to 0
                                    if {_kHi} > {_steps}:
                                        set {_kHi} to {_steps}
                                    set {_k} to {_kLo}
                                    while {_k} <= {_kHi}:
                                        set {_xk} to round({_x1} + {_vx} * {_k} / {_steps})
                                        set {_zk} to round({_z1} + {_vz} * {_k} / {_steps})
                                        if claimFxVisible({_c}, {_xk}, {_zk}, {_r2}) is true:
                                            claimFxSweepParticleAt({_p}, {_xk}, {_yL}, {_zk})
                                        add 1 to {_k}
                            # Coin (sommet A) si visible.
                            if claimFxVisible({_c}, {_x1}, {_z1}, {_r2}) is true:
                                claimFxCornerParticleAt({_p}, {_x1}, {_yL}, {_z1})
                add 1 to {_i}
            add 1 to {_yL}
        # Sol + plafond (faces horizontales) si useY est active
        if claimSelUseY({_u}) is true:
            if {_minY} >= {_pY} - {_capWin}:
                if {_minY} <= {_pY} + {_capWin}:
                    claimRenderFaceSelPolyAtY({_p}, {_c}, {_u}, {_minY}, {_r2}, {_r})
            if {_maxY} >= {_pY} - {_capWin}:
                if {_maxY} <= {_pY} + {_capWin}:
                    claimRenderFaceSelPolyAtY({_p}, {_c}, {_u}, {_maxY}, {_r2}, {_r})

    # Afficher aussi les claims deja sauves du joueur (en vert).
    claimRenderOwnedClaimsFx({_p}, {_frame})
    claimRenderForeignClaimsFx({_p}, {_frame})

function claimFxAmbientMinInterval() :: timespan:
    return 220 milliseconds

function claimFxAmbientCanRenderNow(p: player) :: boolean:
    if metadata value "claim_fx_ambient_last" of {_p} is set:
        set {_elapsed} to difference between metadata value "claim_fx_ambient_last" of {_p} and now
        if {_elapsed} is less than claimFxAmbientMinInterval():
            return false
    set metadata value "claim_fx_ambient_last" of {_p} to now
    return true

every {@scan_period}:
    set {_t0} to now
    loop all players:
        claimUpdatePlayerArea(loop-player)
        claimRenderHeldWand(loop-player)
        claimActionBarTick(loop-player)
    set {_dt} to difference between {_t0} and now
    if {_dt} > 35 milliseconds:
        if claimFxPerfEnabled() is true:
            send "[claim-fx] tick slow dt=%{_dt}%" to console

# ============================================================
#  Wand: single copy enforcement (drop = destruction)
# ============================================================

# Detruire toute copie supplementaire (par securite: dupe via plugin tiers)
function claimEnforceSingleWand(p: player):
    set {_seen} to false
    loop integers from 0 to 40:
        set {_it} to slot loop-value of {_p}'s inventory
        if claimIsWand({_it}) is true:
            if {_seen} is true:
                set slot loop-value of {_p}'s inventory to air
            else:
                set {_seen} to true

# Detecte si l'inventaire ouvert est "etranger" au joueur (coffre, ender,
# shulker, hopper, etc.). Si oui, toute interaction wand le detruit.
function claimIsForeignInv(p: player, inv: inventory) :: boolean:
    set {_t} to "%type of {_inv}%" in lower case
    if {_t} contains "player":
        return false
    if {_t} contains "crafting":
        return false
    if {_t} contains "creative":
        return false
    return true

function claimInvIsPlayer(inv: inventory) :: boolean:
    set {_t} to "%type of {_inv}%" in lower case
    if {_t} contains "player":
        return true
    if {_t} contains "crafting":
        return true
    if {_t} contains "creative":
        return true
    return false

function claimInvIsCrafting(inv: inventory) :: boolean:
    set {_t} to "%type of {_inv}%" in lower case
    if {_t} contains "crafting":
        return true
    return false

on drop:
    if claimIsWand(event-item) is true:
        # On laisse le drop se produire (pas de rollback inventaire),
        # puis on supprime l'entite item au sol immediatement.
        delete dropped item
        claimDestroyAllWands(player)
        claimSendPriorityActionBar(player, "&cHache detruite.")
        play sound "minecraft:block.glass.break" with volume 0.6 with pitch 1.4 to player

# Regle: la wand doit rester dans l'inventaire joueur.
# - Deplacement interne inventaire joueur: autorise.
# - Tentative vers inventaire etranger: detruite.
# - Recuperation depuis un coffre vers joueur: autorisee.
on inventory click:
    set {_top} to player's current inventory
    set {_foreignByCurrent} to claimIsForeignInv(player, {_top})
    set {_foreignByEventInv} to claimIsForeignInv(player, event-inventory)
    set {_shift} to false
    set {_ct} to "%click type%" in upper case
    set {_act} to "%inventory action%" in upper case
    if {_ct} contains "SHIFT":
        set {_shift} to true
    if {_act} contains "MOVE_TO_OTHER_INVENTORY":
        set {_shift} to true
    set {_cur} to event-item
    set {_cursor} to cursor slot of player
    set {_isWand} to false
    set {_clickedPlayerInv} to claimInvIsPlayer(clicked inventory)
    set {_clickedCraftingInv} to claimInvIsCrafting(clicked inventory)

    # Interdiction du craft/reparation avec la Claim Wand dans la grille 2x2
    # de l'inventaire joueur. Sinon une wand peut servir d'ingredient pour
    # reforger une hache d'or normale.
    if {_clickedCraftingInv} is true:
        if claimIsWand({_cur}) is true:
            cancel event
            claimSendPriorityActionBar(player, "&eLa Claim Wand ne peut pas servir d'ingrédient de craft.")
            play sound "minecraft:block.note_block.bass" with volume 0.5 with pitch 1.0 to player
            stop
        if claimIsWand({_cursor}) is true:
            cancel event
            claimSendPriorityActionBar(player, "&eLa Claim Wand ne peut pas servir d'ingrédient de craft.")
            play sound "minecraft:block.note_block.bass" with volume 0.5 with pitch 1.0 to player
            stop

    # Shift-click avec wand depuis l'inventaire joueur => toujours bloque.
    if {_shift} is true:
        if {_clickedPlayerInv} is true:
            if claimIsWand({_cur}) is true:
                cancel event
                claimSendPriorityActionBar(player, "&eLa Claim Wand doit rester dans ton inventaire.")
                play sound "minecraft:block.note_block.bass" with volume 0.5 with pitch 1.0 to player
                stop

    # Tentative de poser la wand (tenue au curseur) dans un inventaire etranger => destruction.
    if {_clickedPlayerInv} is false:
        if claimIsWand({_cursor}) is true:
            cancel event
            claimDestroyAllWands(player)
            claimSendPriorityActionBar(player, "&cHache detruite.")
            play sound "minecraft:block.glass.break" with volume 0.6 with pitch 1.4 to player
            stop
        if claimIsWand({_cur}) is true:
            cancel event
            claimDestroyAllWands(player)
            claimSendPriorityActionBar(player, "&cHache detruite.")
            play sound "minecraft:block.glass.break" with volume 0.6 with pitch 1.4 to player
            stop

    # Sinon: autorise (inclut recuperer wand du coffre vers inventaire joueur).
    stop

on inventory drag:
    set {_top} to player's current inventory
    if claimInvIsCrafting({_top}) is true:
        if claimIsWand(event-item) is true:
            cancel event
            claimSendPriorityActionBar(player, "&eLa Claim Wand ne peut pas servir d'ingrédient de craft.")
            play sound "minecraft:block.note_block.bass" with volume 0.5 with pitch 1.0 to player
            stop
    if claimIsForeignInv(player, {_top}) is false:
        stop
    if claimIsWand(event-item) is false:
        stop
    cancel event
    claimDestroyAllWands(player)
    claimSendPriorityActionBar(player, "&cHache detruite.")
    play sound "minecraft:block.glass.break" with volume 0.6 with pitch 1.4 to player

# Protection item frames (normal + glow): depot interdit, wand detruite.
# Verifie main + seconde main (la wand peut etre posee depuis l'off-hand).
on right click on item frame:
    if claimIsWand(tool of player) is false:
        if claimIsWand(off hand tool of player) is false:
            stop
    cancel event
    claimDestroyAllWands(player)
    claimSendPriorityActionBar(player, "&cHache detruite.")
    play sound "minecraft:block.glass.break" with volume 0.6 with pitch 1.4 to player

on right click on glow item frame:
    if claimIsWand(tool of player) is false:
        if claimIsWand(off hand tool of player) is false:
            stop
    cancel event
    claimDestroyAllWands(player)
    claimSendPriorityActionBar(player, "&cHache detruite.")
    play sound "minecraft:block.glass.break" with volume 0.6 with pitch 1.4 to player

# Blocs de type "shelf" (chiseled bookshelf, etc.): le clic droit
# declenche une interaction (rangement de livre) qui pouvait conduire
# a la destruction de la wand par les autres regles. Si la wand est en
# main, on cancel l'interaction et on laisse le handler de wand normal
# faire son travail (selection pos2). Pas de destruction.
on right click:
    event-block is set
    if claimIsWand(tool of player) is false:
        if claimIsWand(off hand tool of player) is false:
            stop
    set {_b} to "%type of event-block%" in lower case
    set {_id} to "%event-block%" in lower case
    if {_b} does not contain "shelf":
        if {_id} does not contain "shelf":
            stop
    cancel event

# La wand est un outil de selection, pas une arme.
# Exception : taper un joueur avec la wand = retirer le joueur du claim
# courant (sans confirmation, conformement aux specs).
on damage:
    if attacker is not a player:
        stop
    if claimIsWand(tool of attacker) is false:
        stop
    cancel event
    if victim is a player:
        claimWandKickEntity(attacker, victim)
        stop
    claimSendPriorityActionBar(attacker, "&eLa Claim Wand ne peut pas servir a taper.")
    play sound "minecraft:block.note_block.bass" with volume 0.4 with pitch 0.9 to attacker

# Clic droit sur un joueur avec la wand : invite / promotion / transfert.
on right click on player:
    if claimIsWand(tool of player) is false:
        stop
    cancel event
    if claimCanEditClaims(player) is false:
        claimSendPriorityActionBar(player, "&cLes claims joueurs sont actuellement desactives.")
        stop
    if claimWandClickAllowed(player) is false:
        stop
    if player is sneaking:
        claimWandTransferEntity(player, event-entity)
        stop
    claimWandInviteEntity(player, event-entity)

# Si la hache se retrouve au sol (mort, despawn d'item, etc.), on la supprime.
on item spawn:
    if event-entity is a dropped item:
        if claimIsWand(item of event-entity) is true:
            delete event-entity

# ============================================================
#  Hooks de selection (wand clicks)
# ============================================================

on left click:
    if claimIsWand(tool of player) is false:
        stop
    if claimCanEditClaims(player) is false:
        claimSendPriorityActionBar(player, "&cLes claims joueurs sont actuellement desactives.")
        stop
    if claimWandClickAllowed(player) is false:
        cancel event
        stop
    cancel event
    set {_u} to uuid of player
    set {_b} to event-block
    if {_b} is not set:
        if player is sneaking:
            if claimSelMode({_u}) is "poly":
                claimSelClear({_u})
                play sound "minecraft:block.note_block.bass" with volume 0.7 with pitch 0.8 to player
                claimSendPriorityActionBar(player, "&c&lPolygone vide")
            else:
                claimSelClear({_u})
                play sound "minecraft:block.note_block.bass" with volume 0.7 with pitch 0.8 to player
                claimSendPriorityActionBar(player, "&c&lSelection rectangle vide")
        stop
    if claimSelMode({_u}) is "poly":
        set {_ok} to claimSelPolyAdd({_u}, location of {_b}, claimMaxVerticesFor(player))
        if {_ok} is true:
            play sound "minecraft:block.note_block.pling" with volume 0.6 with pitch 1.5 to player
            claimSendPriorityActionBar(player, "&a&lPoint #%claimSelPolyCount({_u})% &7&l(&f%x-coordinate of {_b}%&8,&f%y-coordinate of {_b}%&8,&f%z-coordinate of {_b}%&7&l)")
        else:
            claimSendPriorityActionBar(player, "&eSommet recadre / limite atteinte &7(&f%claimSelPolyCount({_u})% &7sommets)")
        stop
    set {claim::sel::%{_u}%::rect::1} to location of {_b}
    claimFxCacheMarkDirty({_u})
    play sound "minecraft:block.note_block.pling" with volume 0.6 with pitch 1.6 to player
    claimSendPriorityActionBar(player, "&a&lPos1 &7(&f%x-coordinate of {_b}%&8,&f%y-coordinate of {_b}%&8,&f%z-coordinate of {_b}%&7)")

on right click:
    if claimIsWand(tool of player) is false:
        stop
    if claimCanEditClaims(player) is false:
        claimSendPriorityActionBar(player, "&cLes claims joueurs sont actuellement desactives.")
        stop
    if claimWandClickAllowed(player) is false:
        cancel event
        stop
    cancel event
    set {_u} to uuid of player
    set {_b} to event-block
    if {_b} is not set:
        if player is sneaking:
            if claimSelMode({_u}) is "poly":
                delete {claim::sel::%{_u}%::mode}
                # On efface l'ancienne selection poly pour ne pas garder
                # de particules fantomes apres bascule de mode.
                delete {claim::sel::%{_u}%::poly::*}
                delete {claim::sel::%{_u}%::poly::count}
                claimFxCacheMarkDirty({_u})
                send "{@prefix}&aMode selection: &erectangulaire &7(2 coins)" to player
            else:
                set {claim::sel::%{_u}%::mode} to "poly"
                # On efface l'ancienne selection rect (pos1/pos2) pour ne
                # pas garder de marqueurs fantomes en mode poly.
                delete {claim::sel::%{_u}%::rect::1}
                delete {claim::sel::%{_u}%::rect::2}
                claimFxCacheMarkDirty({_u})
                send "{@prefix}&aMode selection: &epolygone" to player
                send "{@prefix}&7Clic gauche bloc = ajouter &8| &7Clic droit bloc = retirer &8| &7Sneak + clic gauche air = vider" to player
            play sound "minecraft:block.note_block.pling" with volume 0.6 with pitch 1.0 to player
        stop
    if claimSelMode({_u}) is "poly":
        if claimSelPolyRemoveLast({_u}) is true:
            play sound "minecraft:block.note_block.bass" with volume 0.5 with pitch 1.2 to player
            claimSendPriorityActionBar(player, "&e&lSommet retire &7(reste &f%claimSelPolyCount({_u})%&7)")
        else:
            claimSendPriorityActionBar(player, "&cAucun sommet a retirer.")
        stop
    set {claim::sel::%{_u}%::rect::2} to location of {_b}
    claimFxCacheMarkDirty({_u})
    play sound "minecraft:block.note_block.pling" with volume 0.6 with pitch 1.8 to player
    claimSendPriorityActionBar(player, "&b&lPos2 &7(&f%x-coordinate of {_b}%&8,&f%y-coordinate of {_b}%&8,&f%z-coordinate of {_b}%&7)")

# ============================================================
#  Nettoyage joueur
# ============================================================

on quit:
    delete metadata value "claim_current" of player
    delete metadata value "claim_current_list" of player
    delete metadata value "claim_last_title" of player
    delete metadata value "claim_fx_last" of player
    delete metadata value "claim_fx_frame" of player
    delete metadata value "claim_fx_ambient_last" of player
    delete metadata value "claim_fx_foreign_cache_at" of player
    delete metadata value "claim_fx_foreign_cursor" of player
    delete metadata value "claim_ab_pause_at" of player
    delete metadata value "claim_wand_click_last" of player
    delete {claim::titlecd::%uuid of player%::*}
    claimFxCacheClear(uuid of player)
    delete {claim::fxnear::%uuid of player%::*}

on join:
    # Pre-amorce l'etat de zone : si le joueur se reconnecte deja a l'interieur
    # d'un claim, on initialise claim_current + claim_current_list pour que la
    # premiere passe de claimUpdatePlayerArea voie prev == cur et n'affiche
    # AUCUN titre d'entree a la connexion.
    set {_loc} to location of player
    set {_cur} to claimAtLocation({_loc})
    set metadata value "claim_current" of player to {_cur}
    set metadata value "claim_current_list" of player to claimsContainingLocation({_loc})
    # Nettoyage securitaire de doublons de wand
    claimEnforceSingleWand(player)

on load:
    # Cache FX runtime-only: le vider au reload evite d'empiler des milliers
    # d'entrees persistantes inutiles dans la DB variables Skript.
    delete {claim::fxcache::*}
    delete {claim::fxnear::*}
    delete {claim::fxframe::*}
    # Index spatial : transient (DB pattern claim::index::.* en `disabled`
    # cote config.sk). On le reconstruit en memoire au demarrage : aucune
    # ecriture disque genere (-> plus de warning "Cannot write variables..."
    # quand on save un gros claim). Idem pour les bbox.
    delete {claim::index::*}
    set {_max} to {claim::id::counter} ? 0
    set {_i} to 1
    while {_i} <= {_max}:
        if claimExists({_i}) is true:
            claimReindex({_i})
        add 1 to {_i}

# ============================================================
#  Commandes
# ============================================================

function claimCmdHelp(s: player):
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    send "{@prefix}&a/claim wand &8» &7recuperer la &aClaim Wand" to {_s}
    send "{@prefix}&a/claim create [<nom...>] &8» &7nouveau claim a partir de la selection" to {_s}
    send "{@prefix}&a/claim edit <id|nom> &8» &7editer un claim existant" to {_s}
    send "{@prefix}&a/claim save &8» &7sauvegarder l'edition en cours" to {_s}
    send "{@prefix}&a/claim cancel &8» &7annuler l'edition" to {_s}
    send "{@prefix}&a/claim mode <rect|poly> &8» &7type de selection" to {_s}
    send "{@prefix}&a/claim usey <on|off> &8» &7prendre la hauteur Y en compte" to {_s}
    send "{@prefix}&a/claim expand <up|down|both> <n> &8» &7etendre la selection en hauteur" to {_s}
    send "{@prefix}&a/claim name <texte...> &8» &7definir le nom (titre)" to {_s}
    send "{@prefix}&a/claim description <texte...> &8» &7definir la description (sous-titre)" to {_s}
    send "{@prefix}&a/claim list [<joueur>] &8» &7liste de tes claims (ou autre)" to {_s}
    send "{@prefix}&a/claim info &8» &7info sur le claim a ta position" to {_s}
    send "{@prefix}&a/claim status &8» &7etat de ta selection / capacite" to {_s}
    send "{@prefix}&a/claim delete <id> &8» &7supprimer un de tes claims" to {_s}
    send "{@prefix}&b--- Membres &7(role &boperateur&7+ requis) ---" to {_s}
    send "{@prefix}&b/claim members &8» &7liste des membres du claim sous tes pieds" to {_s}
    send "{@prefix}&b/claim invite <joueur> &8» &7ajouter un membre (clic droit avec la wand)" to {_s}
    send "{@prefix}&b/claim kick <joueur> &8» &7retirer un membre (taper avec la wand)" to {_s}
    send "{@prefix}&b/claim promote <joueur> &8» &7faire monter d'un rang" to {_s}
    send "{@prefix}&b/claim demote <joueur> &8» &7faire descendre d'un rang" to {_s}
    send "{@prefix}&6/claim transfer <joueur> &8» &7proposer la propriete (sneak + clic droit)" to {_s}
    send "{@prefix}&6/claim accept &7/&6 deny &8» &7repondre a une requete de transfert" to {_s}
    send "{@prefix}&6/claim transfer-cancel <joueur> &8» &7annuler une requete en cours" to {_s}
    if {_s} has permission "{@perm}":
        send "{@prefix}&c--- Admin ---" to {_s}
        send "{@prefix}&c/claim admin info [<id>] &8» &7info detaillee sur un claim" to {_s}
        send "{@prefix}&c/claim admin create [<nom...>] &8» &7nouveau claim ADMIN" to {_s}
        send "{@prefix}&c/claim admin delete <id> &8» &7supprime n'importe quel claim" to {_s}
        send "{@prefix}&c/claim admin list [<joueur>] &8» &7lister les claims" to {_s}
        send "{@prefix}&c/claim admin setlimit <joueur> <n> &8» &7definir la limite de claims" to {_s}
        send "{@prefix}&c/claim admin bypass <joueur> <on|off> &8» &7bypass des limites" to {_s}
        send "{@prefix}&c/claim admin claims <on|off> &8» &7autoriser/interdire les claims joueurs" to {_s}
        send "{@prefix}&c/claim admin fxdebug <on|off> &8» &7logs debug des particules" to {_s}
        send "{@prefix}&c/claim admin fxperf <on|off> &8» &7logs perf (ticks lents)" to {_s}
        send "{@prefix}&c/claim admin maxarea <n> &8» &7aire max par claim" to {_s}
        send "{@prefix}&c/claim admin maxtotal <n> &8» &7aire totale max par joueur" to {_s}
        send "{@prefix}&c/claim admin maxvertices <n> &8» &7sommets max en mode poly" to {_s}
        send "{@prefix}&c/claim admin defaultlimit <n> &8» &7limite par defaut" to {_s}
        send "{@prefix}&c/claim admin reset &8» &7tout supprimer (DANGER)" to {_s}
        send "{@prefix}&c--- Gestion d'un claim ---" to {_s}
        send "{@prefix}&c/claim admin manage [<id>] &8» &7info + membres (claim sous les pieds ou <id>)" to {_s}
        send "{@prefix}&c/claim admin tp <id> &8» &7se teleporter au claim" to {_s}
        send "{@prefix}&c/claim admin rename [<id>] <nom...> &8» &7renommer un claim" to {_s}
        send "{@prefix}&c/claim admin setdesc [<id>] [<desc...>] &8» &7changer la description" to {_s}
        send "{@prefix}&c/claim admin setowner [<id>] <joueur> &8» &7changer le proprietaire" to {_s}
        send "{@prefix}&c/claim admin invite|kick|promote|demote [<id>] <joueur> &8» &7gerer les membres" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

function claimResolveByNameOrId(uuid: text, raw: text) :: integer:
    set {_id} to {_raw} parsed as integer
    if {_id} is set:
        if claimExists({_id}) is true:
            return {_id}
    # Recherche par nom dans les claims du joueur
    loop indices of {claim::owner::%{_uuid}%::*}:
        set {_cid} to loop-value parsed as integer
        if {_cid} is set:
            if claimExists({_cid}) is true:
                if uncolored claimDisplayName({_cid}) is uncolored {_raw}:
                    return {_cid}
    return 0

function claimStatusCmd(s: player):
    set {_u} to uuid of {_s}
    set {_owned} to size of {claim::owner::%{_u}%::*}
    if {_owned} is not set:
        set {_owned} to 0
    set {_lim} to claimPlayerLimit({_u})
    set {_tot} to claimPlayerTotalArea({_u})
    set {_max} to claimMaxTotalArea()
    set {_rest} to {_max} - {_tot}
    if {_rest} < 0:
        set {_rest} to 0
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    send "{@prefix}&aTes claims: &f%{_owned}%&7/&f%{_lim}% &8| &aaire: &f%{_tot}%&7/&f%{_max}% &8(&7reste &f%{_rest}%&8)" to {_s}
    send "{@prefix}&7Bypass: %claimYesNo(claimHasBypass({_s}))% &8| &7Max par claim: &f%claimMaxArea()%" to {_s}
    set {_ctx} to claimEditing({_u})
    if {_ctx} is "":
        send "{@prefix}&7Edition: &cinactive &8(&6/claim create&8 ou &6/claim edit&8)" to {_s}
    else:
        if {_ctx} is "new":
            send "{@prefix}&7Edition: &anouveau claim" to {_s}
        else:
            send "{@prefix}&7Edition: &aclaim &f#%{_ctx}%" to {_s}
        send "{@prefix}&7Mode: &e%claimSelMode({_u})% &8| &7useY: %claimYesNo(claimSelUseY({_u}))% &8| &7Aire selection: &f%claimSelArea({_u})%" to {_s}
        if {claim::sel::%{_u}%::name} is set:
            send "{@prefix}&7Nom: &f%{claim::sel::%{_u}%::name}%" to {_s}
        if {claim::sel::%{_u}%::subtitle} is set:
            send "{@prefix}&7Sous-titre: &f%{claim::sel::%{_u}%::subtitle}%" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

function claimListCmd(s: player, uuid: text, label: text):
    set {_count} to size of {claim::owner::%{_uuid}%::*}
    if {_count} is not set:
        set {_count} to 0
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    send "{@prefix}&aClaims de &f%{_label}% &7(&f%{_count}%&7):" to {_s}
    if {_count} <= 0:
        send "{@prefix}&7Aucun claim." to {_s}
        send "{@prefix}&7&m-----------------------------------------" to {_s}
        stop
    loop indices of {claim::owner::%{_uuid}%::*}:
        set {_id} to loop-value parsed as integer
        if {_id} is set:
            if claimExists({_id}) is true:
                send "{@prefix}&8#&f%{_id}% &8| &a%claimDisplayName({_id})% &8| &7%claimMode({_id})% &8| &7aire &f%claimAreaOf({_id})% &8| &7%{claim::data::%{_id}%::world}%" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

function claimInfoAt(s: player):
    set {_id} to claimAtLocation(location of {_s})
    if {_id} <= 0:
        send "{@prefix}&7Aucun claim ici." to {_s}
        stop
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    send "{@prefix}&aClaim &f#%{_id}% &8: &f%claimDisplayName({_id})%" to {_s}
    if claimSubtitle({_id}) is not "":
        send "{@prefix}&7%claimSubtitle({_id})%" to {_s}
    send "{@prefix}&7Proprietaire: &f%claimOwnerName({_id})% &8| &7mode: &f%claimMode({_id})% &8| &7aire: &f%claimAreaOf({_id})%" to {_s}
    if claimIsAdminZone({_id}) is true:
        send "{@prefix}&c[Zone admin]" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

# Verifie qu'un joueur peut modifier directement (hors edition) nom/sous-titre
# d'un claim donne. Manager+ ou admin.
function claimCanEditId(p: player, id: integer) :: boolean:
    if claimExists({_id}) is false:
        return false
    if {_p} has permission "{@perm}":
        return true
    if claimIsAdminZone({_id}) is true:
        return false
    if claimEffectiveRank({_p}, {_id}) >= 3:
        return true
    return false

# Resolution intelligente : si en edition -> claim en edition,
# sinon -> claim a la position du joueur.
function claimResolveTargetId(p: player) :: integer:
    set {_u} to uuid of {_p}
    set {_ctx} to claimEditing({_u})
    if {_ctx} is not "":
        if {_ctx} is not "new":
            set {_idEdit} to {_ctx} parsed as integer
            if {_idEdit} is set:
                return {_idEdit}
    set {_here} to claimAtLocation(location of {_p})
    if {_here} > 0:
        return {_here}
    return 0

# Met a jour nom/sous-titre directement sur les donnees du claim
# et invalide le cooldown d'affichage du titre pour tous les joueurs.
function claimWriteName(id: integer, name: text):
    set {claim::data::%{_id}%::name} to {_name}
    loop indices of {claim::titlecd::*}:
        delete {claim::titlecd::%loop-value%::%{_id}%}
    bmUpsertClaim({_id})

function claimWriteSubtitle(id: integer, sub: text):
    set {claim::data::%{_id}%::subtitle} to {_sub}
    loop indices of {claim::titlecd::*}:
        delete {claim::titlecd::%loop-value%::%{_id}%}
    bmUpsertClaim({_id})

# ============================================================
#  Commandes membres
# ============================================================

# /claim members : affiche la liste des membres du claim sous les pieds.
function claimCmdMembers(s: player):
    set {_id} to claimResolveTargetId({_s})
    if {_id} <= 0:
        send "{@prefix}&cTu n'es pas sur un claim." to {_s}
        stop
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    send "{@prefix}&aMembres de &f%claimDisplayName({_id})% &7(id &f#%{_id}%&7)" to {_s}
    if claimIsAdminZone({_id}) is true:
        send "{@prefix}&c[Zone admin]" to {_s}
    else:
        set {_ownerU} to claimOwnerUuid({_id})
        if {_ownerU} is set:
            send "{@prefix}  &6&lProprietaire &8» &f%claimNameOfUuid({_ownerU})%" to {_s}
    set {_n} to 0
    loop indices of {claim::data::%{_id}%::members::*}:
        set {_r} to {claim::data::%{_id}%::members::%loop-value%}
        send "{@prefix}  %claimRoleDisplay({_r})% &8» &f%claimNameOfUuid(loop-value)%" to {_s}
        add 1 to {_n}
    if {_n} = 0:
        send "{@prefix}  &8(aucun membre)" to {_s}
    set {_mine} to claimRoleOf({_id}, uuid of {_s})
    if {_mine} is "":
        if claimHasBypass({_s}) is true:
            send "{@prefix}&7Ton role: &cadmin (bypass)" to {_s}
        else:
            send "{@prefix}&7Ton role: &8aucun" to {_s}
    else:
        send "{@prefix}&7Ton role: %claimRoleDisplay({_mine})%" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

# Dispatcher pour invite/kick/promote/demote/transfer en commande.
function claimCmdMemberAction(s: player, action: text, rawName: text):
    set {_id} to claimResolveTargetId({_s})
    if {_id} <= 0:
        send "{@prefix}&cTu dois te trouver dans le claim concerne." to {_s}
        stop
    set {_t} to {_rawName} parsed as offline player
    if {_t} is not set:
        send "{@prefix}&cJoueur introuvable: &f%{_rawName}%&c." to {_s}
        stop
    set {_tuuid} to uuid of {_t}
    set {_tname} to name of {_t}
    if {_tuuid} is uuid of {_s}:
        send "{@prefix}&cTu ne peux pas te cibler toi-meme." to {_s}
        stop
    set {_err} to ""
    if {_action} is "invite":
        set {_err} to claimMembersAdd({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            send "{@prefix}&a%{_tname}% &7ajoute comme &aMembre&7 de &f%claimDisplayName({_id})%&7." to {_s}
            set {_tp} to {_tuuid} parsed as player
            if {_tp} is set:
                send "{@prefix}&aTu as ete ajoute comme &aMembre&a de &f%claimDisplayName({_id})%&a par &f%name of {_s}%&a." to {_tp}
    else if {_action} is "kick":
        set {_err} to claimMembersRemove({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            send "{@prefix}&c%{_tname}% &7retire de &f%claimDisplayName({_id})%&7." to {_s}
            set {_tp} to {_tuuid} parsed as player
            if {_tp} is set:
                send "{@prefix}&cTu as ete retire de &f%claimDisplayName({_id})%&c par &f%name of {_s}%&c." to {_tp}
    else if {_action} is "promote":
        set {_err} to claimMembersPromote({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            set {_new} to claimRoleOf({_id}, {_tuuid})
            send "{@prefix}&a%{_tname}% &7est maintenant %claimRoleDisplay({_new})%&7." to {_s}
            set {_tp} to {_tuuid} parsed as player
            if {_tp} is set:
                send "{@prefix}&aTu es maintenant %claimRoleDisplay({_new})%&a de &f%claimDisplayName({_id})%&a." to {_tp}
    else if {_action} is "demote":
        set {_err} to claimMembersDemote({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            set {_new} to claimRoleOf({_id}, {_tuuid})
            if {_new} is "":
                send "{@prefix}&e%{_tname}% &7n'est plus membre de &f%claimDisplayName({_id})%&7." to {_s}
            else:
                send "{@prefix}&e%{_tname}% &7retrograde a %claimRoleDisplay({_new})%&7." to {_s}
            set {_tp} to {_tuuid} parsed as player
            if {_tp} is set:
                send "{@prefix}&7Ton role sur &f%claimDisplayName({_id})% &7a ete modifie par &f%name of {_s}%&7." to {_tp}
    else if {_action} is "transfer":
        set {_err} to claimXferRequest({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            send "{@prefix}&6Requete de transfert &7envoyee a &f%{_tname}%&7 (expire dans &f%claimXferTtlSeconds()%s&7)." to {_s}
    if {_err} is not "":
        send "{@prefix}%{_err}%" to {_s}

# ============================================================
#  Admin – gestion avancée d'un claim
#  Toutes ces fonctions acceptent un id validé (claim existant).
# ============================================================

# Renomme un claim.
function claimAdminRenameCmd(s: player, id: integer, newname: text):
    set {_old} to claimDisplayName({_id})
    set {claim::data::%{_id}%::name} to colored {_newname}
    bmUpsertClaim({_id})
    send "{@prefix}&aClaim &f#%{_id}% &7renomme: &r%colored {_newname}% &7(etait: &8%{_old}%&7)." to {_s}

# Modifie le propriétaire d'un claim.
function claimAdminSetOwnerCmd(s: player, id: integer, rawPlayer: text):
    set {_t} to {_rawPlayer} parsed as offline player
    if {_t} is not set:
        send "{@prefix}&cJoueur introuvable: &f%{_rawPlayer}%&c." to {_s}
        stop
    set {_newUuid} to uuid of {_t}
    set {_newName} to name of {_t}
    set {_oldUuid} to claimOwnerUuid({_id})
    if "%{_oldUuid}%" is "%{_newUuid}%":
        send "{@prefix}&e%{_newName}% &7est deja proprietaire de &f%claimDisplayName({_id})%&7." to {_s}
        stop
    if {_oldUuid} is set:
        delete {claim::owner::%{_oldUuid}%::%{_id}%}
    claimSetRole({_id}, {_newUuid}, "")
    set {claim::data::%{_id}%::owner} to {_newUuid}
    set {claim::owner::%{_newUuid}%::%{_id}%} to true
    bmUpsertClaim({_id})
    send "{@prefix}&aClaim &f%claimDisplayName({_id})% &8(#%{_id}%) &7: proprietaire -> &f%{_newName}%&7." to {_s}
    set {_tp} to {_newUuid} parsed as player
    if {_tp} is set:
        send "{@prefix}&6Tu es maintenant &lproprietaire&6 du claim &f%claimDisplayName({_id})%&6 (attribution admin)." to {_tp}

# Modifie la description/sous-titre d'un claim.
function claimAdminSetDescCmd(s: player, id: integer, desc: text):
    claimWriteSubtitle({_id}, colored {_desc})
    if {_desc} is "":
        send "{@prefix}&7Description du claim &f#%{_id}% &7effacee." to {_s}
    else:
        send "{@prefix}&aDescription du claim &f%claimDisplayName({_id})% &8(#%{_id}%) &7mise a jour." to {_s}

# Affiche info complète + membres (vue admin).
function claimAdminManageCmd(s: player, id: integer):
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    send "{@prefix}&c&lAdmin &8| &fClaim &6%claimDisplayName({_id})% &7(#%{_id}%)" to {_s}
    set {_wn} to {claim::data::%{_id}%::world}
    send "{@prefix}&7Monde: &f%{_wn}% &8| &7Mode: &f%claimMode({_id})% &8| &7Aire: &f%claimAreaOf({_id})%" to {_s}
    set {_sub} to claimSubtitle({_id})
    if {_sub} is not "":
        send "{@prefix}&7Description: &f%{_sub}%" to {_s}
    if claimIsAdminZone({_id}) is true:
        send "{@prefix}&cZone admin &7(pas de proprietaire joueur)" to {_s}
    else:
        set {_ownerU} to claimOwnerUuid({_id})
        send "{@prefix}&7Proprietaire: &6%claimOwnerName({_id})% &8(&7%{_ownerU}%&8)" to {_s}
    if {claim::data::%{_id}%::bbox::minX} is set:
        send "{@prefix}&7X: &f%{claim::data::%{_id}%::bbox::minX}%&8..&f%{claim::data::%{_id}%::bbox::maxX}% &8| &7Z: &f%{claim::data::%{_id}%::bbox::minZ}%&8..&f%{claim::data::%{_id}%::bbox::maxZ}% &8| &7Y: &f%{claim::data::%{_id}%::bbox::minY}%&8..&f%{claim::data::%{_id}%::bbox::maxY}%" to {_s}
    send "{@prefix}&7&m--- Membres ---" to {_s}
    if claimIsAdminZone({_id}) is false:
        set {_ownerU2} to claimOwnerUuid({_id})
        if {_ownerU2} is set:
            send "{@prefix}  &6&lProprietaire &8» &f%claimNameOfUuid({_ownerU2})%" to {_s}
    set {_nm} to 0
    loop indices of {claim::data::%{_id}%::members::*}:
        set {_r} to {claim::data::%{_id}%::members::%loop-value%}
        send "{@prefix}  %claimRoleDisplay({_r})% &8» &f%claimNameOfUuid(loop-value)%" to {_s}
        add 1 to {_nm}
    if {_nm} = 0:
        send "{@prefix}  &8(aucun membre)" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

# Téléporte un admin au centre du claim (bbox).
function claimAdminTpCmd(s: player, id: integer):
    if {claim::data::%{_id}%::bbox::minX} is not set:
        send "{@prefix}&cCe claim n'a pas encore de bounding box. Utilise &6/claim admin edit&c pour en definir une." to {_s}
        stop
    set {_cx} to ({claim::data::%{_id}%::bbox::minX} + {claim::data::%{_id}%::bbox::maxX}) / 2
    set {_cz} to ({claim::data::%{_id}%::bbox::minZ} + {claim::data::%{_id}%::bbox::maxZ}) / 2
    set {_cy} to ({claim::data::%{_id}%::bbox::maxY} + 2)
    set {_w} to world {claim::data::%{_id}%::world}
    if {_w} is not set:
        send "{@prefix}&cMonde &f%{claim::data::%{_id}%::world}% &cintrouvable." to {_s}
        stop
    teleport {_s} to location({_cx}, {_cy}, {_cz}, {_w})
    send "{@prefix}&aTeleporte au claim &f%claimDisplayName({_id})% &8(#%{_id}%)&7." to {_s}

# Action membre (invite/kick/promote/demote) sans contrainte de position – admin.
function claimAdminMemberActionCmd(s: player, id: integer, action: text, rawPlayer: text):
    set {_t} to {_rawPlayer} parsed as offline player
    if {_t} is not set:
        send "{@prefix}&cJoueur introuvable: &f%{_rawPlayer}%&c." to {_s}
        stop
    set {_tuuid} to uuid of {_t}
    set {_tname} to name of {_t}
    if "%{_tuuid}%" is "%uuid of {_s}%":
        send "{@prefix}&cTu ne peux pas te cibler toi-meme." to {_s}
        stop
    set {_err} to ""
    if {_action} is "invite":
        set {_err} to claimMembersAdd({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            send "{@prefix}&a%{_tname}% &7ajoute comme &aMembre&7 de &f%claimDisplayName({_id})%&7 (admin)." to {_s}
    else if {_action} is "kick":
        set {_err} to claimMembersRemove({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            send "{@prefix}&c%{_tname}% &7retire de &f%claimDisplayName({_id})%&7 (admin)." to {_s}
    else if {_action} is "promote":
        set {_err} to claimMembersPromote({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            set {_new} to claimRoleOf({_id}, {_tuuid})
            send "{@prefix}&a%{_tname}% &7promu %claimRoleDisplay({_new})%&7 (admin)." to {_s}
    else if {_action} is "demote":
        set {_err} to claimMembersDemote({_s}, {_id}, {_tuuid}, {_tname})
        if {_err} is "":
            set {_new} to claimRoleOf({_id}, {_tuuid})
            if {_new} is "":
                send "{@prefix}&e%{_tname}% &7retire des membres de &f%claimDisplayName({_id})%&7 (admin)." to {_s}
            else:
                send "{@prefix}&e%{_tname}% &7retrograde a %claimRoleDisplay({_new})%&7 (admin)." to {_s}
    if {_err} is not "":
        send "{@prefix}%{_err}%" to {_s}

function claimAdminInfoCmd(s: player, id: integer):
    if claimExists({_id}) is false:
        send "{@prefix}&cClaim &f#%{_id}% &cintrouvable." to {_s}
        stop
    set {_owner} to claimOwnerUuid({_id})
    if {_owner} is not set:
        set {_owner} to "?"
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    send "{@prefix}&cClaim ADMIN-INFO &f#%{_id}%" to {_s}
    send "{@prefix}&7Nom: &f%claimDisplayName({_id})%" to {_s}
    set {_sub} to claimSubtitle({_id})
    if {_sub} is "":
        send "{@prefix}&7Description: &8(aucune)" to {_s}
    else:
        send "{@prefix}&7Description: &f%{_sub}%" to {_s}
    send "{@prefix}&7Proprietaire: &f%claimOwnerName({_id})% &8(&f%{_owner}%&8)" to {_s}
    send "{@prefix}&7Monde: &f%{claim::data::%{_id}%::world}% &8| &7mode: &f%claimMode({_id})% &8| &7useY: %claimYesNo(claimUseY({_id}))%" to {_s}
    send "{@prefix}&7Aire: &f%claimAreaOf({_id})% &8| &7Admin: %claimYesNo(claimIsAdminZone({_id}))%" to {_s}
    if {claim::data::%{_id}%::bbox::minX} is set:
        send "{@prefix}&7BBox X: &f%{claim::data::%{_id}%::bbox::minX}%..%{claim::data::%{_id}%::bbox::maxX}% &8| &7Z: &f%{claim::data::%{_id}%::bbox::minZ}%..%{claim::data::%{_id}%::bbox::maxZ}% &8| &7Y: &f%{claim::data::%{_id}%::bbox::minY}%..%{claim::data::%{_id}%::bbox::maxY}%" to {_s}
    set {_cells} to size of {claim::index::byclaim::%{_id}%::list::*}
    if {_cells} is not set:
        set {_cells} to 0
    set {_big} to false
    if {claim::index::big::%{_id}%} is true:
        set {_big} to true
    send "{@prefix}&7Index: &f%{_cells}% &7chunks &8| &7Big-claim: %claimYesNo({_big})%" to {_s}
    if claimMode({_id}) is "poly":
        set {_n} to {claim::data::%{_id}%::poly::count} ? 0
        send "{@prefix}&7Polygone: &f%{_n}% &7sommets" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

function claimAdminListAll(s: player):
    send "{@prefix}&7&m-----------------------------------------" to {_s}
    set {_n} to 0
    set {_max} to {claim::id::counter} ? 0
    set {_i} to 1
    while {_i} <= {_max}:
        if claimExists({_i}) is true:
            add 1 to {_n}
            send "{@prefix}&8#&f%{_i}% &a%claimDisplayName({_i})% &8| &7%claimOwnerName({_i})% &8| &7aire &f%claimAreaOf({_i})% &8| &7%{claim::data::%{_i}%::world}%" to {_s}
        add 1 to {_i}
    send "{@prefix}&7Total: &f%{_n}%" to {_s}
    send "{@prefix}&7&m-----------------------------------------" to {_s}

function claimAdminReset(s: player):
    delete {claim::data::*}
    delete {claim::owner::*}
    delete {claim::index::*}
    delete {claim::sel::*}
    delete {claim::fxcache::*}
    delete {claim::fxframe::*}
    delete {claim::editing::*}
    delete {claim::id::counter}
    send "{@prefix}&cTout a ete reinitialise." to {_s}

command /claim [<text>] [<text>] [<text>] [<text>] [<text>] [<text>] [<text>] [<text>]:
    aliases: claims, cl
    trigger:
        set {_u} to uuid of player
        if arg-1 is not set:
            claimCmdHelp(player)
            stop
        if arg-1 is "help":
            claimCmdHelp(player)
            stop
        if arg-1 is "wand":
            if claimCanEditClaims(player) is false:
                send "{@prefix}&cLes claims joueurs sont actuellement desactives par un admin." to player
                stop
            claimGiveWand(player)
            stop
        if arg-1 is "status":
            claimStatusCmd(player)
            stop
        if arg-1 is "info":
            claimInfoAt(player)
            stop
        if arg-1 is "list":
            if arg-2 is set:
                set {_t} to arg-2 parsed as offline player
                if {_t} is not set:
                    send "{@prefix}&cJoueur introuvable." to player
                    stop
                if player does not have permission "{@perm}":
                    if uuid of {_t} is not {_u}:
                        send "{@prefix}&cTu ne peux lister que tes propres claims." to player
                        stop
                claimListCmd(player, uuid of {_t}, name of {_t})
                stop
            claimListCmd(player, {_u}, player's name)
            stop
        if player does not have permission "{@perm}":
            if claimPlayersCanClaim() is false:
                send "{@prefix}&cLes claims joueurs sont actuellement desactives par un admin." to player
                stop
        if arg-1 is "mode":
            if arg-2 is "poly":
                set {claim::sel::%{_u}%::mode} to "poly"
                delete {claim::sel::%{_u}%::rect::1}
                delete {claim::sel::%{_u}%::rect::2}
                claimFxCacheMarkDirty({_u})
                send "{@prefix}&aMode: &epolygone&a." to player
                stop
            if arg-2 is "rect":
                delete {claim::sel::%{_u}%::mode}
                delete {claim::sel::%{_u}%::poly::*}
                delete {claim::sel::%{_u}%::poly::count}
                claimFxCacheMarkDirty({_u})
                send "{@prefix}&aMode: &erectangulaire&a." to player
                stop
            send "{@prefix}&cUsage: /claim mode <rect|poly>" to player
            stop
        if arg-1 is "usey":
            if arg-2 is "on":
                set {claim::sel::%{_u}%::usey} to true
                claimFxCacheMarkDirty({_u})
                send "{@prefix}&aHauteur Y prise en compte." to player
                stop
            if arg-2 is "off":
                delete {claim::sel::%{_u}%::usey}
                claimFxCacheMarkDirty({_u})
                send "{@prefix}&7Hauteur Y ignoree (zone XZ)." to player
                stop
            send "{@prefix}&cUsage: /claim usey <on|off>" to player
            stop
        if arg-1 is "expand":
            set {_dir} to ""
            if arg-2 is "up":
                set {_dir} to "up"
            if arg-2 is "down":
                set {_dir} to "down"
            if arg-2 is "both":
                set {_dir} to "both"
            if {_dir} is "":
                send "{@prefix}&cUsage: /claim expand <up|down|both> <n>" to player
                stop
            if arg-3 is not set:
                send "{@prefix}&cUsage: /claim expand <up|down|both> <n>" to player
                stop
            set {_n} to arg-3 parsed as integer
            if {_n} is not set:
                send "{@prefix}&cValeur invalide (entier attendu)." to player
                stop
            if {_n} <= 0:
                send "{@prefix}&cLa valeur doit etre positive." to player
                stop
            if {_n} > 512:
                set {_n} to 512
            set {_mode} to {claim::sel::%{_u}%::mode} ? "rect"
            if {_mode} is "poly":
                set {_count} to {claim::sel::%{_u}%::poly::count} ? 0
                if {_count} < 1:
                    send "{@prefix}&cSelection polygone vide." to player
                    stop
                set {_minI} to 1
                set {_maxI} to 1
                set {_minYv} to y-coordinate of {claim::sel::%{_u}%::poly::1}
                set {_maxYv} to {_minYv}
                set {_i} to 2
                while {_i} <= {_count}:
                    set {_yi} to y-coordinate of {claim::sel::%{_u}%::poly::%{_i}%}
                    if {_yi} < {_minYv}:
                        set {_minYv} to {_yi}
                        set {_minI} to {_i}
                    if {_yi} > {_maxYv}:
                        set {_maxYv} to {_yi}
                        set {_maxI} to {_i}
                    add 1 to {_i}
                set {_wld} to world of {claim::sel::%{_u}%::poly::1}
                set {_wMin} to -64
                set {_wMax} to 319
                if {_dir} is "down":
                    set {_doDown} to true
                if {_dir} is "both":
                    set {_doDown} to true
                if {_dir} is "up":
                    set {_doUp} to true
                if {_dir} is "both":
                    set {_doUp} to true
                if {_doDown} is true:
                    set {_newY} to {_minYv} - {_n}
                    if {_newY} < {_wMin}:
                        set {_newY} to {_wMin}
                    set {_loc} to {claim::sel::%{_u}%::poly::%{_minI}%}
                    set {claim::sel::%{_u}%::poly::%{_minI}%} to location(x-coordinate of {_loc}, {_newY}, z-coordinate of {_loc}, {_wld})
                if {_doUp} is true:
                    set {_newY} to {_maxYv} + {_n}
                    if {_newY} > {_wMax}:
                        set {_newY} to {_wMax}
                    set {_loc} to {claim::sel::%{_u}%::poly::%{_maxI}%}
                    set {claim::sel::%{_u}%::poly::%{_maxI}%} to location(x-coordinate of {_loc}, {_newY}, z-coordinate of {_loc}, {_wld})
            else:
                set {_a} to {claim::sel::%{_u}%::rect::1}
                set {_b} to {claim::sel::%{_u}%::rect::2}
                set {_hasRect} to true
                if {_a} is not set:
                    set {_hasRect} to false
                if {_b} is not set:
                    set {_hasRect} to false
                if {_hasRect} is false:
                    send "{@prefix}&cSelection rectangulaire incomplete (pos1+pos2 requis)." to player
                    stop
                set {_ya} to y-coordinate of {_a}
                set {_yb} to y-coordinate of {_b}
                set {_wld} to world of {_a}
                set {_wMin} to -64
                set {_wMax} to 319
                set {_loRef} to "a"
                if {_yb} < {_ya}:
                    set {_loRef} to "b"
                if {_dir} is "down":
                    set {_doDown} to true
                if {_dir} is "both":
                    set {_doDown} to true
                if {_dir} is "up":
                    set {_doUp} to true
                if {_dir} is "both":
                    set {_doUp} to true
                if {_doDown} is true:
                    if {_loRef} is "a":
                        set {_newY} to {_ya} - {_n}
                        if {_newY} < {_wMin}:
                            set {_newY} to {_wMin}
                        set {claim::sel::%{_u}%::rect::1} to location(x-coordinate of {_a}, {_newY}, z-coordinate of {_a}, {_wld})
                    else:
                        set {_newY} to {_yb} - {_n}
                        if {_newY} < {_wMin}:
                            set {_newY} to {_wMin}
                        set {claim::sel::%{_u}%::rect::2} to location(x-coordinate of {_b}, {_newY}, z-coordinate of {_b}, {_wld})
                if {_doUp} is true:
                    if {_loRef} is "a":
                        set {_newY} to {_yb} + {_n}
                        if {_newY} > {_wMax}:
                            set {_newY} to {_wMax}
                        set {claim::sel::%{_u}%::rect::2} to location(x-coordinate of {_b}, {_newY}, z-coordinate of {_b}, {_wld})
                    else:
                        set {_newY} to {_ya} + {_n}
                        if {_newY} > {_wMax}:
                            set {_newY} to {_wMax}
                        set {claim::sel::%{_u}%::rect::1} to location(x-coordinate of {_a}, {_newY}, z-coordinate of {_a}, {_wld})
            set {claim::sel::%{_u}%::usey} to true
            claimFxCacheMarkDirty({_u})
            send "{@prefix}&aSelection etendue &7(&f%{_dir}% %{_n}%&7)&a. &8Hauteur Y activee." to player
            stop
        if arg-1 is "name":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim name <texte>" to player
                stop
            set {_n} to arg-2
            if arg-3 is set:
                set {_n} to "%{_n}% %arg-3%"
            if arg-4 is set:
                set {_n} to "%{_n}% %arg-4%"
            if arg-5 is set:
                set {_n} to "%{_n}% %arg-5%"
            if arg-6 is set:
                set {_n} to "%{_n}% %arg-6%"
            if arg-7 is set:
                set {_n} to "%{_n}% %arg-7%"
            if arg-8 is set:
                set {_n} to "%{_n}% %arg-8%"
            set {_colN} to colored {_n}
            # En mode edition : on met a jour la selection (sera sauve a /claim save)
            if claimEditing({_u}) is not "":
                set {claim::sel::%{_u}%::name} to {_colN}
                send "{@prefix}&aNom defini: &f%{_colN}% &8(&7sauvegarde a &6/claim save&8)" to player
                stop
            # Hors edition : on modifie directement le claim a la position du joueur
            set {_tid} to claimResolveTargetId(player)
            if {_tid} <= 0:
                send "{@prefix}&cTu n'es pas sur un claim. &7Utilise &6/claim edit <id>&7 d'abord." to player
                stop
            if claimCanEditId(player, {_tid}) is false:
                send "{@prefix}&cCe claim ne t'appartient pas." to player
                stop
            claimWriteName({_tid}, {_colN})
            send "{@prefix}&aNom du claim &f#%{_tid}% &amis a jour: &f%{_colN}%" to player
            stop
        set {_claimDescCmd} to false
        if arg-1 is "subtitle":
            set {_claimDescCmd} to true
        else if arg-1 is "description":
            set {_claimDescCmd} to true
        else if arg-1 is "desc":
            set {_claimDescCmd} to true
        if {_claimDescCmd} is true:
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim description <texte>" to player
                stop
            set {_n} to arg-2
            if arg-3 is set:
                set {_n} to "%{_n}% %arg-3%"
            if arg-4 is set:
                set {_n} to "%{_n}% %arg-4%"
            if arg-5 is set:
                set {_n} to "%{_n}% %arg-5%"
            if arg-6 is set:
                set {_n} to "%{_n}% %arg-6%"
            if arg-7 is set:
                set {_n} to "%{_n}% %arg-7%"
            if arg-8 is set:
                set {_n} to "%{_n}% %arg-8%"
            set {_colN} to colored {_n}
            # En mode edition : on met a jour la selection (sera sauve a /claim save)
            if claimEditing({_u}) is not "":
                set {claim::sel::%{_u}%::subtitle} to {_colN}
                send "{@prefix}&aDescription definie: &f%{_colN}% &8(&7sauvegarde a &6/claim save&8)" to player
                stop
            # Hors edition : on modifie directement le claim a la position du joueur
            set {_tid} to claimResolveTargetId(player)
            if {_tid} <= 0:
                send "{@prefix}&cTu n'es pas sur un claim. &7Utilise &6/claim edit <id>&7 d'abord." to player
                stop
            if claimCanEditId(player, {_tid}) is false:
                send "{@prefix}&cCe claim ne t'appartient pas." to player
                stop
            claimWriteSubtitle({_tid}, {_colN})
            send "{@prefix}&aDescription du claim &f#%{_tid}% &amise a jour: &f%{_colN}%" to player
            stop
        if arg-1 is "create":
            if claimIsWand(tool of player) is false:
                send "{@prefix}&cTu dois tenir la &aClaim Wand &cen main pour creer un claim." to player
                send "{@prefix}&7Utilise &6/claim wand&7 pour la recuperer." to player
                stop
            set {_hadSel} to claimSelHasRegion({_u})
            claimStartNew({_u})
            if arg-2 is set:
                set {_n} to arg-2
                if arg-3 is set:
                    set {_n} to "%{_n}% %arg-3%"
                if arg-4 is set:
                    set {_n} to "%{_n}% %arg-4%"
                if arg-5 is set:
                    set {_n} to "%{_n}% %arg-5%"
                if arg-6 is set:
                    set {_n} to "%{_n}% %arg-6%"
                if arg-7 is set:
                    set {_n} to "%{_n}% %arg-7%"
                if arg-8 is set:
                    set {_n} to "%{_n}% %arg-8%"
                set {claim::sel::%{_u}%::name} to colored {_n}
            if {_hadSel} is true:
                send "{@prefix}&aMode creation. &7Selection conservee, utilise &6/claim save&7 pour valider." to player
            else:
                send "{@prefix}&aMode creation. Utilise la wand pour selectionner, puis &6/claim save&a." to player
            stop
        if arg-1 is "edit":
            set {_id} to 0
            if arg-2 is not set:
                # Pas d'argument : on prend le claim sous les pieds (le plus
                # petit en cas d'imbrication, cf. claimAtLocation).
                set {_id} to claimAtLocation(location of player)
                if {_id} <= 0:
                    send "{@prefix}&cAucun claim ici. Utilise &6/claim edit <id|nom>&c." to player
                    stop
            else:
                set {_id} to claimResolveByNameOrId({_u}, arg-2)
                if {_id} <= 0:
                    send "{@prefix}&cClaim introuvable." to player
                    stop
            if claimIsAdminZone({_id}) is true:
                if player does not have permission "{@perm}":
                    send "{@prefix}&cTu ne peux pas editer un claim admin." to player
                    stop
            else:
                if claimCanEditBorders(player, {_id}) is false:
                    send "{@prefix}&cTu n'as pas les droits pour editer la frontiere de ce claim. &7(role gestionnaire requis)" to player
                    stop
            claimStartEdit({_u}, {_id})
            send "{@prefix}&aEdition: &f%claimDisplayName({_id})% &7(id &f#%{_id}%&7). Modifie la selection puis &6/claim save&7." to player
            stop
        if arg-1 is "save":
            claimSave(player)
            stop
        if arg-1 is "cancel":
            if claimEditing({_u}) is "":
                send "{@prefix}&7Aucune edition en cours." to player
                stop
            claimEndEdit({_u})
            send "{@prefix}&7Edition annulee." to player
            stop
        if arg-1 is "delete":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim delete <id|nom>" to player
                stop
            set {_id} to claimResolveByNameOrId({_u}, arg-2)
            if {_id} <= 0:
                send "{@prefix}&cClaim introuvable." to player
                stop
            claimDelete(player, {_id})
            stop
        # ------- Gestion des membres -------
        if arg-1 is "members" or "membres" or "list-members":
            claimCmdMembers(player)
            stop
        if arg-1 is "invite" or "add" or "trust":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim invite <joueur>" to player
                stop
            claimCmdMemberAction(player, "invite", arg-2)
            stop
        if arg-1 is "kick" or "remove" or "untrust":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim kick <joueur>" to player
                stop
            claimCmdMemberAction(player, "kick", arg-2)
            stop
        if arg-1 is "promote":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim promote <joueur>" to player
                stop
            claimCmdMemberAction(player, "promote", arg-2)
            stop
        if arg-1 is "demote":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim demote <joueur>" to player
                stop
            claimCmdMemberAction(player, "demote", arg-2)
            stop
        if arg-1 is "transfer" or "giveowner":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim transfer <joueur>" to player
                stop
            claimCmdMemberAction(player, "transfer", arg-2)
            stop
        if arg-1 is "accept":
            set {_err} to claimXferAccept(player)
            if {_err} is "":
                send "{@prefix}&aTransfert accepte. Le claim t'appartient desormais." to player
                play sound "minecraft:entity.player.levelup" with volume 0.8 with pitch 1.2 to player
            else:
                send "{@prefix}%{_err}%" to player
            stop
        if arg-1 is "deny" or "refuse":
            set {_err} to claimXferDeny(player)
            if {_err} is "":
                send "{@prefix}&7Transfert refuse." to player
            else:
                send "{@prefix}%{_err}%" to player
            stop
        if arg-1 is "transfer-cancel" or "untransfer":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /claim transfer-cancel <joueur>" to player
                stop
            set {_t} to arg-2 parsed as offline player
            if {_t} is not set:
                send "{@prefix}&cJoueur introuvable." to player
                stop
            set {_err} to claimXferCancel(player, uuid of {_t}, name of {_t})
            if {_err} is "":
                send "{@prefix}&7Requete annulee." to player
            else:
                send "{@prefix}%{_err}%" to player
            stop
        if arg-1 is "admin":
            if player does not have permission "{@perm}":
                send "{@prefix}&cReserve aux admins." to player
                stop
            if arg-2 is not set:
                claimCmdHelp(player)
                stop
            if arg-2 is "info":
                if arg-3 is set:
                    set {_id} to arg-3 parsed as integer
                    if {_id} is not set:
                        send "{@prefix}&cId invalide." to player
                        stop
                else:
                    set {_id} to claimAtLocation(location of player)
                    if {_id} <= 0:
                        send "{@prefix}&cUsage: /claim admin info <id> &7(ou place-toi sur un claim)" to player
                        stop
                claimAdminInfoCmd(player, {_id})
                stop
            if arg-2 is "create":
                if claimIsWand(tool of player) is false:
                    send "{@prefix}&cTu dois tenir la &aClaim Wand &cen main pour creer un claim." to player
                    send "{@prefix}&7Utilise &6/claim wand&7 pour la recuperer." to player
                    stop
                set {_hadSel} to claimSelHasRegion({_u})
                claimStartNew({_u})
                set {claim::sel::%{_u}%::asAdmin} to true
                if arg-3 is set:
                    set {_n} to arg-3
                    if arg-4 is set:
                        set {_n} to "%{_n}% %arg-4%"
                    if arg-5 is set:
                        set {_n} to "%{_n}% %arg-5%"
                    if arg-6 is set:
                        set {_n} to "%{_n}% %arg-6%"
                    if arg-7 is set:
                        set {_n} to "%{_n}% %arg-7%"
                    if arg-8 is set:
                        set {_n} to "%{_n}% %arg-8%"
                    set {claim::sel::%{_u}%::name} to colored {_n}
                if {_hadSel} is true:
                    send "{@prefix}&aMode creation ADMIN. &7Selection conservee, utilise &6/claim save&7 pour valider." to player
                else:
                    send "{@prefix}&aMode creation ADMIN. Utilise la wand puis &6/claim save&a." to player
                stop
            if arg-2 is "delete":
                if arg-3 is not set:
                    send "{@prefix}&cUsage: /claim admin delete <id>" to player
                    stop
                set {_id} to arg-3 parsed as integer
                if {_id} is not set:
                    send "{@prefix}&cId invalide." to player
                    stop
                claimDelete(player, {_id})
                stop
            if arg-2 is "list":
                if arg-3 is set:
                    set {_t} to arg-3 parsed as offline player
                    if {_t} is not set:
                        send "{@prefix}&cJoueur introuvable." to player
                        stop
                    claimListCmd(player, uuid of {_t}, name of {_t})
                    stop
                claimAdminListAll(player)
                stop
            if arg-2 is "setlimit":
                if arg-4 is not set:
                    send "{@prefix}&cUsage: /claim admin setlimit <joueur> <n>" to player
                    stop
                set {_t} to arg-3 parsed as offline player
                if {_t} is not set:
                    send "{@prefix}&cJoueur introuvable." to player
                    stop
                set {_v} to arg-4 parsed as integer
                if {_v} is not set:
                    send "{@prefix}&cNombre invalide." to player
                    stop
                set {claim::limit::%uuid of {_t}%} to {_v}
                send "{@prefix}&aLimite de claims pour &f%name of {_t}% &a= &f%{_v}%&a." to player
                stop
            if arg-2 is "bypass":
                if arg-4 is not set:
                    send "{@prefix}&cUsage: /claim admin bypass <joueur> <on|off>" to player
                    stop
                set {_t} to arg-3 parsed as offline player
                if {_t} is not set:
                    send "{@prefix}&cJoueur introuvable." to player
                    stop
                if arg-4 is "on":
                    set {claim::bypass::%uuid of {_t}%} to true
                    send "{@prefix}&aBypass active pour &f%name of {_t}%&a." to player
                    stop
                if arg-4 is "off":
                    delete {claim::bypass::%uuid of {_t}%}
                    send "{@prefix}&7Bypass desactive pour &f%name of {_t}%&7." to player
                    stop
                send "{@prefix}&cUsage: /claim admin bypass <joueur> <on|off>" to player
                stop
            if arg-2 is "claims":
                if arg-3 is not set:
                    if claimPlayersCanClaim() is true:
                        send "{@prefix}&aClaims joueurs: &aON" to player
                    else:
                        send "{@prefix}&aClaims joueurs: &cOFF" to player
                    stop
                if arg-3 is "on":
                    set {claim::cfg::enabled} to true
                    send "{@prefix}&aLes claims joueurs sont maintenant &aactives&a." to player
                    stop
                if arg-3 is "off":
                    set {claim::cfg::enabled} to false
                    send "{@prefix}&eLes claims joueurs sont maintenant &cdesactives&e." to player
                    stop
                send "{@prefix}&cUsage: /claim admin claims <on|off>" to player
                stop
            if arg-2 is "fxdebug":
                if arg-3 is not set:
                    if claimFxDebugEnabled() is true:
                        send "{@prefix}&aFX debug: &aON" to player
                    else:
                        send "{@prefix}&aFX debug: &cOFF" to player
                    stop
                if arg-3 is "on":
                    set {claim::cfg::fx::debug} to true
                    send "{@prefix}&aFX debug &aactive&a." to player
                    stop
                if arg-3 is "off":
                    delete {claim::cfg::fx::debug}
                    send "{@prefix}&7FX debug &cdesactive&7." to player
                    stop
                send "{@prefix}&cUsage: /claim admin fxdebug <on|off>" to player
                stop
            if arg-2 is "fxperf":
                if arg-3 is not set:
                    if claimFxPerfEnabled() is true:
                        send "{@prefix}&aFX perf: &aON" to player
                    else:
                        send "{@prefix}&aFX perf: &cOFF" to player
                    stop
                if arg-3 is "on":
                    set {claim::cfg::fx::perf} to true
                    send "{@prefix}&aFX perf &aactive&a." to player
                    stop
                if arg-3 is "off":
                    delete {claim::cfg::fx::perf}
                    send "{@prefix}&7FX perf &cdesactive&7." to player
                    stop
                send "{@prefix}&cUsage: /claim admin fxperf <on|off>" to player
                stop
            if arg-2 is "maxarea":
                if arg-3 is not set:
                    send "{@prefix}&cMax par claim actuel: &f%claimMaxArea()%" to player
                    stop
                set {_v} to arg-3 parsed as integer
                if {_v} is not set:
                    send "{@prefix}&cNombre invalide." to player
                    stop
                set {claim::cfg::max_area} to {_v}
                send "{@prefix}&aMax par claim = &f%{_v}%&a." to player
                stop
            if arg-2 is "maxtotal":
                if arg-3 is not set:
                    send "{@prefix}&cMax total actuel: &f%claimMaxTotalArea()%" to player
                    stop
                set {_v} to arg-3 parsed as integer
                if {_v} is not set:
                    send "{@prefix}&cNombre invalide." to player
                    stop
                set {claim::cfg::max_total} to {_v}
                send "{@prefix}&aMax total par joueur = &f%{_v}%&a." to player
                stop
            if arg-2 is "maxvertices":
                if arg-3 is not set:
                    send "{@prefix}&cMax sommets actuel: &f%claimMaxVertices()%" to player
                    stop
                set {_v} to arg-3 parsed as integer
                if {_v} is not set:
                    send "{@prefix}&cNombre invalide." to player
                    stop
                if {_v} < 3:
                    send "{@prefix}&cMinimum 3 sommets." to player
                    stop
                set {claim::cfg::max_vertices} to {_v}
                send "{@prefix}&aMax sommets = &f%{_v}%&a. &7(admins illimites)" to player
                stop
            if arg-2 is "defaultlimit":
                if arg-3 is not set:
                    send "{@prefix}&cLimite par defaut actuelle: &f%claimDefaultLimit()%" to player
                    stop
                set {_v} to arg-3 parsed as integer
                if {_v} is not set:
                    send "{@prefix}&cNombre invalide." to player
                    stop
                set {claim::cfg::default_limit} to {_v}
                send "{@prefix}&aLimite par defaut = &f%{_v}%&a." to player
                stop
            if arg-2 is "reset":
                claimAdminReset(player)
                stop

            # ---- Nouvelles sous-commandes de gestion ----
            # Macro interne : résout un ID depuis arg-3 ou la position du joueur.
            # Stocke le résultat dans {_aid}, stoppe avec erreur si invalide.
            # (Inliné pour éviter un appel de fonction supplémentaire.)
            set {_aid} to 0
            if arg-3 is set:
                set {_tryAid} to arg-3 parsed as integer
                if {_tryAid} is set:
                    if claimExists({_tryAid}) is false:
                        send "{@prefix}&cClaim &f#%{_tryAid}% &cintrouvable." to player
                        stop
                    set {_aid} to {_tryAid}

            # /claim admin manage [id] – info complète + membres
            if arg-2 is "manage":
                if {_aid} <= 0:
                    set {_aid} to claimAtLocation(location of player)
                    if {_aid} <= 0:
                        send "{@prefix}&cTu n'es sur aucun claim. Usage: /claim admin manage [<id>]" to player
                        stop
                claimAdminManageCmd(player, {_aid})
                stop

            # /claim admin members [id] – liste des membres
            if arg-2 is "members":
                if {_aid} <= 0:
                    set {_aid} to claimAtLocation(location of player)
                    if {_aid} <= 0:
                        send "{@prefix}&cTu n'es sur aucun claim. Usage: /claim admin members [<id>]" to player
                        stop
                claimAdminManageCmd(player, {_aid})
                stop

            # /claim admin tp <id> – téléportation (id toujours requis)
            if arg-2 is "tp":
                if arg-3 is not set:
                    send "{@prefix}&cUsage: /claim admin tp <id>" to player
                    stop
                set {_tpId} to arg-3 parsed as integer
                if {_tpId} is not set:
                    send "{@prefix}&cId invalide." to player
                    stop
                if claimExists({_tpId}) is false:
                    send "{@prefix}&cClaim &f#%{_tpId}% &cintrouvable." to player
                    stop
                claimAdminTpCmd(player, {_tpId})
                stop

            # /claim admin rename [<id>] <nom...> – renommer
            if arg-2 is "rename":
                # Détecte si arg-3 est un id ou le début du nom
                set {_renId} to 0
                set {_renTxt} to ""
                if arg-3 is not set:
                    send "{@prefix}&cUsage: /claim admin rename [<id>] <nom...>" to player
                    stop
                set {_tryRen} to arg-3 parsed as integer
                if {_tryRen} is set:
                    if claimExists({_tryRen}) is true:
                        # arg-3 = id
                        if arg-4 is not set:
                            send "{@prefix}&cPrecise un nouveau nom apres l'id." to player
                            stop
                        set {_renId} to {_tryRen}
                        set {_renTxt} to arg-4
                        if arg-5 is set:
                            set {_renTxt} to "%{_renTxt}% %arg-5%"
                        if arg-6 is set:
                            set {_renTxt} to "%{_renTxt}% %arg-6%"
                        if arg-7 is set:
                            set {_renTxt} to "%{_renTxt}% %arg-7%"
                        if arg-8 is set:
                            set {_renTxt} to "%{_renTxt}% %arg-8%"
                    else:
                        send "{@prefix}&cClaim &f#%{_tryRen}% &cintrouvable." to player
                        stop
                else:
                    # arg-3 = début du nom, id = position
                    set {_renId} to claimAtLocation(location of player)
                    if {_renId} <= 0:
                        send "{@prefix}&cTu n'es sur aucun claim. Specifie l'id: /claim admin rename <id> <nom...>" to player
                        stop
                    set {_renTxt} to arg-3
                    if arg-4 is set:
                        set {_renTxt} to "%{_renTxt}% %arg-4%"
                    if arg-5 is set:
                        set {_renTxt} to "%{_renTxt}% %arg-5%"
                    if arg-6 is set:
                        set {_renTxt} to "%{_renTxt}% %arg-6%"
                    if arg-7 is set:
                        set {_renTxt} to "%{_renTxt}% %arg-7%"
                    if arg-8 is set:
                        set {_renTxt} to "%{_renTxt}% %arg-8%"
                claimAdminRenameCmd(player, {_renId}, {_renTxt})
                stop

            # /claim admin setdesc [<id>] <texte...> – modifier la description
            if arg-2 is "setdesc":
                set {_dcId} to 0
                set {_dcTxt} to ""
                if arg-3 is not set:
                    # Effacer la description
                    set {_dcId} to claimAtLocation(location of player)
                    if {_dcId} <= 0:
                        send "{@prefix}&cUsage: /claim admin setdesc [<id>] [<texte...>]" to player
                        stop
                    claimAdminSetDescCmd(player, {_dcId}, "")
                    stop
                set {_tryDc} to arg-3 parsed as integer
                if {_tryDc} is set:
                    if claimExists({_tryDc}) is true:
                        set {_dcId} to {_tryDc}
                        set {_dcTxt} to ""
                        if arg-4 is set:
                            set {_dcTxt} to arg-4
                            if arg-5 is set:
                                set {_dcTxt} to "%{_dcTxt}% %arg-5%"
                            if arg-6 is set:
                                set {_dcTxt} to "%{_dcTxt}% %arg-6%"
                            if arg-7 is set:
                                set {_dcTxt} to "%{_dcTxt}% %arg-7%"
                            if arg-8 is set:
                                set {_dcTxt} to "%{_dcTxt}% %arg-8%"
                    else:
                        send "{@prefix}&cClaim &f#%{_tryDc}% &cintrouvable." to player
                        stop
                else:
                    set {_dcId} to claimAtLocation(location of player)
                    if {_dcId} <= 0:
                        send "{@prefix}&cTu n'es sur aucun claim. Specifie l'id: /claim admin setdesc <id> [<texte...>]" to player
                        stop
                    set {_dcTxt} to arg-3
                    if arg-4 is set:
                        set {_dcTxt} to "%{_dcTxt}% %arg-4%"
                    if arg-5 is set:
                        set {_dcTxt} to "%{_dcTxt}% %arg-5%"
                    if arg-6 is set:
                        set {_dcTxt} to "%{_dcTxt}% %arg-6%"
                    if arg-7 is set:
                        set {_dcTxt} to "%{_dcTxt}% %arg-7%"
                claimAdminSetDescCmd(player, {_dcId}, {_dcTxt})
                stop

            # /claim admin setowner [<id>] <joueur> – changer de propriétaire
            if arg-2 is "setowner":
                set {_soId} to 0
                set {_soRaw} to ""
                if arg-3 is not set:
                    send "{@prefix}&cUsage: /claim admin setowner [<id>] <joueur>" to player
                    stop
                # Si arg-3 = id valide ET arg-4 = joueur
                set {_trySo} to arg-3 parsed as integer
                if {_trySo} is set:
                    if claimExists({_trySo}) is true:
                        if arg-4 is not set:
                            send "{@prefix}&cPrecise un joueur apres l'id." to player
                            stop
                        set {_soId} to {_trySo}
                        set {_soRaw} to arg-4
                    else:
                        send "{@prefix}&cClaim &f#%{_trySo}% &cintrouvable." to player
                        stop
                else:
                    set {_soId} to claimAtLocation(location of player)
                    if {_soId} <= 0:
                        send "{@prefix}&cTu n'es sur aucun claim. Specifie l'id: /claim admin setowner <id> <joueur>" to player
                        stop
                    set {_soRaw} to arg-3
                claimAdminSetOwnerCmd(player, {_soId}, {_soRaw})
                stop

            # /claim admin invite|kick|promote|demote [<id>] <joueur>
            if arg-2 is "invite" or "kick" or "promote" or "demote":
                set {_maId} to 0
                set {_maRaw} to ""
                if arg-3 is not set:
                    send "{@prefix}&cUsage: /claim admin %arg-2% [<id>] <joueur>" to player
                    stop
                set {_tryMa} to arg-3 parsed as integer
                if {_tryMa} is set:
                    if claimExists({_tryMa}) is true:
                        if arg-4 is not set:
                            send "{@prefix}&cPrecise un joueur apres l'id." to player
                            stop
                        set {_maId} to {_tryMa}
                        set {_maRaw} to arg-4
                    else:
                        send "{@prefix}&cClaim &f#%{_tryMa}% &cintrouvable." to player
                        stop
                else:
                    set {_maId} to claimAtLocation(location of player)
                    if {_maId} <= 0:
                        send "{@prefix}&cTu n'es sur aucun claim. Specifie l'id: /claim admin %arg-2% <id> <joueur>" to player
                        stop
                    set {_maRaw} to arg-3
                claimAdminMemberActionCmd(player, {_maId}, arg-2, {_maRaw})
                stop

            send "{@prefix}&cSous-commande admin inconnue. Voir &6/claim help&c." to player
            stop
        claimCmdHelp(player)

# ============================================================
#  Tab completion
# ============================================================
# Inspire du tab-completer de /f2b : `set tab completions for position N`,
# avec branches conditionnees sur `tab arg-X`.

on tab complete of "/claim":
    set {_isAdmin} to false
    if player is not set:
        set {_isAdmin} to true
    else if player has permission "{@perm}":
        set {_isAdmin} to true

    # ---------- Position 1 : sous-commandes principales ----------
    delete {_p1::*}
    add "help" to {_p1::*}
    add "wand" to {_p1::*}
    add "status" to {_p1::*}
    add "info" to {_p1::*}
    add "list" to {_p1::*}
    add "mode" to {_p1::*}
    add "usey" to {_p1::*}
    add "expand" to {_p1::*}
    add "name" to {_p1::*}
    add "subtitle" to {_p1::*}
    add "description" to {_p1::*}
    add "create" to {_p1::*}
    add "edit" to {_p1::*}
    add "save" to {_p1::*}
    add "cancel" to {_p1::*}
    add "delete" to {_p1::*}
    add "members" to {_p1::*}
    add "invite" to {_p1::*}
    add "kick" to {_p1::*}
    add "promote" to {_p1::*}
    add "demote" to {_p1::*}
    add "transfer" to {_p1::*}
    add "transfer-cancel" to {_p1::*}
    add "accept" to {_p1::*}
    add "deny" to {_p1::*}
    if {_isAdmin} is true:
        add "admin" to {_p1::*}
    set tab completions for position 1 to {_p1::*}

    # ---------- Position 2 : depend de arg-1 ----------
    if tab arg-1 is "mode":
        set tab completions for position 2 to "rect" and "poly"
    else if tab arg-1 is "usey":
        set tab completions for position 2 to "on" and "off"
    else if tab arg-1 is "expand":
        set tab completions for position 2 to "up" and "down" and "both"
    else if tab arg-1 is "edit":
        delete {_owned::*}
        if player is set:
            loop indices of {claim::owner::%uuid of player%::*}:
                set {_cid} to loop-value parsed as integer
                if {_cid} is set:
                    if claimExists({_cid}) is true:
                        add "%{_cid}%" to {_owned::*}
        if {_owned::*} is set:
            set tab completions for position 2 to {_owned::*}
        else:
            set tab completions for position 2 to "<id|nom>"
    else if tab arg-1 is "delete":
        delete {_owned::*}
        if player is set:
            loop indices of {claim::owner::%uuid of player%::*}:
                set {_cid} to loop-value parsed as integer
                if {_cid} is set:
                    if claimExists({_cid}) is true:
                        add "%{_cid}%" to {_owned::*}
        if {_owned::*} is set:
            set tab completions for position 2 to {_owned::*}
        else:
            set tab completions for position 2 to "<id|nom>"
    else if tab arg-1 is "invite" or "kick" or "promote" or "demote" or "transfer" or "transfer-cancel":
        delete {_names::*}
        loop all players:
            add name of loop-player to {_names::*}
        if {_names::*} is set:
            set tab completions for position 2 to {_names::*}
        else:
            set tab completions for position 2 to "<joueur>"
    else if tab arg-1 is "info":
        set tab completions for position 2 to "[ici]"
    else if tab arg-1 is "list":
        if {_isAdmin} is true:
            delete {_names::*}
            loop all players:
                add name of loop-player to {_names::*}
            if {_names::*} is set:
                set tab completions for position 2 to {_names::*}
            else:
                set tab completions for position 2 to "[joueur]"
    else if tab arg-1 is "create":
        set tab completions for position 2 to "[nom...]"
    else if tab arg-1 is "name":
        set tab completions for position 2 to "<nom...>"
    else if tab arg-1 is "subtitle":
        set tab completions for position 2 to "<texte...>"
    else if tab arg-1 is "description":
        set tab completions for position 2 to "<texte...>"
    else if tab arg-1 is "desc":
        set tab completions for position 2 to "<texte...>"
    else if tab arg-1 is "admin":
        if {_isAdmin} is true:
            delete {_a2::*}
            add "info" to {_a2::*}
            add "create" to {_a2::*}
            add "delete" to {_a2::*}
            add "list" to {_a2::*}
            add "setlimit" to {_a2::*}
            add "bypass" to {_a2::*}
            add "claims" to {_a2::*}
            add "fxdebug" to {_a2::*}
            add "fxperf" to {_a2::*}
            add "maxarea" to {_a2::*}
            add "maxtotal" to {_a2::*}
            add "maxvertices" to {_a2::*}
            add "defaultlimit" to {_a2::*}
            add "reset" to {_a2::*}
            add "manage" to {_a2::*}
            add "members" to {_a2::*}
            add "rename" to {_a2::*}
            add "setdesc" to {_a2::*}
            add "setowner" to {_a2::*}
            add "tp" to {_a2::*}
            add "invite" to {_a2::*}
            add "kick" to {_a2::*}
            add "promote" to {_a2::*}
            add "demote" to {_a2::*}
            set tab completions for position 2 to {_a2::*}

    # ---------- Position 3 : /claim expand ... ----------
    if tab arg-1 is "expand":
        if tab arg-2 is "up" or "down" or "both":
            set tab completions for position 3 to "1" and "5" and "10" and "16" and "32"

    # ---------- Position 3 : seulement pour /claim admin ... ----------
    if tab arg-1 is "admin":
        if {_isAdmin} is true:
            if tab arg-2 is "create":
                set tab completions for position 3 to "[nom...]"
            else if tab arg-2 is "info":
                delete {_all::*}
                set {_max} to {claim::id::counter} ? 0
                set {_i} to 1
                while {_i} <= {_max}:
                    if claimExists({_i}) is true:
                        add "%{_i}%" to {_all::*}
                    add 1 to {_i}
                if {_all::*} is set:
                    set tab completions for position 3 to {_all::*}
                else:
                    set tab completions for position 3 to "[id]"
            else if tab arg-2 is "delete":
                delete {_all::*}
                set {_max} to {claim::id::counter} ? 0
                set {_i} to 1
                while {_i} <= {_max}:
                    if claimExists({_i}) is true:
                        add "%{_i}%" to {_all::*}
                    add 1 to {_i}
                if {_all::*} is set:
                    set tab completions for position 3 to {_all::*}
                else:
                    set tab completions for position 3 to "<id>"
            else if tab arg-2 is "list":
                delete {_names::*}
                loop all players:
                    add name of loop-player to {_names::*}
                if {_names::*} is set:
                    set tab completions for position 3 to {_names::*}
                else:
                    set tab completions for position 3 to "[joueur]"
            else if tab arg-2 is "setlimit":
                delete {_names::*}
                loop all players:
                    add name of loop-player to {_names::*}
                if {_names::*} is set:
                    set tab completions for position 3 to {_names::*}
                else:
                    set tab completions for position 3 to "<joueur>"
            else if tab arg-2 is "bypass":
                delete {_names::*}
                loop all players:
                    add name of loop-player to {_names::*}
                if {_names::*} is set:
                    set tab completions for position 3 to {_names::*}
                else:
                    set tab completions for position 3 to "<joueur>"
            else if tab arg-2 is "claims":
                set tab completions for position 3 to "on" and "off"
            else if tab arg-2 is "fxdebug":
                set tab completions for position 3 to "on" and "off"
            else if tab arg-2 is "fxperf":
                set tab completions for position 3 to "on" and "off"
            else if tab arg-2 is "maxarea":
                set tab completions for position 3 to "<nombre>"
            else if tab arg-2 is "maxtotal":
                set tab completions for position 3 to "<nombre>"
            else if tab arg-2 is "maxvertices":
                set tab completions for position 3 to "<nombre>"
            else if tab arg-2 is "defaultlimit":
                set tab completions for position 3 to "<nombre>"
            else if tab arg-2 is "manage" or "members":
                set tab completions for position 3 to "[id]"
            else if tab arg-2 is "tp":
                delete {_tpIds::*}
                set {_max} to {claim::id::counter} ? 0
                set {_i} to 1
                while {_i} <= {_max}:
                    if claimExists({_i}) is true:
                        add "%{_i}%" to {_tpIds::*}
                    add 1 to {_i}
                if {_tpIds::*} is set:
                    set tab completions for position 3 to {_tpIds::*}
                else:
                    set tab completions for position 3 to "<id>"
            else if tab arg-2 is "rename" or "setdesc":
                set tab completions for position 3 to "[id] <texte...>"
            else if tab arg-2 is "setowner" or "invite" or "kick" or "promote" or "demote":
                delete {_onln::*}
                loop all players:
                    add name of loop-player to {_onln::*}
                if {_onln::*} is set:
                    set tab completions for position 3 to {_onln::*}
                else:
                    set tab completions for position 3 to "[id] <joueur>"

    # ---------- Position 4 : /claim admin setlimit|bypass|setowner|invite|kick|promote|demote ----------
    if tab arg-1 is "admin":
        if {_isAdmin} is true:
            if tab arg-2 is "setlimit":
                set tab completions for position 4 to "<nombre>"
            else if tab arg-2 is "bypass":
                set tab completions for position 4 to "on" and "off"
            else if tab arg-2 is "setowner" or "invite" or "kick" or "promote" or "demote":
                # Si arg-3 est un id, compléter arg-4 avec les joueurs en ligne
                set {_tryP4} to tab arg-3 parsed as integer
                if {_tryP4} is set:
                    delete {_p4::*}
                    loop all players:
                        add name of loop-player to {_p4::*}
                    if {_p4::*} is set:
                        set tab completions for position 4 to {_p4::*}
                    else:
                        set tab completions for position 4 to "<joueur>"

